_package: Batiments.model_diagrams
_type: ModelDiagram
_name: PatrimoineDiagram
label: Diagramme Modèle Patrimoine
description: Diagramme du modèle Patrimoine
entityNameFormat: NAME
attributeNameFormat: LABEL
referenceNameFormat: NAME
referenceRoleNameFormat: NAME
showAttributeDataType: true
showInheritLinkName: false
showInheritedAttributes: true
showReferenceCardinality: true
showReferenceRoles: true
showReferenceName: true
showForeignAttribute: true
