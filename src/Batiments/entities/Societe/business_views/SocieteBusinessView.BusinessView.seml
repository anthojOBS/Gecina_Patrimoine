_package: Batiments.entities.Societe.business_views
_type: BusinessView
_name: SocieteBusinessView
entity: Batiments.entities.Societe.Societe
rootLabel: Société
rootPluralLabel: Société
displayRootNodeAs: ICON_LABEL
label: Société
rootBusinessViewEntity:
  _type: BusinessViewEntity
  _name: Societe
  displayCard: Batiments.entities.Societe.display_cards.SocieteDisplayCard
  entity: Batiments.entities.Societe.Societe
  actionSet: Batiments.entities.Societe.action_sets.SocieteActionSet
  collection: Batiments.entities.Societe.collection_views.SocieteCollectionView
  form: Batiments.entities.Societe.forms.SocieteForm
  outlineVisible: false
  displayRecordCount: ALWAYS
  businessEntitySearchConfigs:
    - _name: TextConfig
      _type: BusinessEntitySearchTypeConfig
      searchType: TEXT
    - _name: FormConfig
      _type: BusinessEntitySearchTypeConfig
      searchType: BY_FORM
    - _name: AdvancedConfig
      _type: BusinessEntitySearchTypeConfig
      searchType: ADVANCED
    - _name: SemqlConfig
      _type: BusinessEntitySearchTypeConfig
      searchType: SEMQL
  overrideDefaultSort: false
  enableUserDefinedSort: true
  listAllowed: true
  tableAllowed: true
  gridAllowed: true

  transitions:
    - _name: GoldenHistoryRecords
      _type: BusinessViewTransition
      displayFormTabAs: ICON_LABEL
      displayTransitionNodeAs: ICON_LABEL
      enableHierarchy: '0'
      enableHierarchyInterpreter: LITERAL
      expandHierarchyByDefault: false
      iconUrl: images://mdi/history.svg
      label: History
      pluralLabel: History
      transitionPath: GoldenHistoryRecords
      transitionType: FULLY_QUALIFIED
      transitionVisible: '1'
      transitionVisibleInterpreter: LITERAL
      useCustomLabel: true
      businessViewEntity: 
        _type: BusinessViewEntityReference
        ref: Batiments.entities.Societe.business_views.SocieteBusinessView.Societe
      filter: 1 = 1
enableHierarchyView: false
useHierarchyOnOpen: false
