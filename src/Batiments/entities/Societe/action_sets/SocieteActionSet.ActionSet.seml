_package: Batiments.entities.Societe.action_sets
_type: ActionSet
_name: SocieteActionSet
entity: Batiments.entities.Societe.Societe
label: Societe Autre Action Set
defaultActionSet: true
actions:
  - _type: CreateAction
    _name: CreateSociete
    label: Create
    useCustomLabel: true
    stepper: Batiments.entities.Societe.steppers.AuthorSociete
    createMultiple: false
    createdRecordType: GOLDEN
    waitDialogEnabled: false
    allowOtherPublishers: true
  - _type: EditAction
    _name: EditSociete
    label: Edit
    useCustomLabel: true
    stepper: Batiments.entities.Societe.steppers.AuthorSociete
    multipleSelectionAllowed: true
    availableForGoldenData: true
    availableForMasterData: false
    availableForErrorData: true
    waitDialogEnabled: false
  - _type: MassUpdateAction
    _name: MassUpdateSociete
    label: Mass Update
    useCustomLabel: true
    stepper: Batiments.entities.Societe.steppers.AuthorSociete
    availableForGoldenData: true
    availableForErrorData: true
    availableForMasterData: false
    waitDialogEnabled: false
  - _type: DeleteAction
    _name: Delete
    label: Delete
    useCustomLabel: true
    multipleSelectionAllowed: true
    deleteType: HARD_DELETE
    waitDialogEnabled: false
    availableForGoldenData: true
    availableForMasterData: false
  - _type: ExportAction
    _name: Export
    label: Export
    useCustomLabel: true
    waitDialogEnabled: false
  - _type: ImportAction
    _name: ImportSociete
    label: Import
    useCustomLabel: true
    importMode: CREATE_AND_UPDATE
    stepper: Batiments.entities.Societe.steppers.AuthorSociete
    importedRecordType: GOLDEN
    waitDialogEnabled: false
    allowOtherPublishers: true
  - _type: BrowseGraphAction
    _name: BrowseGraph
    label: Browse Graph
    useCustomLabel: true

