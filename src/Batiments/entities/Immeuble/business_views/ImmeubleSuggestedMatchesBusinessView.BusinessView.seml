_package: Batiments.entities.Immeuble.business_views
_type: BusinessView
_name: ImmeubleSuggestedMatchesBusinessView
entity: Batiments.entities.Immeuble.Immeuble
rootLabel: Immeubles Suggestions
rootPluralLabel: Immeubles Suggestions
displayRootNodeAs: ICON_LABEL
label: Immeubles Suggested Matches
rootFilter: HasSuggestedMerge = '1'

enableHierarchyView: true
useHierarchyOnOpen: false

rootBusinessViewEntity:
  _type: BusinessViewEntity
  _name: Immeuble
  displayCard: Batiments.entities.Immeuble.display_cards.ImmeubleDisplayCard
  entity: Batiments.entities.Immeuble.Immeuble
  actionSet: Batiments.entities.Immeuble.action_sets.ImmeubleActionSet
  collection: Batiments.entities.Immeuble.collection_views.ImmeubleCollectionView
  form: Batiments.entities.Immeuble.forms.ImmeubleConsultation
  outlineVisible: false
  displayRecordCount: ALWAYS
  businessEntitySearchConfigs:
    - _name: TextConfig
      _type: BusinessEntitySearchTypeConfig
      searchType: TEXT
    - _name: FormConfig1
      _type: BusinessEntitySearchTypeConfig
      searchType: CUSTOM_FORM
      customForm: Batiments.entities.Immeuble.search_forms.ImmeubleSearchForm
    # - _name: FormConfig
    #   _type: BusinessEntitySearchTypeConfig
    #   searchType: BY_FORM
    # - _name: AdvancedConfig
    #   _type: BusinessEntitySearchTypeConfig
    #   searchType: ADVANCED
    # - _name: SemqlConfig
    #   _type: BusinessEntitySearchTypeConfig
    #   searchType: SEMQL
  overrideDefaultSort: false
  enableUserDefinedSort: true
  listAllowed: true
  tableAllowed: true
  gridAllowed: true

  transitions:
    - _name: GoldenHistoryRecords
      _type: BusinessViewTransition
      displayFormTabAs: ICON_LABEL
      displayTransitionNodeAs: ICON_LABEL
      enableHierarchy: '0'
      enableHierarchyInterpreter: LITERAL
      expandHierarchyByDefault: false
      iconUrl: images://mdi/history.svg
      label: History
      pluralLabel: History
      transitionPath: GoldenHistoryRecords
      transitionType: FULLY_QUALIFIED
      transitionVisible: '1'
      transitionVisibleInterpreter: LITERAL
      useCustomLabel: true
      businessViewEntity: 
        _type: BusinessViewEntityReference
        ref: Batiments.entities.Immeuble.business_views.ImmeubleSuggestedMatchesBusinessView.Immeuble
      filter: 1 = 1
    - _type: BusinessViewTransition
      _name: MasterRecords
      displayFormTabAs: ICON_LABEL
      useCustomLabel: false
      enableHierarchyInterpreter: LITERAL
      filter: 1=1
      iconUrl: images://mdi/puzzle.svg
      label: Masters Records
      pluralLabel: Masters Records
      transitionType: FULLY_QUALIFIED
      transitionPath:  MasterRecords 
      visibleInFormTabCondition: :V_USER_ROLES like '%semarchyAdmin%'
      businessViewEntity: 
        _type: BusinessViewEntity
        _name: MasterRecord
        displayCard: Batiments.entities.Immeuble.display_cards.ImmeubleDisplayCard
        entity: Batiments.entities.Immeuble.Immeuble
        actionSet: Batiments.entities.Immeuble.action_sets.ImmeubleActionSet
        collection: Batiments.entities.Immeuble.collection_views.ImmeubleCollectionView
        form: Batiments.entities.Immeuble.forms.ImmeubleConsultation
        displayRecordCount: ALWAYS
        outlineVisible: false
        enableUserDefinedSort: true
        gridAllowed: true
        listAllowed: true
        overrideDefaultSort: false
        tableAllowed: true
