_package: Batiments.entities.Immeuble.steppers
_type: Stepper
_name: ImmeubleEdition
entity: Batiments.entities.Immeuble.Immeuble
label: Immeubles

rootStep:
  _type: CollectionStep
  _name: Immeubles
  label: Immeubles
  canFinishSubLevel: true
  enabledOnParentCreate: true
  enabledOnParentEdit: true
  formFieldsMode: AUTO
  linear: false
  childDeleteType: HARD_DELETE
  collectionView: Batiments.entities.Immeuble.collection_views.ImmeubleCollectionView
  defaultDisplayType: TABLE
  customSortEnabled: false
  userDefinedSortEnabled: true
  displayGridAllowed: false
  displayListAllowed: true
  displayTableAllowed: true
  useCustomCollectionLabel: false
  childSteps:
    - _type: FormStep
      _name: Immeuble
      label: Fiche Immeuble
      canFinishSubLevel: true
      enabledOnParentCreate: true
      enabledOnParentEdit: true
      formFieldsMode: AUTO
      enableMasterValuePicking: false
      formTab: Batiments.entities.Immeuble.forms.ImmeubleEdition.Immeuble

      referenceFormFieldConfigs:
        - enableCreateReference: false
          enableUserSort: true
          referencePickerType: AUTO_COMPLETE
          fdnFormField: Batiments.entities.Immeuble.forms.ImmeubleEdition.Immeuble.SectionGlobal.SectionPremsD.GestionInterne.FDN_SousPortefeuille_DB
          referenceFilter: Referenced.FID_OrgaResp = Record.FID_OrgaResp
          referencePickerCollectionView: Batiments.entities.SousPortefeuille.collection_views.SousPortefeuilleCollectionView
          # referencePickerSearchTypeConfigs: []
        - enableCreateReference: false
          enableUserSort: true
          referencePickerType: AUTO_COMPLETE
          fdnFormField: Batiments.entities.Immeuble.forms.ImmeubleEdition.Immeuble.SectionGlobal.SectionPremsD.GestionInterne.FDN_SousPortefeuille_DR
          referenceFilter: Referenced.FID_OrgaResp = Record.FID_OrgaResp
          referencePickerCollectionView: Batiments.entities.SousPortefeuille.collection_views.SousPortefeuilleCollectionView
          # referencePickerSearchTypeConfigs: []

        - enableCreateReference: false
          enableUserSort: true
          referencePickerType: AUTO_COMPLETE
          fdnFormField: Batiments.entities.Immeuble.forms.ImmeubleEdition.Immeuble.SectionDeux.LocalisationImmeuble.BlocAdresse.FDN_SecteurImmostat
          referenceFilter: Referenced.FID_ZoneImmostat = Record.FID_ZoneImmostat
          referencePickerCollectionView: Batiments.entities.SecteurImmostat.collection_views.SecteurImmostatCollectionView
          # referencePickerSearchTypeConfigs: []

        - enableCreateReference: false
          enableUserSort: true
          referencePickerType: AUTO_COMPLETE
          fdnFormField: Batiments.entities.Immeuble.forms.ImmeubleEdition.Immeuble.SectionDeux.LocalisationImmeuble.BlocAdresse.FDN_SousSecteurImmostat
          referenceFilter: Referenced.FID_SecteurImmostat = Record.FID_SecteurImmostat
          referencePickerCollectionView: Batiments.entities.SousSecteurImmostat.collection_views.SousSecteurImmostatCollectionView
          # referencePickerSearchTypeConfigs: []

      formStepEnrichers:  
        - enricher: Batiments.entities.Immeuble.enrichers.Portefeuille
          executedOnButtonClick: false
          executedOnDataChange: true
          executedOnFormOpen: false
        - enricher: Batiments.entities.Immeuble.enrichers.DefautNbAscenceur
          executedOnButtonClick: false
          executedOnDataChange: true
          executedOnFormOpen: true

      formStepValidations:  
        - executedOnDataChange: true
          executedOnFormOpen: true
          validationType: MANDATORY
          attribute: Batiments.references.ImmeubleToUsage.Usage
        - executedOnDataChange: true
          executedOnFormOpen: true
          validationType: MANDATORY
          attribute: Batiments.references.ImmeubleToOrgaResp.OrgaResp
        - executedOnDataChange: true
          executedOnFormOpen: true
          validationType: MANDATORY
          attribute: Batiments.references.ImmeubleToPortefeuille.Portefeuille
        - executedOnDataChange: true
          executedOnFormOpen: true
          validationType: MANDATORY
          attribute: Batiments.references.ImmeubleToSousPortefeuille.SousPortefeuille
        # - executedOnDataChange: true
        #   executedOnFormOpen: true
        #   validationType: MANDATORY
        #   attribute: Batiments.references.ImmeubleToZoneImmostat.ZoneImmostat
        # - executedOnDataChange: true
        #   executedOnFormOpen: true
        #   validationType: MANDATORY
        #   attribute: Batiments.references.ImmeubleToSecteurImmostat.SecteurImmostat
        # - executedOnDataChange: true
        #   executedOnFormOpen: true
        #   validationType: MANDATORY
        #   attribute: Batiments.references.ImmeubleToSousSecteurImmostat.SousSecteurImmostat

        - validator: Batiments.entities.Immeuble.validations.CheckCoherenceOrgaPortef
          executedOnDataChange: true
          executedOnFormOpen: true
          validationType: CHECK
          attribute: Batiments.references.ImmeubleToSousPortefeuille.SousPortefeuille
        - validator: Batiments.entities.Immeuble.validations.CheckZoneOrga
          executedOnDataChange: true
          executedOnFormOpen: true
          validationType: CHECK
          attribute: Batiments.references.ImmeubleToZoneImmostat.ZoneImmostat
        - validator: Batiments.entities.Immeuble.validations.CheckSecteurOrga
          executedOnDataChange: true
          executedOnFormOpen: true
          validationType: CHECK
          attribute: Batiments.references.ImmeubleToSecteurImmostat.SecteurImmostat
        - validator: Batiments.entities.Immeuble.validations.CheckSsSecteurOrga
          executedOnDataChange: true
          executedOnFormOpen: true
          validationType: CHECK
          attribute: Batiments.references.ImmeubleToSousSecteurImmostat.SousSecteurImmostat

        - validator: Batiments.entities.Immeuble.validations.CheckCoherenceSecteur_Zone
          executedOnDataChange: true
          executedOnFormOpen: true
          validationType: CHECK
          attribute: Batiments.references.ImmeubleToSecteurImmostat.SecteurImmostat
        - validator: Batiments.entities.Immeuble.validations.CheckCoherenceSousSecteur_Secteur
          executedOnDataChange: true
          executedOnFormOpen: true
          validationType: CHECK
          attribute: Batiments.references.ImmeubleToSousSecteurImmostat.SousSecteurImmostat
        - validator: Batiments.entities.Immeuble.validations.CheckAscenseur
          executedOnDataChange: true
          executedOnFormOpen: true
          validationType: CHECK
          attribute: Batiments.entities.Immeuble.Immeuble.NbAscenseur
        - validator: Batiments.entities.Immeuble.validations.CheckQuartierParis
          executedOnDataChange: true
          executedOnFormOpen: true
          validationType: CHECK
          attribute: Batiments.references.ImmeubleToQuartierParis.QuartierParis

        - validator: Batiments.entities.Immeuble.validations.CheckZoneOrga_DR
          executedOnDataChange: true
          executedOnFormOpen: true
          validationType: CHECK
          attribute: Batiments.references.ImmeubleToZoneImmostat.ZoneImmostat
        - validator: Batiments.entities.Immeuble.validations.CheckSecteurOrga_DR
          executedOnDataChange: true
          executedOnFormOpen: true
          validationType: CHECK
          attribute: Batiments.references.ImmeubleToSecteurImmostat.SecteurImmostat
        - validator: Batiments.entities.Immeuble.validations.CheckSsSecteurOrga_DR
          executedOnDataChange: true
          executedOnFormOpen: true
          validationType: CHECK
          attribute: Batiments.references.ImmeubleToSousSecteurImmostat.SousSecteurImmostat
        - validator: Batiments.entities.Immeuble.validations.CheckQuartierParis_DR
          executedOnDataChange: true
          executedOnFormOpen: true
          validationType: CHECK
          attribute: Batiments.references.ImmeubleToQuartierParis.QuartierParis


      stepTransitionValidations:
        - onStepExit: BLOCK
          validationType: MANDATORY
          attribute:  Batiments.references.ImmeubleToUsage.Usage
        - onStepExit: BLOCK
          validationType: MANDATORY
          attribute:  Batiments.references.ImmeubleToOrgaResp.OrgaResp
        - onStepExit: BLOCK
          validationType: MANDATORY
          attribute:  Batiments.references.ImmeubleToPortefeuille.Portefeuille
        - onStepExit: BLOCK
          validationType: MANDATORY
          attribute:  Batiments.references.ImmeubleToSousPortefeuille.SousPortefeuille

        # - onStepExit: BLOCK
        #   validationType: MANDATORY
        #   attribute:  Batiments.references.ImmeubleToZoneImmostat.ZoneImmostat
        # - onStepExit: BLOCK
        #   validationType: MANDATORY
        #   attribute:  Batiments.references.ImmeubleToSecteurImmostat.SecteurImmostat
        # - onStepExit: BLOCK
        #   validationType: MANDATORY
        #   attribute:  Batiments.references.ImmeubleToSousSecteurImmostat.SousSecteurImmostat
        - onStepExit: BLOCK
          validationType: CHECK
          validator: Batiments.entities.Immeuble.validations.CheckCoherenceOrgaPortef
        - onStepExit: BLOCK
          validationType: CHECK
          validator: Batiments.entities.Immeuble.validations.CheckZoneOrga
        - onStepExit: BLOCK
          validationType: CHECK
          validator: Batiments.entities.Immeuble.validations.CheckSecteurOrga
        - onStepExit: BLOCK
          validationType: CHECK
          validator: Batiments.entities.Immeuble.validations.CheckSsSecteurOrga
        - onStepExit: BLOCK
          validationType: CHECK
          validator: Batiments.entities.Immeuble.validations.CheckCoherenceSecteur_Zone
        - onStepExit: BLOCK
          validationType: CHECK
          validator: Batiments.entities.Immeuble.validations.CheckCoherenceSousSecteur_Secteur
        - onStepExit: BLOCK
          validationType: CHECK
          validator: Batiments.entities.Immeuble.validations.CheckAscenseur
        - onStepExit: BLOCK
          validationType: CHECK
          validator: Batiments.entities.Immeuble.validations.CheckQuartierParis

        - onStepExit: WARN
          validationType: CHECK
          validator: Batiments.entities.Immeuble.validations.CheckZoneOrga_DR
        - onStepExit: WARN
          validationType: CHECK
          validator: Batiments.entities.Immeuble.validations.CheckSecteurOrga_DR
        - onStepExit: WARN
          validationType: CHECK
          validator: Batiments.entities.Immeuble.validations.CheckSsSecteurOrga_DR
        - onStepExit: WARN
          validationType: CHECK
          validator: Batiments.entities.Immeuble.validations.CheckQuartierParis_DR

    - _type: FormStep
      _name: Composition
      label: Composition
      canFinishSubLevel: true
      enabledOnParentCreate: true
      enabledOnParentEdit: true
      formFieldsMode: AUTO
      enableMasterValuePicking: false
      formTab: Batiments.entities.Immeuble.forms.ImmeubleEdition.Composition

    - _type: FormStep
      _name: CycleDeVie
      label: Cycle de vie
      canFinishSubLevel: true
      enabledOnParentCreate: true
      enabledOnParentEdit: true
      formFieldsMode: AUTO
      enableMasterValuePicking: false
      formTab: Batiments.entities.Immeuble.forms.ImmeubleEdition.CycleVieImmeuble
 
      formStepEnrichers:   
        - enricher: Batiments.entities.Immeuble.enrichers.DefautPhase
          executedOnButtonClick: false
          executedOnDataChange: false
          executedOnFormOpen: true
        - enricher: Batiments.entities.Immeuble.enrichers.DefautPeriodConstruct
          executedOnButtonClick: false
          executedOnDataChange: true
          executedOnFormOpen: true
        - enricher: Batiments.entities.Immeuble.enrichers.DefautDtRestructuration
          executedOnButtonClick: false
          executedOnDataChange: true
          executedOnFormOpen: false

      formStepValidations: 
        - validator: Batiments.entities.Immeuble.validations.CheckDtLivraison
          executedOnDataChange: true
          executedOnFormOpen: true
          validationType: CHECK
          attribute: Batiments.entities.Immeuble.Immeuble.DateLivraison
        - validator: Batiments.entities.Immeuble.validations.CheckCoherenceDtConstruction
          executedOnDataChange: true
          executedOnFormOpen: true
          validationType: CHECK
          attribute: Batiments.entities.Immeuble.Immeuble.DateFinConstruction
        - validator: Batiments.entities.Immeuble.validations.CheckPeriodeConstruction
          executedOnDataChange: true
          executedOnFormOpen: true
          validationType: CHECK
          attribute:  Batiments.references.ImmeubleToPeriodeConstruction.PeriodeConstruction
      stepTransitionValidations:
        - onStepExit: BLOCK
          validationType: CHECK
          validator: Batiments.entities.Immeuble.validations.CheckDtLivraison
        - onStepExit: BLOCK
          validationType: CHECK
          validator: Batiments.entities.Immeuble.validations.CheckCoherenceDtConstruction
        - onStepExit: BLOCK
          validationType: CHECK
          validator: Batiments.entities.Immeuble.validations.CheckPeriodeConstruction

    - _type: FormStep
      _name: FiscaliteJuridique
      label: Juridique et propriété
      canFinishSubLevel: true
      enabledOnParentCreate: true
      enabledOnParentEdit: true
      formFieldsMode: AUTO
      enableMasterValuePicking: false
      formTab: Batiments.entities.Immeuble.forms.ImmeubleEdition.FiscaliteJuridique


      # formStepEnrichers:   
      #   - enricher: Batiments.entities.Immeuble.enrichers.DefautRegimeTVA
      #     executedOnButtonClick: false
      #     executedOnDataChange: false
      #     executedOnFormOpen: true

      formStepValidations:  
        - executedOnDataChange: true
          executedOnFormOpen: true
          validationType: MANDATORY
          attribute:  Batiments.references.ImmeubleToRegimeJuridique.RegimeJuridique
        - executedOnDataChange: true
          executedOnFormOpen: true
          validationType: MANDATORY
          attribute:  Batiments.references.ImmeubleToFiscaliteCible.FiscaliteCible

      stepTransitionValidations:
        - onStepExit: BLOCK
          validationType: MANDATORY
          attribute: Batiments.references.ImmeubleToFiscaliteCible.FiscaliteCible
        - onStepExit: BLOCK
          validationType: MANDATORY
          attribute: Batiments.references.ImmeubleToRegimeJuridique.RegimeJuridique



    - _type: CollectionStep
      enableChildImportOnParentCreate: true
      enableChildImportOnParentEdit: true 
      childImportModeOnParentEdit: CREATE_ONLY 
      enableChildCopyOnParentCreate: true
      enableChildCopyOnParentEdit: true
      enableChildCreationOnParentCreate: true
      enableChildCreationOnParentEdit: true 
      enableChildDeleteOnParentEdit: true
      enableChildEditOnParentCreate: true
      enableChildEditOnParentEdit: true
      enableChildRemoveOnParentCreate: true
      enableChildRemoveOnParentEdit: true
      skipToChildCreationOnParentCreate: false
      skipToChildEditingOnParentEdit: false
      linear: false
      _name: Societes
      label: Sociétés
      canFinishSubLevel: true
      enabledOnParentCreate: true
      enabledOnParentEdit: true
      formFieldsMode: AUTO
      childDeleteType: HARD_DELETE
      oneToManyReference: Batiments.references.RelImmSocToImmeuble
      collectionView: Batiments.entities.RelImmSoc.collection_views.RelImmSocCollectionView
      defaultDisplayType: TABLE
      customSortEnabled: false
      userDefinedSortEnabled: true
      displayGridAllowed: false
      displayListAllowed: true
      displayTableAllowed: true
      useCustomCollectionLabel: false
      childSteps:
        - _type: FormStep
          _name: Societes_form
          label: Sociétés
          canFinishSubLevel: true
          enabledOnParentCreate: true
          enabledOnParentEdit: true
          formFieldsMode: AUTO
          enableMasterValuePicking: false
          formTab: Batiments.entities.RelImmSoc.forms.RelImmSocForm.RelImmSoc

          formStepEnrichers:   
            - enricher: Batiments.entities.RelImmSoc.enrichers.DefautDateDebSociete_NewProprio
              executedOnButtonClick: false
              executedOnDataChange: false
              executedOnFormOpen: true

          formStepValidations:  
            - executedOnDataChange: true
              executedOnFormOpen: true
              validationType: MANDATORY
              attribute:  Batiments.references.RelImmSocToSociete.Societe
            - executedOnDataChange: true
              executedOnFormOpen: true
              validationType: MANDATORY
              attribute:  Batiments.references.RelImmSocToTypeSociete.TypeSociete

          stepTransitionValidations:
            - onStepExit: BLOCK
              validationType: MANDATORY
              attribute: Batiments.references.RelImmSocToSociete.Societe
            - onStepExit: BLOCK
              validationType: MANDATORY
              attribute: Batiments.references.RelImmSocToTypeSociete.TypeSociete

stepperFinishValidations:


      - onStepperFinish: BLOCK
        validationType: MANDATORY
        attribute:  Batiments.references.ImmeubleToUsage.Usage
      - onStepperFinish: BLOCK
        validationType: MANDATORY
        attribute:  Batiments.references.ImmeubleToOrgaResp.OrgaResp
      - onStepperFinish: BLOCK
        validationType: MANDATORY
        attribute:  Batiments.references.ImmeubleToPortefeuille.Portefeuille
      - onStepperFinish: BLOCK
        validationType: MANDATORY
        attribute:  Batiments.references.ImmeubleToSousPortefeuille.SousPortefeuille

      - onStepperFinish: BLOCK
        validationType: MANDATORY
        attribute:  Batiments.references.ImmeubleToRegimeJuridique.RegimeJuridique
      - onStepperFinish: BLOCK
        validationType: MANDATORY
        attribute:  Batiments.references.ImmeubleToFiscaliteCible.FiscaliteCible
                                              
      # - onStepperFinish: BLOCK
      #   validationType: MANDATORY
      #   attribute: Batiments.references.ImmeubleToZoneImmostat.ZoneImmostat
      # - onStepperFinish: BLOCK
      #   validationType: MANDATORY
      #   attribute: Batiments.references.ImmeubleToSecteurImmostat.SecteurImmostat
      # - onStepperFinish: BLOCK
      #   validationType: MANDATORY
      #   attribute: Batiments.references.ImmeubleToSousSecteurImmostat.SousSecteurImmostat
      - onStepperFinish: BLOCK
        validationType: CHECK
        validator: Batiments.entities.Immeuble.validations.CheckCoherenceOrgaPortef
      - onStepperFinish: BLOCK
        validationType: CHECK
        validator: Batiments.entities.Immeuble.validations.CheckZoneOrga  
      - onStepperFinish: BLOCK
        validationType: CHECK
        validator: Batiments.entities.Immeuble.validations.CheckSecteurOrga
      - onStepperFinish: BLOCK
        validationType: CHECK
        validator: Batiments.entities.Immeuble.validations.CheckSsSecteurOrga
      - onStepperFinish: BLOCK
        validationType: CHECK
        validator: Batiments.entities.Immeuble.validations.CheckCoherenceSecteur_Zone
      - onStepperFinish: BLOCK
        validationType: CHECK
        validator: Batiments.entities.Immeuble.validations.CheckCoherenceSousSecteur_Secteur
        
      - onStepperFinish: BLOCK
        validationType: CHECK
        validator: Batiments.entities.Immeuble.validations.CheckLongLibelle
      - onStepperFinish: BLOCK
        validationType: CHECK
        validator: Batiments.entities.Immeuble.validations.CheckAscenseur
      - onStepperFinish: BLOCK
        validationType: CHECK
        validator: Batiments.entities.Immeuble.validations.CheckQuartierParis

      - onStepperFinish: BLOCK
        validationType: CHECK
        validator: Batiments.entities.Immeuble.validations.CheckCoherenceDtConstruction
      - onStepperFinish: BLOCK
        validationType: CHECK
        validator: Batiments.entities.Immeuble.validations.CheckDtLivraison
      - onStepperFinish: BLOCK
        validationType: CHECK
        validator: Batiments.entities.Immeuble.validations.CheckPeriodeConstruction