_package: Batiments.entities.Immeuble.validations
_name: CheckQuartierParis
_type: SemQLValidation
entity: Batiments.entities.Immeuble.Immeuble
label: Quartier Paris obligatoire 
condition:  (Ville = 'Paris' and  (FID_Usage = 'HAB' OR FID_Usage = 'MIXTE') and FID_QuartierParis is not null) 
  or Ville != 'Paris' or FID_Usage = 'ENT'
validationScope: POST_CONSO
validationLabel: Quartier Paris doit être renseigné 
