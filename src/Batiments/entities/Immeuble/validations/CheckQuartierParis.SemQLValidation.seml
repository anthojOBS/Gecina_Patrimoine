_package: Batiments.entities.Immeuble.validations
_name: CheckQuartierParis
_type: SemQLValidation
entity: Batiments.entities.Immeuble.Immeuble
label: Quartier Paris obligatoire 
condition:  (FID_OrgaResp = 'DB' and Ville = 'Paris' and  (FID_Usage = 'RESI' OR FID_Usage = 'MIX') and FID_QuartierParis is not null) 
  or Ville != 'Paris' or FID_Usage = 'BUR' or FID_OrgaResp = 'DR'
validationScope: NONE
validationLabel: Quartier Paris doit être renseigné 
