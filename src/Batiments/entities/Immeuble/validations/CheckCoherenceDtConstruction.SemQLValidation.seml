_package: Batiments.entities.Immeuble.validations
_name: CheckCoherenceDtConstruction
_type: SemQLValidation
entity: Batiments.entities.Immeuble.Immeuble
label: Coherence date de construction
condition: (DateFinConstruction >= DateDebutConstruction) or DateDebutConstruction is null or DateFinConstruction is null
