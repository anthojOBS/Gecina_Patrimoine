_package: Batiments.entities.Immeuble.validations
_name: CheckCoherenceOrgaPortef
_type: SemQLValidation
entity: Batiments.entities.Immeuble.Immeuble
label: Coherence organisation responsable / portefeuille
condition: FID_OrgaResp is null or FID_SousPortefeuille is null or (FID_SousPortefeuille is not null and FID_OrgaResp is not null
