_package: Batiments.entities.Immeuble
_type: Entity
_name: Immeuble
label: Immeuble
pluralLabel: Immeuble
entityType: FUZZY_MATCHED
physicalTableName: IMMEUBLE
iconUrl: images://mdi/office-building-marker.svg
description: ""
documentation: |
  L'**Immeuble** représente un actif immobilier dans le patrimoine de Gecina.
  
  Un immeuble est une unité de propriété qui peut contenir un ou plusieurs bâtiments.
  Il est caractérisé par son identifiant, sa localisation géographique, son régime juridique et sa phase dans le cycle de vie du projet.
  
  Cette entité est centrale dans la gestion du patrimoine immobilier et permet de suivre l'évolution des actifs de leur acquisition à leur exploitation.
historizeGolden: true
historizeMaster: true
enableDelete: true
attributes:
  - _type: EntityAttribute
    _name: ImmeubleID
    label: Immeuble ID
    physicalName: IMMEUBLE_ID
    dataType: LongInteger
    precision: 38
    mandatory: true
    searchable: true
    description: "Identifiant unique de l'immeuble"

  - _type: EntityAttribute
    _name: IdentifiantREF
    label: Identifiant REF
    physicalName: IDENTIFIANT_REF
    dataType: String
    length: 100
    mandatory: false
    description: "Identifiant de référence de l'immeuble"

  - _type: EntityAttribute
    _name: IdentifiantsERP
    label: Numéro immeuble
    documentation: Identifiant fonctionnel utilisé au quotidien par les équipes opérationnelles.
    
    physicalName: IDENTIFIANTS_ERP
    dataType: String
    length: 100
    description: "Numéro de l'immeuble"
    mandatory: true
    mandatoryValidationLabel: "Numéro immeuble est obligatoire"
    mandatoryValidationScope: PRE_CONSO

  - _type: EntityAttribute
    _name: Libelle
    label: Libellé immeuble
    documentation: Nom usuel de l’immeuble, tel qu’il apparaît dans les communications métiers.
    physicalName: LIBELLE
    dataType: String
    length: 255
    mandatory: true
    mandatoryValidationLabel: "Libellé de l'immeuble est obligatoire"
    mandatoryValidationScope: PRE_CONSO
    
  - _type: EntityAttribute
    _name: Adresse
    label: Adresse
    documentation: Adresse postale complète de l’actif (numéro, voie, complément éventuel).
    physicalName: ADRESSE
    dataType: String
    length: 255
    mandatory: true
    mandatoryValidationLabel: "Adresse de l'immeuble est obligatoire"
    mandatoryValidationScope: PRE_CONSO

  - _type: EntityAttribute
    _name: AdresseLieuDit
    label: Adresse Lieu Dit
    physicalName: ADRESSE_LIEU_DIT
    dataType: String
    length: 255
    mandatory: false


  - _type: EntityAttribute
    _name: CodePostal
    label: Code Postal
    documentation: Code postal de la commune où est situé l’actif.
    physicalName: CODE_POSTAL
    dataType: String
    length: 20
    mandatory: true 
    mandatoryValidationLabel: "Code postal de l'immeuble est obligatoire"
    mandatoryValidationScope: POST_CONSO

  - _type: EntityAttribute
    _name: Ville
    label: Ville
    documentation: Commune dans laquelle se situe l’actif.
    physicalName: VILLE
    dataType: String
    length: 150
    mandatory: true
    mandatoryValidationLabel: "Ville de l'immeuble est obligatoire"
    mandatoryValidationScope: POST_CONSO

  - _type: EntityAttribute
    _name: AdresseEnrichie
    label: Adresse Enrichie
    physicalName: ADRESSE_ENRICHIE
    dataType: String
    length: 255
    mandatory: false

  - _type: EntityAttribute
    _name: ConcatAddress
    label: Adresse Concaténée
    physicalName: ADRESSE_CONCATENEE
    dataType: String
    length: 255
    mandatory: false

  - _type: EntityAttribute
    _name: DateAcquisition
    label: Date acquisition
    physicalName: DATE_ACQUISITION
    dataType: Date
    mandatory: true
    mandatoryValidationLabel: "Date acquisition est obligatoire"
    mandatoryValidationScope: PRE_CONSO

  - _type: EntityAttribute
    _name: DateVente
    label: Date vente
    physicalName: DATE_VENTE
    dataType: Date
    mandatory: false



  - _type: EntityAttribute
    _name: DateDebutConstruction
    label: Date de début de construction
    physicalName: DATE_DEBUT_CONSTRUCTION
    dataType: Date
    mandatory: false

  - _type: EntityAttribute
    _name: DateFinConstruction
    label: Date de fin de construction
    physicalName: DATE_FIN_CONSTRUCTION
    dataType: Date
    mandatory: false

  - _type: EntityAttribute
    _name: DateLivraison
    label: Date de livraison
    physicalName: DATE_LIVRAISON
    dataType: Date
    mandatory: false

  - _type: EntityAttribute
    _name: DateRestructuration
    label: Date dernière restructuration
    physicalName: DATE_RESTRUCTURATION
    dataType: Date
    mandatory: false

  - _type: EntityAttribute
    _name: DateDebPhase
    label: Date début phase
    physicalName: DATE_DEBUT_PHASE
    dataType: Date
    mandatory: true
    mandatoryValidationLabel: "Date début phase est obligatoire"
    mandatoryValidationScope: PRE_CONSO


  - _type: EntityAttribute
    _name: FlagAscenseur
    label: Flag Ascenseur
    physicalName: FLAG_ASCENSEUR
    dataType: Boolean
    mandatory: false

  - _type: EntityAttribute
    _name: NbAscenseur
    label: Nombre ascenceurs
    physicalName: NB_ASCENSEUR
    dataType: LongInteger
    precision: 20
    mandatory: false

  - _type: EntityAttribute
    _name: NbParking
    label: Nombre parkings
    physicalName: NB_PARKING
    dataType: LongInteger
    precision: 20
    mandatory: false

  - _type: EntityAttribute
    _name: SecteurGeographique
    label: Secteur géographique
    physicalName: SECTEUR_GEOGRAPHIQUE
    dataType: String
    length: 150
    mandatory: false

  - _type: EntityAttribute
    _name: CapaciteAccueil
    label: Capacité d'accueil
    physicalName: CAPA_ACCUEIL
    dataType: LongInteger
    precision: 20
    mandatory: false

  - _type: EntityAttribute
    _name: PosteTravail
    label: Postes de travail
    physicalName: POST_TRAVAIL
    dataType: LongInteger
    precision: 20
    mandatory: false


  - _type: EntityAttribute
    _name: DateFinValidite
    label: Date de fin de validité
    physicalName: DATE_FIN_VALIDITE
    dataType: Date
    mandatory: false

  - _type: EntityAttribute
    _name: Photo
    label: Photo
    physicalName: PHOTO
    dataType: Binary
    mandatory: false
    searchable: false
	
  - _type: EntityAttribute
    _name: SuperficieUtile
    label: Superficie Utile
    description: Surface totale de l’actif exprimée en m²
    documentation: Addition de toutes les surfaces utiles avec QP
    physicalName: SUPERFICIE_UTILE
    dataType: Decimal
    precision: 18
    scale: 2 
    mandatory: true
    mandatoryValidationLabel: "La superficie totale avec QP est obligatoire"
    mandatoryValidationScope: POST_CONSO

  # booleen
  - _type: EntityAttribute
    _name: IGH
    label: Statut IGH 
    physicalName: IGH
    dataType: Boolean
    mandatory: false

  - _type: EntityAttribute
    _name: ERP
    label: Statut ERP 
    physicalName: STATUT_ERP
    dataType: Boolean
    mandatory: false  

  - _type: EntityAttribute
    _name: FlagRestructuration
    label: Flag Restructuration
    physicalName: FLAG_RESTRUCTURATION
    dataType: Boolean
    mandatory: false	

  - _type: EntityAttribute
    _name: Commentaire
    label: Commentaires
    physicalName: COMMENTAIRE
    dataType: String
    length: 250
    mandatory: false

  # - _type: EntityAttribute
  #   _name: NombreParkings
  #   label: Nombre parkings
  #   physicalName: NOMBRE_PARKINGS
  #   dataType: Integer
  #   mandatory: false		

  - _type: EntityAttribute
    _name: ReleveGeometre
    label: Relevé géomètre
    physicalName: RELEVE_GEOMETRE
    dataType: String
    length: 150
    mandatory: false

  - _type: EntityAttribute
    _name: BinaryContent
    label: Binary Content
    physicalName: BINARY_CONTENT
    dataType: Binary
    mandatory: false
    searchable: true

sourceIdGeneration:
  mode: MANUAL

primaryKey: Batiments.entities.Immeuble.Immeuble.ImmeubleID

goldenIdGeneration:
  mode: SEQUENCE
  startWith: 1

matcher:
  _type: SemQLMatcher
  _name: Matcher
  description: ImmeubleSemQLMatcher
  matchRules:
    - _type: SemQLMatchRule
      _name: NewRule
      label: NewRuleLabel
      condition: Record1.IdentifiantsERP = Record2.IdentifiantsERP 
      matchScore: 100
      usingMatchOn: false
    - _type: SemQLMatchRule
      _name: Address
      label: NewRuleLabel
      condition: Record1.AdresseEnrichie = Record2.AdresseEnrichie
      matchScore: 80
      usingMatchOn: false
  useTransitiveMatchScore: true
  useMultiIterationGrouping: true
  mergeThresholdNewGroup: 90
  mergeThresholdMergingUnconfirmed: 90
  mergeThresholdMergingConfirmed: 90
  mergeThresholdMergingConfirmedWithUnconfirmed: 90
  mergeThresholdMergingUnconfirmedWithNewMasters: 90
  mergeThresholdMergingConfirmedWithNewMasters: 90
  mergeThresholdRemergingPreviouslySplit: 100
  autoConfirmGoldenThreshold: 99
  autoConfirmSingletons: true
