_package: Batiments.entities.Immeuble
_type: Entity
_name: Immeuble
label: Immeuble
pluralLabel: Immeuble
entityType: BASIC
physicalTableName: IMMEUBLE
iconUrl: images://mdi/office-building-marker.svg
#description: |
#  Ceci est une description très utiles
#  Comportant un saut de ligne
# documentation: |
#   L'immeuble représente un actif immobilier dans le patrimoine de Gecina.
  
#   Un immeuble est une unité de propriété qui peut contenir un ou plusieurs bâtiments.
#   Il est caractérisé par son identifiant, sa localisation géographique, son régime juridique et sa phase dans le cycle de vie du projet.
  
#   Cette entité est centrale dans la gestion du patrimoine immobilier et permet de suivre l'évolution des actifs de leur acquisition à leur exploitation.
historizeGolden: true
historizeMaster: false
enableDelete: true
attributes:
  - _type: EntityAttribute
    _name: ImmeubleID
    label: Immeuble ID
    physicalName: IMMEUBLE_ID
    dataType: LongInteger
    precision: 38
    mandatory: true
    searchable: true
    description: "Identifiant unique de l'immeuble"

  - _type: EntityAttribute
    _name: IdentifiantREF
    label: Identifiant REF
    physicalName: IDENTIFIANT_REF
    dataType: String
    length: 100
    mandatory: false
    description: "Identifiant de référence de l'immeuble"

  - _type: EntityAttribute
    _name: IdentifiantsERP
    label: Numéro immeuble
    documentation: Identifiant fonctionnel utilisé au quotidien par les équipes opérationnelles.
    
    physicalName: IDENTIFIANTS_ERP
    dataType: String
    length: 100
    description: "Numéro de l'immeuble"
    mandatory: true
    mandatoryValidationLabel: "Numéro immeuble est obligatoire"
    mandatoryValidationScope: PRE_CONSO

  - _type: EntityAttribute
    _name: Libelle
    label: Libellé immeuble
    documentation: Nom usuel de l’immeuble, tel qu’il apparaît dans les communications métiers.
    physicalName: LIBELLE
    dataType: String
    length: 255
    mandatory: true
    mandatoryValidationLabel: "Libellé de l'immeuble est obligatoire"
    mandatoryValidationScope: PRE_CONSO
    
  - _type: EntityAttribute
    _name: Adresse
    label: Adresse
    documentation: Adresse postale complète de l’actif (numéro, voie, complément éventuel).
    physicalName: ADRESSE
    dataType: String
    length: 255
    mandatory: true
    mandatoryValidationLabel: "Adresse de l'immeuble est obligatoire"
    mandatoryValidationScope: PRE_CONSO

  - _type: EntityAttribute
    _name: CodePostal
    label: Code Postal
    documentation: Code postal de la commune où est situé l’actif.
    physicalName: CODE_POSTAL
    dataType: String
    length: 20
    mandatory: true 
    mandatoryValidationLabel: "Code postal de l'immeuble est obligatoire"
    mandatoryValidationScope: PRE_CONSO


  - _type: EntityAttribute
    _name: CodePostalEnrichi
    label: Code Postal
    documentation: Code postal de la commune où est situé l’actif.
    physicalName: CODE_POSTAL_ENRICHI
    dataType: String
    length: 20
    mandatory: false

  - _type: EntityAttribute
    _name: Ville
    label: Ville
    documentation: Commune dans laquelle se situe l’actif.
    physicalName: VILLE
    dataType: String
    length: 150
    mandatory: true
    mandatoryValidationLabel: "Ville de l'immeuble est obligatoire"
    mandatoryValidationScope: PRE_CONSO

  - _type: EntityAttribute
    _name: VilleEnrichie
    label: Ville
    documentation: Commune dans laquelle se situe l’actif.
    physicalName: VILLE_ENRICHIE
    dataType: String
    length: 150
    mandatory: false

  - _type: EntityAttribute
    _name: AdresseStandardise
    label: Adresse
    physicalName: ADRESSE_STANDARDISEE
    dataType: String
    length: 255
    mandatory: false

  - _type: EntityAttribute
    _name: AdresseEnrichie
    label: Adresse Enrichie
    physicalName: ADRESSE_ENRICHIE
    dataType: String
    length: 255
    mandatory: false

  - _type: EntityAttribute
    _name: PaysEnrichie
    label: Pays
    physicalName: PAYS_ENRICHIE
    dataType: String
    length: 255
    mandatory: false

  - _type: EntityAttribute
    _name: ConcatAddress
    label: Adresse Concaténée
    physicalName: ADRESSE_CONCATENEE
    dataType: String
    length: 255
    mandatory: false

  - _type: EntityAttribute
    _name: DateAcquisition
    label: Date acquisition
    physicalName: DATE_ACQUISITION
    dataType: Date
    mandatory: true
    mandatoryValidationLabel: "Date acquisition est obligatoire"
    mandatoryValidationScope: PRE_CONSO



  - _type: EntityAttribute
    _name: DateDebUsage
    label: Date début usage
    physicalName: DATE_DEBUT_USAGE
    dataType: Date
    mandatory: false


  - _type: EntityAttribute
    _name: DateVente
    label: Date vente
    physicalName: DATE_VENTE
    dataType: Date
    mandatory: false



  # - _type: EntityAttribute
  #   _name: DateDebutConstruction
  #   label: Date de début de construction
  #   physicalName: DATE_DEBUT_CONSTRUCTION
  #   dataType: Date
  #   mandatory: false

