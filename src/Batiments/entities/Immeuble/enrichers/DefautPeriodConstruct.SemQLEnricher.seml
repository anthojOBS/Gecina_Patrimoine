_package: Batiments.entities.Immeuble.enrichers
_name: DefautPeriodConstruct
_type: SemQLEnricher
entity: Batiments.entities.Immeuble.Immeuble
label: Enrichissement période de construction
enricherExecutionScope: POST_CONSO
semQlEnricherExpressions: 
  - attributeName: FID_PeriodeConstruction
    expression: case when DATE_PART('year',DateFinConstruction) < '1946'  then '1' 
          when DATE_PART('year',DateFinConstruction) > '1945' and DATE_PART('year',DateFinConstruction) < '1971' then '2' 
          when DATE_PART('year',DateFinConstruction) > '1970' and DATE_PART('year',DateFinConstruction) < '1991' then '3' 
          when DATE_PART('year',DateFinConstruction) > '1990' then '4' 
          else null end
condition: FID_PeriodeConstruction is NULL and DateFinConstruction is not null