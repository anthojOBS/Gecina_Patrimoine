_package: Batiments.entities.Immeuble.enrichers
_name: DefautPays
_type: SemQLEnricher
entity: Batiments.entities.Immeuble.Immeuble
label: Default Country
enricherExecutionScope: NONE
semQlEnricherExpressions: 
  - attributeName: FID_Pays
    expression: case when FID_Pays is NULL then 'FRA' else FID_Pays end
condition: FID_Pays is NULL 