_package: Batiments.entities.Immeuble.enrichers
_name: StandardizeAddress_OPenStreetMap
_type: JavaPluginEnricher
entity: Batiments.entities.Immeuble.Immeuble
label: Standardize Address Enricher
enricherExecutionScope: PRE_CONSO
batchUpdateSize: 1000
processingBatchSize: 1
threadPoolSize: 1
pluginId: com.semarchy.engine.plugins.openstreetmap
numberOfRetry: 0
onErrorBehavior: SKIP_RECORDS
description: OpenStreetMap Address Enricher
condition: Adresse is not null and CodePostal is not null and Ville is not null
pluginParams:
  - paramName: PARAM_OPENSTREETMAP_URL
    value: http://nominatim.openstreetmap.org/
pluginInputs:
  - expression: Adresse
    inputName: IN_ADDRESSLINE
  - expression: Ville
    inputName: IN_CITY
  - expression: CodePostal
    inputName: IN_POSTAL_CODE
pluginOutputs:
- attributeName: Commentaire
  outputName: OUT_DISPLAY_NAME
- attributeName: Libelle
  outputName: OUT_TOWN
- attributeName: CodePostal
  outputName: OUT_POSTAL_CODE
- attributeName: CoordX
  outputName: OUT_LONGITUDE
- attributeName: CoordY
  outputName: OUT_LATITUDE
- attributeName: Ville
  outputName: OUT_CITY