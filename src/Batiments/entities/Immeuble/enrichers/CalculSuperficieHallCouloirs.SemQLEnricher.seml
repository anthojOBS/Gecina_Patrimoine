_package: Batiments.entities.Immeuble.enrichers
_name: CalculSuperficieHallCouloirs
_type: SemQLEnricher
entity: Batiments.entities.Immeuble.Immeuble
label: Calcul Superficie Hall/Couloirs
enricherExecutionScope: POST_CONSO
semQlEnricherExpressions: 
  - attributeName: SuperficieHallCouloir
    expression: (lookup sum (coalesce(SuperficieHall, 0) + coalesce(SuperficieQPPalier, 0) + coalesce(SuperficiePal, 0)) from Batiment.Etage.Lot end)