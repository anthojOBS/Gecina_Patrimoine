_package: Batiments.entities.Immeuble.enrichers
_name: DefautPhase
_type: SemQLEnricher
entity: Batiments.entities.Immeuble.Immeuble
label: Default Phase
enricherExecutionScope: NONE
semQlEnricherExpressions: 
  - attributeName: FID_Phase
    expression: case when FID_Phase is NULL then 'EXP' else FID_Phase end
condition: FID_Phase is NULL 