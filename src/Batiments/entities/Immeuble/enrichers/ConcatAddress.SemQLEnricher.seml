_package: Batiments.entities.Immeuble.enrichers
_name: ConcatAddress
_type: SemQLEnricher
entity: Batiments.entities.Immeuble.Immeuble
label: Concat Address
enricherExecutionScope: NONE
afterEnrichers: Batiments.entities.Immeuble.enrichers.StandardizeAddress
semQlEnricherExpressions: 
  - attributeName: AdresseStandardise
    expression: substr(AdresseEnrichie, 1, sem_instr(AdresseEnrichie,',')-1)
condition: Adresse is not null or CodePostal is not null or Ville is not null