_package: Batiments.entities.Immeuble.enrichers
_name: DefautUsageImmeuble
_type: SemQLEnricher
entity: Batiments.entities.Immeuble.Immeuble
label: Defaut Usage Immeuble
enricherExecutionScope: POST_CONSO

semQlEnricherExpressions: 

  - attributeName: FID_Usage
    expression: case  when (lookup count(FID_Usage) from Batiment.Etage.Lot where FID_Usage = 'BUR' end) > 0  and (lookup count(FID_Usage) from Batiment.Etage.Lot where FID_Usage = 'RESI' end) > 0  then 'MIX'
                         when (lookup count(FID_Usage) from Batiment.Etage.Lot where FID_Usage = 'BUR' end) > 0  and (lookup count(FID_Usage) from Batiment.Etage.Lot where FID_Usage = 'RESI' end) = 0  then 'BUR'
                         when (lookup count(FID_Usage) from Batiment.Etage.Lot where FID_Usage = 'BUR' end) = 0  and (lookup count(FID_Usage) from Batiment.Etage.Lot where FID_Usage = 'RESI' end) > 0  then 'RESI'
                         else NULL end
# condition: FID_Usage is null
