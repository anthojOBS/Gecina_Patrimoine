_package: Batiments.entities.Immeuble.forms
_type: Form
_name: ImmeubleForm
entity: Batiments.entities.Immeuble.Immeuble
default: true
formTabs:
  - _type: FormTab
    _name: Immeuble
    label: Fiche immeuble
    documentationInterpreter: LITERAL
    visibleValue: "1"
    visibleValueInterpreter: LITERAL
    displayFormTabAs: ICON_LABEL
    content:
      - _type: FormContainer
        _name: SectionGlobal
        layoutDirection: ROW
        content:
          - _type: FormContainer
            _name: SectionPrems
            layoutDirection: COLUMN
            content:
              - _type: FormSection
                _name: IdentiteImmeuble
                label: Identité immeuble
                layoutDirection: COLUMN
                visibleValue: "1"
                visibleValueInterpreter: LITERAL
                labelWidth: 200px
                content:
                  - _type: TextField
                    _name: IdentifiantsERP
                    value: IdentifiantsERP
                    label: Numéro immeuble
                    labelProperties:
                      alignment: left
                      typographyValueInterpreter: LITERAL
                      typography: body-2
                      color: md:black
                    useCustomLabel: true
                    dataType: STRING
                  - _type: TextField
                    _name: Libelle
                    value: Libelle
                    label: Libellé immeuble
                    labelProperties:
                      alignment: left
                      typographyValueInterpreter: LITERAL
                      typography: body-2
                      color: md:black
                    useCustomLabel: true
                    dataType: STRING
                  - _type: TextField
                    _name: SuperficieUtile_m2
                    value: case when SuperficieUtile is not null then SuperficieUtile || ' m²' else
                      null end
                    label: Superficie totale avec QP
                    documentation: Addition de toutes les surfaces utiles avec QP Surface totale de
                      l’actif exprimée en m²
                    labelProperties:
                      alignment: left
                      typographyValueInterpreter: LITERAL
                      typography: body-2
                      color: md:black
                    useCustomLabel: true
                    dataType: STRING
   
      - _type: FormContainer
        _name: SectionSecond
        layoutDirection: ROW
        content:
          - _type: FormContainer
            _name: SectionG2
            layoutDirection: COLUMN
            content:
              - _type: FormSection
                _name: LocalisationImmeuble
                label: Localisation
                layoutDirection: ROW
                visibleValue: "1"
                visibleValueInterpreter: LITERAL
                labelWidth: 200px
                content:
                  - _type: FormContainer
                    _name: BlocAdresse
                    layoutDirection: COLUMN
                    content:
                      - _type: TextField
                        _name: Adresse
                        value: Adresse
                        componentProperties:
                          multilineMaxLines: "3"
                          multilineMinLines: "1"
                          isMultiline: "1"
                        label: Adresse
                        labelProperties:
                          alignment: left
                          typographyValueInterpreter: LITERAL
                          typography: body-2
                          color: md:black
                        useCustomLabel: true
                        dataType: STRING
                      - _type: TextField
                        _name: CodePostal
                        value: CodePostal
                        label: Code postal
                        labelProperties:
                          alignment: left
                          typographyValueInterpreter: LITERAL
                          typography: body-2
                          color: md:black
                        useCustomLabel: true
                        dataType: STRING
                      - _type: TextField
                        _name: Ville
                        value: Ville
                        label: Ville
                        labelProperties:
                          alignment: left
                          typography: body-2
                          color: md:black
                        useCustomLabel: true
                        dataType: STRING
                      - _type: ReferenceField
                        _name: FDN_Pays
                        value: FDN_Pays
                        label: Pays
                        labelProperties:
                          alignment: left
                          typography: body-2
                          color: md:black
                        useCustomLabel: true
                        dataType: STRING
                        referencedEntity: Batiments.entities.Pays.Pays
                      - _type: ReferenceField
                        _name: FDN_ZoneImmostat
                        value: FDN_ZoneImmostat
                        label: Zone immostat
                        labelProperties:
                          alignment: left
                          typography: body-2
                          color: md:black
                        useCustomLabel: true
                        dataType: STRING
                        referencedEntity: Batiments.entities.Pays.Pays
                      - _type: ReferenceField
                        _name: FDN_SecteurImmostat
                        value: FDN_SecteurImmostat
                        label: Secteur immostat
                        labelProperties:
                          alignment: left
                          typography: body-2
                          color: md:black
                        useCustomLabel: true
                        dataType: STRING
                        referencedEntity: Batiments.entities.SecteurImmostat.SecteurImmostat
                      - _type: ReferenceField
                        _name: FDN_SousSecteurImmostat
                        value: FDN_SousSecteurImmostat
                        label: Sous secteur immostat
                        labelProperties:
                          alignment: left
                          typography: body-2
                          color: md:black
                        useCustomLabel: true
                        dataType: STRING
                        referencedEntity: Batiments.entities.SousSecteurImmostat.SousSecteurImmostat
                      - _type: TextField
                        _name: FDN_QuartierParis
                        value: FDN_QuartierParis
                        label: Quartier Paris libellé
                        labelProperties:
                          alignment: left
                          typography: body-2
                          color: md:black
                        useCustomLabel: true
                        dataType: STRING
                        referencedEntity: Batiments.entities.QuartierParis.QuartierParis
          - _type: FormContainer
            _name: SectionD2
            layoutDirection: COLUMN
            content:
              - _type: FormSection
                _name: BlocCarte
                label: Carte
                layoutDirection: COLUMN
                visibleValue: "1"
                visibleValueInterpreter: LITERAL
                content:
                  - _type: ObjectField
                    _name: GoogleMaps
                    dataType: STRING
                    label: Google Maps View
                    useCustomLabel: true
                    labelProperties:
                      typography: subtitle-1
                      isVisible: "0"
                    visibleValue: "1"
                    visibleValueInterpreter: LITERAL
                    authoringMode: auto
                    value: >
                      '<html>

                      <head>

                      <meta charset="utf-8">

                      <script
                      src="https://maps.googleapis.com/maps/api/js?key=AIzaSyB_Yyr4bb_JPuAM9gPp2GyXYCxUwl3vpkI&sensor=false"></script>

                      <script>

                      var address = "'||AdresseEnrichie ||'";

                      var zoom = 15;

                      var mapType = google.maps.MapTypeId.ROADMAP;

                      var useMarker = true;

                      var map;

                      function initialize() {
                          var geocoder = new google.maps.Geocoder();
                          geocoder.geocode({"address": address}, function(results, status){
                              if(status==google.maps.GeocoderStatus.OK){ displayMap(results[0].geometry.location); }
                          });
                          window.onresize = resize;
                      }

                      function displayMap(latlng){
                          var mapOptions = {zoom: zoom, center: latlng, mapTypeId: mapType};
                          map = new google.maps.Map(document.getElementById("map_canvas"), mapOptions);
                          if(useMarker){ var marker = new google.maps.Marker({map: map, position: latlng}); }
                          resize("");
                      }

                      function resize(e){
                          var center = map.getCenter();
                          map.getDiv().style.height = window.innerHeight + "px";
                          map.getDiv().style.width = window.innerWidth + "px";
                          google.maps.event.trigger(map, "resize");
                          map.setCenter(center);
                      }

                      google.maps.event.addDomListener(window, "load",
                      initialize);

                      </script>

                      </head>

                      <body style="margin:0px;">

                      <div id="map_canvas" style="margin:0px;"></div>

                      </body>

                      </html>'
                    componentProperties:
                      sourceType: content
                      textTypography: body-1


   
      - _type: FormContainer
        _name: Sectiontrois
        layoutDirection: ROW
        content:
          - _type: FormContainer
            _name: SectionG3
            layoutDirection: COLUMN
            content:
              - _type: FormSection
                _name: Usage
                label: Usage
                layoutDirection: ROW
                visibleValue: "1"
                visibleValueInterpreter: LITERAL
                labelWidth: 200px
                content:
                  - _type: FormContainer
                    _name: BlocUsage
                    layoutDirection: COLUMN
                    content:
                      - _type: ReferenceField
                        _name: FDN_Usage
                        value: FDN_Usage
                        label: Usage
                        labelProperties:
                          alignment: left
                          typography: body-2
                          color: md:black
                        useCustomLabel: true
                        dataType: STRING
                        referencedEntity: Batiments.entities.Usage.Usage

          - _type: FormContainer
            _name: SectionD3
            layoutDirection: COLUMN
            content:
              - _type: FormSection
                _name: Geometre
                label: Relevés géomètres
                layoutDirection: ROW
                visibleValue: "1"
                visibleValueInterpreter: LITERAL
                labelWidth: 200px
                content:
                  - _type: FormContainer
                    _name: BlocGeometre
                    layoutDirection: COLUMN
                    content:
                        - _type: HyperlinkField
                          _name: BinaryContent
                          value: BinaryContent
                          useCustomLabel: true
                          label: Relevé géomètre
                          labelProperties:
                            isVisible: "1"
                            alignment: left
                            typography: body-2
                            color: md:black
                          dataType: BINARY
                          componentProperties:
                            linkDisplayText: Télécharger le relevé géomètre
                            linkSourceType: url
                            textTypography: headline
                            textTypographyValueInterpreter: LITERAL
                     
      - _type: FormContainer
        _name: SectionBas
        layoutDirection: ROW
        content:
          - _type: FormSection
            _name: Caracteristiques
            label: Caractéristiques générales
            layoutDirection: COLUMN
            visibleValue: "1"
            visibleValueInterpreter: LITERAL
            labelWidth: 200px
            content:
              - _type: TextField
                _name: IGH
                value: IGH
                label: IGH
                labelProperties:
                  alignment: left
                  typography: body-2
                  color: md:black
                  isVisible: IGH is not null
                useCustomLabel: true
                visibleValue: IGH is not null
                dataType: BOOLEAN


          - _type: FormSection
            _name: GestionInterne
            label: Gestion interne
            layoutDirection: COLUMN
            visibleValue: "1"
            visibleValueInterpreter: LITERAL
            labelWidth: 200px
            content:
              - _type: ReferenceField
                _name: FDN_Portefeuille
                value: FDN_Portefeuille
                label: Portefeuille
                labelProperties:
                  alignment: left
                  typography: body-2
                  color: md:black
                useCustomLabel: true
                dataType: STRING
                referencedEntity: Batiments.entities.Portefeuille.Portefeuille
              - _type: TextField
                _name: SousPortefeuille
                value: SousPortefeuille
                label: Sous Portefeuille
                labelProperties:
                  alignment: left
                  typography: body-2
                  color: md:black
                useCustomLabel: true
                dataType: STRING

