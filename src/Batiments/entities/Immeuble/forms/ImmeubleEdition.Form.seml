                    # authoringMode: case when :V_USER_ROLES like '%semarchyAdmin%' or  :V_USER_ROLES like '%WriterImmeuble%' then 'auto' else 'force-read-only' end
                    # authoringModeValueInterpreter: SEMQL 
                    label: Type d'énergie
                    documentation: Type d’énergie principale utilisée dans l’immeuble (ex. électricité,
                    labelProperties:
                      alignment: left
                      typography: body-2
                      color: md:black
                    useCustomLabel: true
                    dataType: STRING
                    referencedEntity: Batiments.entities.TypeEnergie.TypeEnergie

                  - _type: TextField
                    _name: StatutIRVE
                    value: StatutIRVE
                    label: Statut IRVE
                    documentation: Indique si l'immeuble est classé selon les critères IRVE.
                    labelProperties:
                      alignment: left
                      typography: body-2
                      color: md:black
                    useCustomLabel: true
                    dataType: BOOLEAN
                    
                  # - _type: ReferenceField
                  #   _name: FDN_TypeCompteur
                  #   value: FDN_TypeCompteur
                  #   label: Type compteur
                  #   labelProperties:
                  #     alignment: left
                  #     typography: body-2
                  #     color: md:black
                  #   useCustomLabel: true
                  #   visibleValue: FID_OrgaResp = 'DR' 
                  #   visibleValueInterpreter: SEMQL
                  #   dataType: STRING
                  #   referencedEntity: Batiments.entities.TypeCompteur.TypeCompteur

                  - _type: TextField
                    _name: CapaciteAccueil
                    value: CapaciteAccueil
                    label: Capacité d'accueil
                    documentation: Nombre maximal de personnes pouvant être présentes simultanément dans l’immeuble.
                    labelProperties:
                      alignment: left
                      typography: body-2
                      color: md:black
                    useCustomLabel: true
                    visibleValue: FID_OrgaResp = 'DB' 
                    visibleValueInterpreter: SEMQL
