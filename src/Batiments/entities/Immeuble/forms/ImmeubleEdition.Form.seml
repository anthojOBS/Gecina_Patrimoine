                    # authoringMode: case when :V_USER_ROLES like '%semarchyAdmin%' or  :V_USER_ROLES like '%WriterImmeuble%' then 'auto' else 'force-read-only' end
                    # authoringModeValueInterpreter: SEMQL
                    label: Mode chauffage
                    documentation: Mode de chauffage principal utilisé dans l’immeuble (ex. collectif, individuel
                    labelProperties:
                      alignment: left
                      typography: body-2
                      color: md:black
                    useCustomLabel: true
                    dataType: STRING
                    referencedEntity: Batiments.entities.ModeChauffage.ModeChauffage
                  - _type: ReferenceField
