_package: Batiments.entities.Immeuble.forms
_type: Form
_name: ImmeubleEdition
entity: Batiments.entities.Immeuble.Immeuble
default: false
formTabs:
  - _type: FormTab
    _name: Immeuble
    label: Fiche immeuble
    documentationInterpreter: LITERAL
    visibleValue: "1"
    visibleValueInterpreter: LITERAL
    displayFormTabAs: ICON_LABEL
    content:
      - _type: FormContainer
        _name: SectionGlobal
        layoutDirection: ROW
        content:
          - _type: FormContainer
            _name: SectionPremsG
            layoutDirection: COLUMN
            content:
              - _type: FormSection
                _name: IdentiteImmeuble
                label: Identité immeuble
                layoutDirection: COLUMN
                visibleValue: "1"
                visibleValueInterpreter: LITERAL
                labelWidth: 200px
                content:
                  - _type: TextField
                    _name: IdentifiantsERP
                    value: IdentifiantsERP
                    label: Numéro immeuble
                    authoringMode: force-read-only
                    labelProperties:
                      alignment: left
                      typographyValueInterpreter: LITERAL
                      typography: body-2
                      color: md:black
                    useCustomLabel: false
                    dataType: STRING
                  - _type: TextField
                    _name: Libelle
                    value: Libelle
                    label: Libellé immeuble
                    authoringMode: force-read-only
                    labelProperties:
                      alignment: left
                      typographyValueInterpreter: LITERAL
                      typography: body-2
                      color: md:black
                    useCustomLabel: false
                    dataType: STRING


              - _type: FormSection
                _name: Usage
                label: Usage
                layoutDirection: ROW
                visibleValue: "1"
                visibleValueInterpreter: LITERAL
                labelWidth: 200px
                content:
                  - _type: FormContainer
                    _name: BlocUsage
                    layoutDirection: COLUMN
                    content:
                      - _type: ReferenceField
                        _name: FDN_Usage
                        value: FDN_Usage
                        label: Usage
                        documentation: Usage principal de l’immeuble, indiquant s’il est destiné à une activité d’entreprise, à de l’habitation ou au deux.
                        labelProperties:
                          alignment: left
                          typography: body-2
                          color: md:black
                        useCustomLabel: true
                        dataType: STRING
                        referencedEntity: Batiments.entities.Usage.Usage


          - _type: FormContainer
            _name: SectionPremsD
            layoutDirection: COLUMN
            content:
              - _type: FormSection
                _name: GestionInterne
                label: Gestion interne
                layoutDirection: COLUMN
                visibleValue: "1"
                visibleValueInterpreter: LITERAL
                labelWidth: 200px
                content:
                  - _type: ReferenceField
                    _name: FDN_OrgaResp
                    value: FDN_OrgaResp
                    label: Organisation responsable
                    documentation: Direction métier en charge de la gestion opérationnelle de l’actif (Direction Résidentielle / Bureaux).
                    labelProperties:
                      alignment: left
                      typography: body-2
                      color: md:black
                    useCustomLabel: true
                    dataType: STRING
                    referencedEntity: Batiments.entities.OrganisationResponsable.OrganisationResponsable

                  # - _type: ReferenceField
                  #   _name: FDN_Portefeuille
                  #   value: FDN_Portefeuille
                  #   label: Portefeuille gestion
                  #   documentation: Ensemble d’actifs rattachés à une même équipe opérationnelle (ex. Portefeuille 1, Portefeuille 2…).
                  #   labelProperties:
                  #     alignment: left
                  #     typography: body-2
                  #     color: md:black
                  #   useCustomLabel: true
                  #   visibleValue: FID_OrgaResp = 'DB' 
                  #   visibleValueInterpreter: SEMQL
                  #   dataType: STRING
                  #   referencedEntity: Batiments.entities.Portefeuille.Portefeuille

                  - _type: ReferenceField
                    _name: FDN_SousPortefeuille_DB
                    value: FDN_SousPortefeuille
                    label: Sous-portefeuille gestion
                    labelProperties:
                      alignment: left
                      typography: body-2
                      color: md:black
                    useCustomLabel: true
                    dataType: STRING
                    visibleValue: FID_OrgaResp = 'DB' 
                    visibleValueInterpreter: SEMQL
                    referencedEntity: Batiments.entities.SousPortefeuille.SousPortefeuille

                  - _type: ReferenceField
                    _name: FDN_SousPortefeuille_DR
                    value: FDN_SousPortefeuille
                    label: Portefeuille gestion
                    labelProperties:
                      alignment: left
                      typography: body-2
                      color: md:black
                    useCustomLabel: true
                    dataType: STRING
                    visibleValue: FID_OrgaResp = 'DR' 
                    visibleValueInterpreter: SEMQL
                    referencedEntity: Batiments.entities.SousPortefeuille.SousPortefeuille

                  - _type: ReferenceField
                    _name: FDN_PerimetreGestion
                    value: FDN_PerimetreGestion
                    label: Périmètre gestion
                    labelProperties:
                      alignment: left
                      typography: body-2
                      color: md:black
                    useCustomLabel: true
                    visibleValue: FID_OrgaResp = 'DR' 
                    visibleValueInterpreter: SEMQL
                    dataType: STRING
                    referencedEntity: Batiments.entities.PerimetreGestion.PerimetreGestion

      - _type: FormContainer
        _name: SectionDeux
        layoutDirection: ROW
        content:

              - _type: FormSection
                _name: LocalisationImmeuble
                label: Localisation
                layoutDirection: ROW
                visibleValue: "1"
                visibleValueInterpreter: LITERAL
                labelWidth: 200px
                content:
                  - _type: FormContainer
                    _name: BlocAdresse
                    layoutDirection: COLUMN
                    content:
                      - _type: TextField
                        _name: Adresse
                        value: Adresse
                        authoringMode: force-read-only
                        componentProperties:
                          multilineMaxLines: "2"
                          multilineMinLines: "1"
                          isMultiline: "1"
                        label: Adresse
                        labelProperties:
                          alignment: left
                          typographyValueInterpreter: LITERAL
                          typography: body-2
                          color: md:black
                        useCustomLabel: false
                        dataType: STRING

                      - _type: TextField
                        _name: CodePostal
                        value: CodePostal
                        label: Code postal
                        authoringMode: force-read-only
                        labelProperties:
                          alignment: left
                          typographyValueInterpreter: LITERAL
                          typography: body-2
                          color: md:black
                        useCustomLabel: false
                        dataType: STRING
                      - _type: TextField
                        _name: Ville
                        value: Ville
                        label: Ville
                        authoringMode: force-read-only
                        labelProperties:
                          alignment: left
                          typography: body-2
                          color: md:black
                        useCustomLabel: false
                        dataType: STRING
                      - _type: ReferenceField
                        _name: FDN_Pays
                        value: FDN_Pays
                        label: Pays
                        authoringMode: force-read-only
                        documentation: Pays dans lequel se situe l’actif.
                        labelProperties:
                          alignment: left
                          typography: body-2
                          color: md:black
                        useCustomLabel: true
                        dataType: STRING
                        referencedEntity: Batiments.entities.Pays.Pays
                      - _type: ReferenceField
                        _name: FDN_ZoneImmostat
                        value: FDN_ZoneImmostat
                        label: Zone immostat
                        documentation: Découpage géographique de gestion 
                        labelProperties:
                          alignment: left
                          typography: body-2
                          color: md:black
                        useCustomLabel: true
                        dataType: STRING
                        referencedEntity: Batiments.entities.Pays.Pays
                      - _type: ReferenceField
                        _name: FDN_SecteurImmostat
                        value: FDN_SecteurImmostat
                        label: Secteur immostat
                        documentation: Découpage géographique de gestion
                        labelProperties:
                          alignment: left
                          typography: body-2
                          color: md:black
                        useCustomLabel: true
                        dataType: STRING
                        referencedEntity: Batiments.entities.SecteurImmostat.SecteurImmostat
                      - _type: ReferenceField
                        _name: FDN_SousSecteurImmostat
                        value: FDN_SousSecteurImmostat
                        label: Sous-secteur immostat
                        documentation: Découpage géographique de gestion
                        labelProperties:
                          alignment: left
                          typography: body-2
                          color: md:black
                        useCustomLabel: true
                        dataType: STRING
                        referencedEntity: Batiments.entities.SousSecteurImmostat.SousSecteurImmostat
                      - _type: TextField
                        _name: FDN_QuartierParis
                        value: FDN_QuartierParis
                        label: Quartier Paris
                        documentation: Quartier de la ville de Paris lorsque applicable.
                        labelProperties:
                          alignment: left
                          typography: body-2
                          color: md:black
                          #isVisible: Ville is null or Ville = 'Paris' or FDN_Usage = 'ENTREPRISE' or FDN_Usage is null
                        useCustomLabel: true
                        dataType: STRING
                        visibleValue: VilleEnrichie = 'Paris' and  (FID_Usage = 'RESI' OR FID_Usage = 'MIX')
                        visibleValueInterpreter: SEMQL
                        referencedEntity: Batiments.entities.QuartierParis.QuartierParis


              - _type: FormSection
                _name: Carte
                label: Carte
                layoutDirection: ROW
                visibleValue: "1"
                visibleValueInterpreter: LITERAL
                labelWidth: 200px
                content:
                  - _type: ObjectField
                    _name: GoogleMaps

                    dataType: STRING
                    label: Google Maps View
                    useCustomLabel: true
                    labelProperties:
                      typography: subtitle-1
                      isVisible: "0"
                    visibleValue: "1"
                    visibleValueInterpreter: LITERAL
                    authoringMode: auto
                    value: >
                      '<html>

                      <head>

                      <meta charset="utf-8">

                      <script
                      src="https://maps.googleapis.com/maps/api/js?key=AIzaSyB_Yyr4bb_JPuAM9gPp2GyXYCxUwl3vpkI&sensor=false"></script>

                      <script>

                      var address = "'||AdresseEnrichie ||'";

                      var zoom = 15;

                      var mapType = google.maps.MapTypeId.ROADMAP;

                      var useMarker = true;

                      var map;

                      function initialize() {
                          var geocoder = new google.maps.Geocoder();
                          geocoder.geocode({"address": address}, function(results, status){
                              if(status==google.maps.GeocoderStatus.OK){ displayMap(results[0].geometry.location); }
                          });
                          window.onresize = resize;
                      }

                      function displayMap(latlng){
                          var mapOptions = {zoom: zoom, center: latlng, mapTypeId: mapType};
                          map = new google.maps.Map(document.getElementById("map_canvas"), mapOptions);
                          if(useMarker){ var marker = new google.maps.Marker({map: map, position: latlng}); }
                          resize("");
                      }

                      function resize(e){
                          var center = map.getCenter();
                          map.getDiv().style.height = window.innerHeight + "px";
                          map.getDiv().style.width = window.innerWidth + "px";
                          google.maps.event.trigger(map, "resize");
                          map.setCenter(center);
                      }

                      google.maps.event.addDomListener(window, "load",
                      initialize);

                      </script>

                      </head>

                      <body style="margin:0px;">

                      <div id="map_canvas" style="margin:0px;"></div>

                      </body>

                      </html>'
                    componentProperties:
                      sourceType: content
                      textTypography: body-1
                      objectHeight: 600px # permet agrandir la carte
  

      - _type: FormContainer
        _name: Sectiontrois
        layoutDirection: ROW
        content:
          - _type: FormContainer
            _name: SectionG3
            layoutDirection: COLUMN
