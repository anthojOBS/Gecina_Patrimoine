    content:
      - _type: FormContainer
        _name: ContainerCycleVie
        layoutDirection: COLUMN
        content:


          - _type: FormContainer
            _name: ContainerCycleVieHaut
            layoutDirection: ROW
            content:

                            - _type: FormSection
                              _name: Etat
                              label: Etat
                              layoutDirection: COLUMN
                              visibleValue: "1"
                              visibleValueInterpreter: LITERAL
                              labelWidth: 300px
