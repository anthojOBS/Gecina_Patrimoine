      - _type: FormSection
        _name: Services
        label: Services non individualisés
        layoutDirection: COLUMN
        visibleValue: (lookup count (IdentifiantsERP) from Batiment.Etage.Lot where FID_TypologieLot = 'SNI' end ) > 0
        visibleValueInterpreter: SEMQL

        content:
          - _type: FormCollection
            _name: Services
            label: Services non individualisés
            useCustomLabel: true
            collection: Batiments.entities.Lot.collection_views.LotCollectionView
            tableAllowed: true
            listAllowed: false
            gridAllowed: false
