                documentation: Superficie halls/couloir.
                labelProperties:
                  alignment: left
                  typographyValueInterpreter: LITERAL
                  typography: body-2
                  color: md:black
                useCustomLabel: true
                dataType: STRING
              - _type: TextField
                _name: SurperficieTerrasses
                value: case when SurperficieTerrasses is not null then SurperficieTerrasses || ' m²' else null end
                label: Superficie terrasses
                documentation: Superficie terrasses.
                labelProperties:
                  alignment: left
