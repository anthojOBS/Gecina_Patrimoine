_package: Batiments.entities.Immeuble.action_sets
_type: ActionSet
_name: ImmeubleActionSet
entity: Batiments.entities.Immeuble.Immeuble
label: Immeuble Action Set
defaultActionSet: true
actions:
  - _type: CreateAction
    _name: CreateAuthorImmeubles
    label: Création immeuble
    useCustomLabel: true
    stepper: Batiments.entities.Immeuble.steppers.ImmeublesCreation
    createMultiple: false
    createdRecordType: GOLDEN
    waitDialogEnabled: false
    allowOtherPublishers: true
  - _type: EditAction
    _name: EditAuthorImmeubles
    label: Edition immeuble
    useCustomLabel: true
    stepper: Batiments.entities.Immeuble.steppers.AuthorImmeubles
    multipleSelectionAllowed: true
    availableForGoldenData: true
    availableForMasterData: true
    availableForErrorData: true
    waitDialogEnabled: false
  - _type: EditAction
    _name: EditImmeubleCycleVie
    label: Edition cycle de vie
    useCustomLabel: true
    stepper: Batiments.entities.Immeuble.steppers.ImmeublesEditCycleVie
    multipleSelectionAllowed: true
    availableForGoldenData: true
    availableForMasterData: true
    availableForErrorData: true
    waitDialogEnabled: false
  - _type: EditAction
    _name: EditImmeubleFiscaliteJuridique
    label: Edition fiscalité et juridique
    useCustomLabel: true
    stepper: Batiments.entities.Immeuble.steppers.ImmeublesEditFiscaliteJuridique
    multipleSelectionAllowed: true
    availableForGoldenData: true
    availableForMasterData: true
    availableForErrorData: true
    waitDialogEnabled: false
  - _type: MassUpdateAction
    _name: MassUpdateAuthorImmeubles
    label: Mise à jour de masse
    useCustomLabel: true
    stepper: Batiments.entities.Immeuble.steppers.AuthorImmeubles
    availableForGoldenData: true
    availableForErrorData: true
    availableForMasterData: true
    waitDialogEnabled: false
  - _type: DeleteAction
    _name: Delete
    label: Supprimer
    useCustomLabel: true
    multipleSelectionAllowed: true
    deleteType: HARD_DELETE
    waitDialogEnabled: false
    availableForGoldenData: true
    availableForMasterData: true
  - _type: ExportAction
    _name: Export
    label: Exporter
    useCustomLabel: true
    waitDialogEnabled: false
  - _type: ImportAction
    _name: ImportAuthorImmeubles
    label: Importer
    useCustomLabel: false
    importMode: CREATE_AND_UPDATE
    stepper: Batiments.entities.Immeuble.steppers.AuthorImmeubles
    importedRecordType: MASTER
    defaultPublisher: Batiments.publishers.VisionReelle
    waitDialogEnabled: false
    allowOtherPublishers: true
  - _type: BrowseGraphAction
    _name: BrowseGraph
    label: Browse Graph
    useCustomLabel: true
    waitDialogEnabled: false
  - _type: DirectConfirmDupsAction
    _name: DirectConfirmDuplicates
    label: Direct Confirm Duplicates
    useCustomLabel: false
    waitDialogEnabled: false
  - _type: ReviewAndConfirm
    _name: ReviewAndConfirmDuplicatesManageDuplicatesOnImmeuble
    label: Review and Confirm Duplicates
    useCustomLabel: true
    dupsManager: Batiments.entities.Immeuble.dups_managers.ManageDuplicatesOnImmeuble
    enableEdit: true
    mandateConfirmAll: false
    waitDialogEnabled: false
  - _type: MergeOrSplit
    _name: MergeOrSplitDuplicatesManageDuplicatesOnImmeuble
    label: Merge Or Split Duplicates
    useCustomLabel: true
    dupsManager: Batiments.entities.Immeuble.dups_managers.ManageDuplicatesOnImmeuble
    enableEdit: true
    waitDialogEnabled: false
  - _type: ReviewSuggestions
    _name: ReviewSuggestionsDuplicatesManageDuplicatesOnImmeuble
    label: Review Duplicates Suggestions
    useCustomLabel: true
    dupsManager: Batiments.entities.Immeuble.dups_managers.ManageDuplicatesOnImmeuble
    enableEdit: true
    waitDialogEnabled: false
    onAcceptPromptGoldenId: false
    mandateResolveAllSuggestions: false
  - _type: ExplainRecordAction
    _name: ExplainRecord
    label: Explain Record
    useCustomLabel: true
    displayCard: Batiments.entities.Immeuble.display_cards.ImmeubleDisplayCard
    formTab: Batiments.entities.Immeuble.forms.ImmeubleForm.Immeuble
    waitDialogEnabled: false
