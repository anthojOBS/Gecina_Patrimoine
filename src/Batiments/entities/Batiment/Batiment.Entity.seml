_package: Batiments.entities.Batiment
_type: Entity
_name: Batiment
label: Batiment
pluralLabel: Batiments
entityType: FUZZY_MATCHED
physicalTableName: BATIMENT
iconUrl: images://mdi/domain.svg
description: ""
documentation: |
  Le **Bâtiment** représente une structure physique au sein d'un immeuble.
  
  Un bâtiment est une unité architecturale qui fait partie d'un immeuble. Il peut contenir plusieurs étages et est caractérisé par son type (bureaux, résidentiel, etc.) et sa zone géographique.
  
  Cette entité permet de gérer la structure physique du patrimoine immobilier et d'organiser les espaces de manière hiérarchique.
historizeGolden: true
historizeMaster: true
enableDelete: true
attributes:
  - _type: EntityAttribute
    _name: BatimentID
    label: Batiment ID
    physicalName: BATIMENT_ID
    dataType: LongInteger
    precision: 38
    mandatory: true
    searchable: true

  - _type: EntityAttribute
    _name: IdentifiantREF
    label: Identifiant REF
    physicalName: IDENTIFIANT_REF
    dataType: String
    length: 100
    mandatory: false
    searchable: true

  - _type: EntityAttribute
    _name: IdentifiantsERP
    label: Numéro bâtiment
    physicalName: IDENTIFIANTS_ERP
    dataType: String
    length: 100
    mandatory: true
    mandatoryValidationLabel: "Numéro bâtiment est obligatoire"
    mandatoryValidationScope: POST_CONSO

  - _type: EntityAttribute
    _name: Libelle_Batiment
    label: Libellé
    physicalName: LIBELLE
    dataType: String
    length: 255
    mandatory: true
    mandatoryValidationLabel: "Le libellé du bâtiment est obligatoire"
    mandatoryValidationScope: POST_CONSO
    searchable: true

  - _type: EntityAttribute
    _name: Adresse
    label: Adresse
    physicalName: ADRESSE
    dataType: String
    length: 255
    mandatory: true
    mandatoryValidationLabel: "Adresse du bâtiment est obligatoire"
    mandatoryValidationScope: POST_CONSO

  - _type: EntityAttribute
    _name: AdresseStandardise
    label: Adresse
    physicalName: ADRESSE_STANDARDISEE
    dataType: String
    length: 255
    mandatory: false

  - _type: EntityAttribute
    _name: CodePostal
    label: Code Postal
    physicalName: CODE_POSTAL
    dataType: String
    length: 255
    mandatory: true
    mandatoryValidationLabel: "Le code postal du bâtiment est obligatoire"
    mandatoryValidationScope: POST_CONSO

  - _type: EntityAttribute
    _name: Ville
    label: Ville
    physicalName: VILLE
    dataType: String
    length: 255
    mandatory: true
    mandatoryValidationLabel: "La ville du bâtiment est obligatoire"
    mandatoryValidationScope: POST_CONSO

  - _type: EntityAttribute
    _name: AdresseEnrichie
    label: Adresse Enrichie
    physicalName: ADRESSE_ENRICHIE
    dataType: String
    length: 255
    mandatory: false

  - _type: EntityAttribute
    _name: CodePostalEnrichi
    label: Code Postal
    documentation: Code postal de la commune où est situé l’actif.
    physicalName: CODE_POSTAL_ENRICHI
    dataType: String
    length: 20
    mandatory: false

  - _type: EntityAttribute
    _name: VilleEnrichie
    label: Ville
    documentation: Commune dans laquelle se situe l’actif.
    physicalName: VILLE_ENRICHIE
    dataType: String
    length: 150
    mandatory: false

  - _type: EntityAttribute
    _name: PaysEnrichie
    label: Pays
    physicalName: PAYS_ENRICHIE
    dataType: String
    length: 255
    mandatory: false

  - _type: EntityAttribute
    _name: DateDebUsage
    label: Date début usage
    physicalName: DATE_DEB_USAGE
    dataType: Date
    mandatory: false
  # - _type: EntityAttribute
  #   _name: DateDebEtat
  #   label: Date début gestion 
  #   physicalName: DATE_DEB_ETAT
  #   dataType: Date
  #   mandatory: false

  - _type: EntityAttribute
    _name: DateAcquisition
    label: Date acquisition
    physicalName: DATE_ACQUISITION
    dataType: Date
    mandatory: false


  # - _type: EntityAttribute
  #   _name: DateDebutConstruction
  #   label: Date début de construction
  #   physicalName: DATE_DEBUT_CONSTRUCTION
  #   dataType: Date
  #   mandatory: false

  # - _type: EntityAttribute
  #   _name: DateFinConstruction
  #   label: Date fin de construction
  #   physicalName: DATE_FIN_CONSTRUCTION
  #   dataType: Date
  #   mandatory: false

  - _type: EntityAttribute
    _name: DateLivraison
    label: Date livraison
    physicalName: DATE_LIVRAISON
    dataType: Date
    mandatory: false

  - _type: EntityAttribute
    _name: BatimentPrincipal
    label: Flag batiment principal
    physicalName: BATIMENT_PRINCIPAL
    dataType: Boolean
    mandatory: false

    
  - _type: EntityAttribute
    _name: FlagAscenseur
    label: Flag Ascenseur
    physicalName: FLAG_ASCENSEUR
    dataType: Boolean
    mandatory: false
  - _type: EntityAttribute
    _name: AccesParking
    label: Accès parking
    physicalName: ACCES_PARKING
    dataType: Boolean
    mandatory: false

  - _type: EntityAttribute
    _name: Commentaire
    label: Commentaires
    physicalName: COMMENTAIRE
    dataType: String
    length: 250
    mandatory: false
    
sourceIdGeneration:
  mode: MANUAL

primaryKey: Batiments.entities.Batiment.Batiment.BatimentID

goldenIdGeneration:
  mode: SEQUENCE
  startWith: 1

matcher:
  _type: SemQLMatcher
  _name: Matcher
  description: BatimentSemQLMatcher
  matchRules:
    - _type: SemQLMatchRule
      _name: NewRule
      label: NewRuleLabel
      condition: ((Record1.IdentifiantsERP = Record2.IdentifiantsERP) or 
       ( Record1.Libelle_Batiment like '%unique%' or Record2.Libelle_Batiment like '%unique%' )
        or ( Record1.IdentifiantsERP = 'PK' and Record2.AccesParking = '1' and  Record1.AdresseStandardise = Record2.AdresseStandardise)) 
       and Record1.FID_Immeuble = Record2.FID_Immeuble
      matchScore: 100
      usingMatchOn: false
  useTransitiveMatchScore: true
  useMultiIterationGrouping: true
  mergeThresholdNewGroup: 90
  mergeThresholdMergingUnconfirmed: 90
  mergeThresholdMergingConfirmed: 90
  mergeThresholdMergingConfirmedWithUnconfirmed: 90
  mergeThresholdMergingUnconfirmedWithNewMasters: 90
  mergeThresholdMergingConfirmedWithNewMasters: 90
  mergeThresholdRemergingPreviouslySplit: 100
  autoConfirmGoldenThreshold: 99
  autoConfirmSingletons: false
