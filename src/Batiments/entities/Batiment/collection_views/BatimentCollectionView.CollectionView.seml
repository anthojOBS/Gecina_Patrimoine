  - _type: TextColumn
    _name: SousPortefeuille
    value: Immeuble.FDN_SousPortefeuille
    label: Sous-portefeuille
    useCustomLabel: true
    dataType: STRING
    columnAlign: LEFT
    visibleByDefault: true

  # - _type: ReferenceColumn
  #   _name: FDN_Usage
  #   value: FDN_Usage  
  #   useCustomLabel: false
  #   dataType: STRING
  #   columnAlign: LEFT
  #   visibleByDefault: true
  #   referencedEntity: Batiments.entities.Usage.Usage


  - _type: TextColumn
    _name: UsageDetail
    value: case  when (lookup count(FID_Usage) from Etage.Lot where FID_Usage = 'BUR' end) > 0  and (lookup count(FID_Usage) from Etage.Lot where FID_Usage = 'RESI' end) > 0  then 'Mixte'
      when (lookup count(FID_Usage) from Etage.Lot where FID_Usage = 'BUR' end) > 0  and (lookup count(FID_Usage) from Etage.Lot where FID_Usage = 'RESI' end) = 0  then 'Tertiaire'
      when (lookup count(FID_Usage) from Etage.Lot where FID_Usage = 'BUR' end) = 0  and (lookup count(FID_Usage) from Etage.Lot where FID_Usage = 'RESI' end) > 0  then 'Résidentiel'
      else Null end
    useCustomLabel: true
    label: Usage
    dataType: STRING
    columnAlign: LEFT
    visibleByDefault: true

  - _type: ReferenceColumn
    _name: FDN_FiscaliteCible
    value: FDN_FiscaliteCible
