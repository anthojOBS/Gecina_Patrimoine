_package: Batiments.entities.Batiment.collection_views
_type: CollectionView
_name: BatimentCollectionView_history
entity: Batiments.entities.Batiment.Batiment
default: true
displayCard: Batiments.entities.Batiment.display_cards.BatimentDisplayCard
gridAllowed: false
gridColumns: 4
gridTextPosition: BOTTOM
gridTileHeight: 1:1
gridTileLines: 1
listAllowed: true
listItemLines: 1
listShowDisplayCardAvatar: false
listShowDivider: true
tableAllowed: true
tableDisplayCardColumnLabel: Batiment
tableRowLines: 2
tableShowDisplayCard: true
tableColumns:
