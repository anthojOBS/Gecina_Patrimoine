_package: Batiments.entities.Batiment.steppers
_type: Stepper
_name: BatimentEdition
entity: Batiments.entities.Batiment.Batiment
label: Batiments
rootStep:
  _type: CollectionStep
  _name: Batiments
  label: Fiche bâtiment
  canFinishSubLevel: true
  enabledOnParentCreate: true
  enabledOnParentEdit: true
  formFieldsMode: AUTO
  linear: false
  childDeleteType: HARD_DELETE
  collectionView: Batiments.entities.Batiment.collection_views.BatimentCollectionView
  defaultDisplayType: TABLE
  customSortEnabled: false
  userDefinedSortEnabled: true
  displayGridAllowed: false
  displayListAllowed: true
  displayTableAllowed: true
  useCustomCollectionLabel: false
  childSteps:
    - _type: FormStep
      _name: Batiment
      label: Batiment
      canFinishSubLevel: true
      enabledOnParentCreate: true
      enabledOnParentEdit: true
      formFieldsMode: AUTO
      enableMasterValuePicking: false
      formTab: Batiments.entities.Batiment.forms.BatimentEdition.Batiment


    # - _type: CollectionStep
    #   enableChildImportOnParentCreate: true
    #   enableChildImportOnParentEdit: true 
    #   childImportModeOnParentEdit: CREATE_ONLY 
    #   enableChildCopyOnParentCreate: true
    #   enableChildCopyOnParentEdit: true
    #   enableChildCreationOnParentCreate: true
    #   enableChildCreationOnParentEdit: true 
    #   enableChildDeleteOnParentEdit: true
    #   enableChildEditOnParentCreate: true
    #   enableChildEditOnParentEdit: true
    #   enableChildRemoveOnParentCreate: true
    #   enableChildRemoveOnParentEdit: true
    #   skipToChildCreationOnParentCreate: false
    #   skipToChildEditingOnParentEdit: false
    #   linear: false
    #   _name: Composition
    #   label: Composition
    #   canFinishSubLevel: true
    #   enabledOnParentCreate: true
    #   enabledOnParentEdit: true
    #   formFieldsMode: AUTO
    #   childDeleteType: HARD_DELETE
    #   oneToManyReference: Batiments.references.EtageToBatiment
    #   collectionView: Batiments.entities.Etage.collection_views.EtageCompositionConsultation
    #   defaultDisplayType: TABLE
    #   customSortEnabled: false
    #   userDefinedSortEnabled: true
    #   displayGridAllowed: false
    #   displayListAllowed: true
    #   displayTableAllowed: true
    #   useCustomCollectionLabel: false
    #   childSteps:
    #     - _type: FormStep
    #       _name: Etage_form
    #       label: Composition des étages 
    #       canFinishSubLevel: true
    #       enabledOnParentCreate: true
    #       enabledOnParentEdit: true
    #       formFieldsMode: AUTO
    #       enableMasterValuePicking: false
    #       formTab: Batiments.entities.Etage.forms.EtageForm.Etage


    - _type: FormStep
      _name: CycleDeVie
      label: Cycle de vie
      canFinishSubLevel: true
      enabledOnParentCreate: true
      enabledOnParentEdit: true
      formFieldsMode: AUTO
      enableMasterValuePicking: false
      formTab: Batiments.entities.Batiment.forms.BatimentEdition.CycleVieBatiment
      
      formStepEnrichers:   
        - enricher: Batiments.entities.Batiment.enrichers.DefautPhase
          executedOnButtonClick: false
          executedOnDataChange: false
          executedOnFormOpen: true
        - enricher: Batiments.entities.Batiment.enrichers.DefautPeriodConstruct
          executedOnButtonClick: false
          executedOnDataChange: true
          executedOnFormOpen: true

      formStepValidations: 
        - validator: Batiments.entities.Batiment.validations.CheckDtLivraison
          executedOnDataChange: true
          executedOnFormOpen: true
          validationType: CHECK
          attribute: Batiments.entities.Batiment.Batiment.DateLivraison
        - validator: Batiments.entities.Batiment.validations.CheckCoherenceDtConstruction
          executedOnDataChange: true
          executedOnFormOpen: true
          validationType: CHECK
          attribute: Batiments.entities.Batiment.Batiment.DateFinConstruction
        - validator: Batiments.entities.Immeuble.validations.CheckPeriodeConstruction
          executedOnDataChange: true
          executedOnFormOpen: true
          validationType: CHECK
          attribute:  Batiments.references.BatimentToPeriodeConstruction.PeriodeConstruction

      stepTransitionValidations:
        - onStepExit: BLOCK
          validationType: CHECK
          validator: Batiments.entities.Batiment.validations.CheckDtLivraison
        - onStepExit: BLOCK
          validationType: CHECK
          validator: Batiments.entities.Batiment.validations.CheckCoherenceDtConstruction
        - onStepExit: BLOCK
          validationType: CHECK
          validator: Batiments.entities.Batiment.validations.CheckPeriodeConstruction

    - _type: FormStep
      _name: JuridiquePropriete
      label: Juridique et propriété 
      canFinishSubLevel: true
      enabledOnParentCreate: true
      enabledOnParentEdit: true
      formFieldsMode: AUTO
      enableMasterValuePicking: false
      formTab: Batiments.entities.Batiment.forms.BatimentEdition.FiscaliteJuridique

      formStepEnrichers:   
        - enricher: Batiments.entities.Batiment.enrichers.DefautRegimeTVA
          executedOnButtonClick: false
          executedOnDataChange: false
          executedOnFormOpen: true
        - enricher: Batiments.entities.Batiment.enrichers.DefautRegimeJuridique
          executedOnButtonClick: false
          executedOnDataChange: false
          executedOnFormOpen: true
          
      formStepValidations:  
        - executedOnDataChange: true
          executedOnFormOpen: true
          validationType: MANDATORY
          attribute:  Batiments.references.BatimentToRegimeJuridique.RegimeJuridique
        - executedOnDataChange: true
          executedOnFormOpen: true
          validationType: MANDATORY
          attribute:  Batiments.references.BatimentToFiscaliteCible.FiscaliteCible


stepperFinishValidations:


  - onStepperFinish: BLOCK
    validationType: MANDATORY
    attribute:  Batiments.references.BatimentToRegimeJuridique.RegimeJuridique
  - onStepperFinish: BLOCK
    validationType: MANDATORY
    attribute:  Batiments.references.BatimentToFiscaliteCible.FiscaliteCible
  - onStepperFinish: BLOCK
    validationType: CHECK
    validator: Batiments.entities.Batiment.validations.CheckCoherenceDtConstruction
  - onStepperFinish: BLOCK
    validationType: CHECK
    validator: Batiments.entities.Batiment.validations.CheckDtLivraison
  - onStepperFinish: BLOCK
    validationType: CHECK
    validator: Batiments.entities.Batiment.validations.CheckPeriodeConstruction