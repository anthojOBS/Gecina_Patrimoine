_package: Batiments.entities.Batiment.steppers
_type: Stepper
_name: BatimentEdition
entity: Batiments.entities.Batiment.Batiment
label: Batiments
rootStep:
  _type: CollectionStep
  _name: Batiments
  label: Fiche bâtiment
  canFinishSubLevel: true
  enabledOnParentCreate: true
  enabledOnParentEdit: true
  formFieldsMode: AUTO
  linear: false
  childDeleteType: HARD_DELETE
  collectionView: Batiments.entities.Batiment.collection_views.BatimentCollectionView
  defaultDisplayType: TABLE
  customSortEnabled: false
  userDefinedSortEnabled: true
  displayGridAllowed: false
  displayListAllowed: true
  displayTableAllowed: true
  useCustomCollectionLabel: false
  childSteps:
    - _type: FormStep
      _name: Batiment
      label: Batiment
      canFinishSubLevel: true
      enabledOnParentCreate: true
      enabledOnParentEdit: true
      formFieldsMode: AUTO
      enableMasterValuePicking: false
      formTab: Batiments.entities.Batiment.forms.BatimentEdition.Batiment

      formStepEnrichers:   
        - enricher: Batiments.entities.Batiment.enrichers.DefautRegimeTVA
          executedOnButtonClick: false
          executedOnDataChange: true
          executedOnFormOpen: false
        - enricher: Batiments.entities.Batiment.enrichers.DefautRegimeJuridique
          executedOnButtonClick: false
          executedOnDataChange: true
          executedOnFormOpen: false

    - _type: FormStep
      _name: CycleDeVie
      label: Cycle de vie
      canFinishSubLevel: true
      enabledOnParentCreate: true
      enabledOnParentEdit: true
      formFieldsMode: AUTO
      enableMasterValuePicking: false
      formTab: Batiments.entities.Batiment.forms.BatimentEdition.CycleVieBatiment
      referenceFormFieldConfigs:
        - enableCreateReference: false
          enableUserSort: true
          referencePickerType: AUTO_COMPLETE
          fdnFormField: Batiments.entities.Batiment.forms.BatimentEdition.CycleVieBatiment.Global.Gauche.Etat.FDN_Etat          
          referenceFilter: Referenced.EtatCode <> 'VENDU'
          referencePickerCollectionView: Batiments.entities.Etat.collection_views.EtatCollectionView
          # referencePickerSearchTypeConfigs: []

      formStepEnrichers:   
        - enricher: Batiments.entities.Batiment.enrichers.DefautEtat
          executedOnButtonClick: false
          executedOnDataChange: false
          executedOnFormOpen: true

        - enricher: Batiments.entities.Batiment.enrichers.DefautDtLivraison
          executedOnButtonClick: false
          executedOnDataChange: true
          executedOnFormOpen: true


    - _type: FormStep
      _name: JuridiquePropriete
      label: Juridique et propriété 
      canFinishSubLevel: true
      enabledOnParentCreate: true
      enabledOnParentEdit: true
      formFieldsMode: AUTO
      enableMasterValuePicking: false
      formTab: Batiments.entities.Batiment.forms.BatimentEdition.FiscaliteJuridique

      formStepEnrichers:   
        - enricher: Batiments.entities.Batiment.enrichers.DefautRegimeTVA
          executedOnButtonClick: false
          executedOnDataChange: false
          executedOnFormOpen: true
        - enricher: Batiments.entities.Batiment.enrichers.DefautRegimeJuridique
          executedOnButtonClick: false
          executedOnDataChange: false
          executedOnFormOpen: true
          
      formStepValidations:  
        - executedOnDataChange: true
          executedOnFormOpen: true
          validationType: MANDATORY
          attribute:  Batiments.references.BatimentToRegimeJuridique.RegimeJuridique
        - executedOnDataChange: true
          executedOnFormOpen: true
          validationType: MANDATORY
          attribute:  Batiments.references.BatimentToFiscaliteCible.FiscaliteCible


stepperFinishValidations:


  - onStepperFinish: BLOCK
    validationType: MANDATORY
    attribute:  Batiments.references.BatimentToRegimeJuridique.RegimeJuridique
  - onStepperFinish: BLOCK
    validationType: MANDATORY
    attribute:  Batiments.references.BatimentToFiscaliteCible.FiscaliteCible

