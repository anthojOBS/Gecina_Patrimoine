_package: Batiments.entities.Batiment.steppers
_type: Stepper
_name: BatimentEdition
entity: Batiments.entities.Batiment.Batiment
label: Batiments
rootStep:
  _type: CollectionStep
  _name: Batiments
  label: Batiments
  canFinishSubLevel: true
  enabledOnParentCreate: true
  enabledOnParentEdit: true
  formFieldsMode: AUTO
  linear: false
  childDeleteType: HARD_DELETE
  collectionView: Batiments.entities.Batiment.collection_views.BatimentCollectionView
  defaultDisplayType: TABLE
  customSortEnabled: false
  userDefinedSortEnabled: true
  displayGridAllowed: false
  displayListAllowed: true
  displayTableAllowed: true
  useCustomCollectionLabel: false
  childSteps:
    - _type: FormStep
      _name: Batiment
      label: Batiment
      canFinishSubLevel: true
      enabledOnParentCreate: true
      enabledOnParentEdit: true
      formFieldsMode: AUTO
      enableMasterValuePicking: false
      formTab: Batiments.entities.Batiment.forms.BatimentEdition.Batiment


      formStepValidations:  
        - executedOnDataChange: true
          executedOnFormOpen: true
          validationType: MANDATORY
          attribute: Batiments.references.BatimentToUsage.Usage


      stepTransitionValidations:
        - onStepExit: BLOCK
          validationType: MANDATORY
          attribute:  Batiments.references.BatimentToUsage.Usage


    - _type: FormStep
      _name: CycleDeVie
      label: Cycle de vie de l'immeuble
      canFinishSubLevel: true
      enabledOnParentCreate: true
      enabledOnParentEdit: true
      formFieldsMode: AUTO
      enableMasterValuePicking: false
      formTab: Batiments.entities.Batiment.forms.BatimentEdition.CycleVieBatiment

    - _type: FormStep
      _name: FiscaliteJuridique
      label: Fiscalité et Juridique
      canFinishSubLevel: true
      enabledOnParentCreate: true
      enabledOnParentEdit: true
      formFieldsMode: AUTO
      enableMasterValuePicking: false
      formTab: Batiments.entities.Batiment.forms.BatimentEdition.FiscaliteJuridique

      formStepValidations:  
        - executedOnDataChange: true
          executedOnFormOpen: true
          validationType: MANDATORY
          attribute:  Batiments.references.BatimentToRegimeJuridique.RegimeJuridique
        - executedOnDataChange: true
          executedOnFormOpen: true
          validationType: MANDATORY
          attribute:  Batiments.references.BatimentToFiscaliteCible.FiscaliteCible


stepperFinishValidations:

  - onStepperFinish: BLOCK
    validationType: MANDATORY
    attribute:  Batiments.references.BatimentToUsage.Usage
  - onStepperFinish: BLOCK
    validationType: MANDATORY
    attribute:  Batiments.references.BatimentToRegimeJuridique.RegimeJuridique
  - onStepperFinish: BLOCK
    validationType: MANDATORY
    attribute:  Batiments.references.BatimentToFiscaliteCible.FiscaliteCible