_package: Batiments.entities.Batiment.steppers
_type: Stepper
_name: BatimentCreation
entity: Batiments.entities.Batiment.Batiment
label: Batiments
rootStep:
  _type: CollectionStep
  _name: Batiments
  label: Batiments
  canFinishSubLevel: true
  enabledOnParentCreate: true
  enabledOnParentEdit: true
  formFieldsMode: AUTO
  linear: false
  childDeleteType: HARD_DELETE
  collectionView: Batiments.entities.Batiment.collection_views.BatimentCollectionView
  defaultDisplayType: TABLE
  customSortEnabled: false
  userDefinedSortEnabled: true
  displayGridAllowed: false
  displayListAllowed: true
  displayTableAllowed: true
  useCustomCollectionLabel: false
  childSteps:
    - _type: FormStep
      _name: Batiment
      label: Fiche bâtiment
      canFinishSubLevel: true
      enabledOnParentCreate: true
      enabledOnParentEdit: true
      formFieldsMode: AUTO
      enableMasterValuePicking: false
      formTab: Batiments.entities.Batiment.forms.BatimentCreation.Batiment

      # referenceFormFieldConfigs:
      #   - enableCreateReference: false
      #     enableUserSort: true
      #     referencePickerType: AUTO_COMPLETE
      #     fdnFormField: Batiments.entities.Batiment.forms.BatimentCreation.Batiment.SectionHaut.SectionHautGauche.IdentiteBatiment.FDN_Immeuble         
      #     referenceFilter: PublisherID = 'IHM' or PublisherID = 'KSIOP' 
      #     referencePickerCollectionView: Batiments.entities.Immeuble.collection_views.ImmeubleCollectionView
      #     # referencePickerSearchTypeConfigs: []


      formStepEnrichers:

        - enricher: Batiments.entities.Batiment.enrichers.PrerequisImmeuble
          executedOnButtonClick: false
          executedOnDataChange: true
          executedOnFormOpen: false
        - enricher: Batiments.entities.Batiment.enrichers.PluginImmeuble
          executedOnButtonClick: false
          executedOnDataChange: true
          executedOnFormOpen: false
        - enricher: Batiments.entities.Batiment.enrichers.StandardizeAddress
          executedOnButtonClick: false
          executedOnDataChange: true
          executedOnFormOpen: false
        - enricher: Batiments.entities.Batiment.enrichers.FormatPays
          executedOnButtonClick: false
          executedOnDataChange: true
          executedOnFormOpen: false  
        - enricher: Batiments.entities.Batiment.enrichers.ConcatAddress
          executedOnButtonClick: false
          executedOnDataChange: true
          executedOnFormOpen: false 


      formStepValidations:  
        - executedOnDataChange: true
          executedOnFormOpen: true
          validationType: MANDATORY
          attribute: Batiments.entities.Batiment.Batiment.IdentifiantsERP
        - executedOnDataChange: true
          executedOnFormOpen: true
          validationType: MANDATORY
          attribute: Batiments.entities.Batiment.Batiment.Libelle_Batiment
        - executedOnDataChange: true
          executedOnFormOpen: true
          validationType: MANDATORY
          attribute: Batiments.entities.Batiment.Batiment.Adresse
        - executedOnDataChange: true
          executedOnFormOpen: true
          validationType: MANDATORY
          attribute: Batiments.entities.Batiment.Batiment.CodePostal
        - executedOnDataChange: true
          executedOnFormOpen: true
          validationType: MANDATORY
          attribute: Batiments.entities.Batiment.Batiment.Ville          
        - executedOnDataChange: true
          executedOnFormOpen: true
          validationType: MANDATORY
          attribute: Batiments.references.BatimentToPays.Pays
        - validator: Batiments.entities.Batiment.validations.CheckCoherenceVille
          executedOnDataChange: true
          executedOnFormOpen: true
          validationType: CHECK
          attribute: Batiments.entities.Batiment.Batiment.Ville


      stepTransitionValidations:
        - onStepExit: BLOCK
          validationType: MANDATORY
          attribute: Batiments.entities.Batiment.Batiment.IdentifiantsERP
        - onStepExit: BLOCK
          validationType: MANDATORY
          attribute: Batiments.entities.Batiment.Batiment.Libelle_Batiment
        - onStepExit: BLOCK
          validationType: MANDATORY
          attribute: Batiments.entities.Batiment.Batiment.Adresse
        - onStepExit: BLOCK
          validationType: MANDATORY
          attribute: Batiments.entities.Batiment.Batiment.CodePostal
        - onStepExit: BLOCK
          validationType: MANDATORY
          attribute: Batiments.entities.Batiment.Batiment.Ville
        - onStepExit: BLOCK
          validationType: MANDATORY
          attribute:  Batiments.references.BatimentToPays.Pays
        - onStepExit: BLOCK
          validationType: CHECK
          validator: Batiments.entities.Batiment.validations.CheckCoherenceVille
        - onStepExit: WARN
          validationType: DETECT_DUPS
          matcher: Batiments.entities.Batiment.Batiment.Matcher

    - _type: FormStep
      _name: CycleDeVie
      label: Cycle de vie
      canFinishSubLevel: true
      enabledOnParentCreate: true
      enabledOnParentEdit: true
      formFieldsMode: AUTO
      enableMasterValuePicking: false
      formTab: Batiments.entities.Batiment.forms.BatimentCreation.CycleVieBatiment

      referenceFormFieldConfigs:
        - enableCreateReference: false
          enableUserSort: true
          referencePickerType: AUTO_COMPLETE
          fdnFormField: Batiments.entities.Batiment.forms.BatimentCreation.CycleVieBatiment.Global.Gauche.Etat.FDN_Etat          
          referenceFilter: Referenced.EtatCode <> 'VENDU'
          referencePickerCollectionView: Batiments.entities.Etat.collection_views.EtatCollectionView
          # referencePickerSearchTypeConfigs: []


      formStepEnrichers:   
        - enricher: Batiments.entities.Batiment.enrichers.DefautEtat
          executedOnButtonClick: false
          executedOnDataChange: false
          executedOnFormOpen: true

        - enricher: Batiments.entities.Batiment.enrichers.Formatage_Date
          executedOnButtonClick: false
          executedOnDataChange: true
          executedOnFormOpen: true

        - enricher: Batiments.entities.Batiment.enrichers.DefautDtDebUsage
          executedOnButtonClick: false
          executedOnDataChange: true
          executedOnFormOpen: true

        - enricher: Batiments.entities.Batiment.enrichers.DefautDtLivraison
          executedOnButtonClick: false
          executedOnDataChange: true
          executedOnFormOpen: true

      formStepValidations:  
        - executedOnDataChange: true
          executedOnFormOpen: true
          validationType: MANDATORY
          attribute:  Batiments.references.BatimentToEtat.Etat 


      stepTransitionValidations:
        - onStepExit: BLOCK
          validationType: MANDATORY
          attribute:  Batiments.references.BatimentToEtat.Etat 
        
    - _type: FormStep
      _name: JuridiquePropriete
      label: Juridique et propriété 
      canFinishSubLevel: true
      enabledOnParentCreate: true
      enabledOnParentEdit: true
      formFieldsMode: AUTO
      enableMasterValuePicking: false
      formTab: Batiments.entities.Batiment.forms.BatimentCreation.FiscaliteJuridique



      formStepValidations:  
        - executedOnDataChange: true
          executedOnFormOpen: true
          validationType: MANDATORY
          attribute:  Batiments.references.BatimentToRegimeJuridique.RegimeJuridique
        # - executedOnDataChange: true
        #   executedOnFormOpen: true
        #   validationType: MANDATORY
        #   attribute:  Batiments.references.BatimentToFiscaliteCible.FiscaliteCible

      stepTransitionValidations:
        - onStepExit: BLOCK
          validationType: MANDATORY
          attribute:  Batiments.references.BatimentToRegimeJuridique.RegimeJuridique

stepperFinishValidations:

  - onStepperFinish: WARN
    validationType: DETECT_DUPS

  - onStepperFinish: BLOCK
    validationType: MANDATORY
    attribute: Batiments.entities.Batiment.Batiment.Libelle_Batiment
  - onStepperFinish: BLOCK
    validationType: MANDATORY
    attribute: Batiments.entities.Batiment.Batiment.IdentifiantsERP

    
  - onStepperFinish: BLOCK
    validationType: MANDATORY
    attribute:  Batiments.references.BatimentToEtat.Etat

  - onStepperFinish: BLOCK
    validationType: MANDATORY
    attribute: Batiments.entities.Batiment.Batiment.Adresse
  - onStepperFinish: BLOCK
    validationType: MANDATORY
    attribute: Batiments.entities.Batiment.Batiment.CodePostal  
  - onStepperFinish: BLOCK
    validationType: MANDATORY
    attribute: Batiments.entities.Batiment.Batiment.Ville  
  - onStepperFinish: BLOCK
    validationType: MANDATORY
    attribute: Batiments.references.BatimentToPays.Pays    
  - onStepperFinish: BLOCK
    validationType: CHECK
    validator: Batiments.entities.Batiment.validations.CheckCoherenceVille

  - onStepperFinish: BLOCK
    validationType: MANDATORY
    attribute:  Batiments.references.BatimentToRegimeJuridique.RegimeJuridique
  # - onStepperFinish: BLOCK
  #   validationType: MANDATORY
  #   attribute:  Batiments.references.BatimentToFiscaliteCible.FiscaliteCible
