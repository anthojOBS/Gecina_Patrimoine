_package: Batiments.entities.Batiment.steppers
_type: Stepper
_name: BatimentImport
entity: Batiments.entities.Batiment.Batiment
label: Batiments
rootStep:
  _type: CollectionStep
  _name: Batiments
  label: Batiments
  canFinishSubLevel: true
  enabledOnParentCreate: true
  enabledOnParentEdit: true
  formFieldsMode: AUTO
  linear: false
  childDeleteType: HARD_DELETE
  collectionView: Batiments.entities.Batiment.collection_views.BatimentCollectionView
  defaultDisplayType: TABLE
  customSortEnabled: false
  userDefinedSortEnabled: true
  displayGridAllowed: false
  displayListAllowed: true
  displayTableAllowed: true
  useCustomCollectionLabel: false
  childSteps:
    - _type: FormStep
      _name: Batiment
      label: Batiment
      canFinishSubLevel: true
      enabledOnParentCreate: true
      enabledOnParentEdit: true
      formFieldsMode: AUTO
      enableMasterValuePicking: false
      formTab: Batiments.entities.Batiment.forms.BatimentEdition.Batiment

      formStepEnrichers:
        - enricher: Batiments.entities.Batiment.enrichers.StandardizeAddress
          executedOnButtonClick: false
          executedOnDataChange: true
          executedOnFormOpen: false
        - enricher: Batiments.entities.Batiment.enrichers.FormatPays
          executedOnButtonClick: false
          executedOnDataChange: true
          executedOnFormOpen: true  
        - enricher: Batiments.entities.Batiment.enrichers.ConcatAddress
          executedOnButtonClick: false
          executedOnDataChange: true
          executedOnFormOpen: false 