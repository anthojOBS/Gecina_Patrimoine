              - _type: BusinessViewTransition
                _name: SousLots
                label: Sous-lots
                displayFormTabAs: ICON_LABEL
                displayTransitionNodeAs: ICON_LABEL
                enableHierarchy: '1'
                enableHierarchyInterpreter: LITERAL
                expandHierarchyByDefault: true
                iconUrl: images://mdi/door-sliding-open.svg
                transitionPath: SousLot
                transitionType: FULLY_QUALIFIED
                # transitionVisible: Etage.Batiment.Immeuble.FID_OrgaResp = 'DR' 
                # transitionVisibleInterpreter: SEMQL
                transitionVisible: '0'
                transitionVisibleInterpreter: LITERAL


                visibleInFormTabCondition: Etage.Batiment.Immeuble.FID_OrgaResp = 'DR'
                useCustomLabel: true
                pluralLabel: Sous-lots
                businessViewEntity: 
                  _type: BusinessViewEntity
                  _name: SousLots
                  displayCard: Batiments.entities.SousLot.display_cards.SousLotDisplayCard
                  displayRecordCount: ALWAYS
                  enableUserDefinedSort: true
                  gridAllowed: false
                  listAllowed: true
                  outlineVisible: false
                  overrideDefaultSort: false
                  tableAllowed: true
                  entity: Batiments.entities.SousLot.SousLot
                  form: Batiments.entities.SousLot.forms.SousLotConsultation
                  collection: Batiments.entities.SousLot.collection_views.SousLotCollectionView
        
                  transitions:

                    - _name: GoldenHistoryRecords
                      _type: BusinessViewTransition
                      displayFormTabAs: ICON_LABEL
                      displayTransitionNodeAs: ICON_LABEL
                      enableHierarchy: '0'
                      enableHierarchyInterpreter: LITERAL
                      expandHierarchyByDefault: false
                      iconUrl: images://mdi/history.svg
                      label: History
                      pluralLabel: History
                      transitionPath: GoldenHistoryRecords
                      transitionType: FULLY_QUALIFIED
                      # transitionVisible: Lot.Etage.Batiment.Immeuble.FID_OrgaResp = 'DR' 
                      # transitionVisibleInterpreter: SEMQL
                      transitionVisible: '0'
                      transitionVisibleInterpreter: LITERAL
                      visibleInFormTabCondition: Lot.Etage.Batiment.Immeuble.FID_OrgaResp = 'DR' 
                      useCustomLabel: true
                      businessViewEntity: 
                        _type: BusinessViewEntity
                        _name: HistorySousLots
                        displayCard: Batiments.entities.SousLot.display_cards.SousLotDisplayCard
                        entity: Batiments.entities.SousLot.SousLot
                        actionSet: Batiments.entities.SousLot.action_sets.SousLotActionSet
                        collection: Batiments.entities.SousLot.collection_views.SousLotCollectionView_History
                        form: Batiments.entities.SousLot.forms.SousLotConsultation
                        displayRecordCount: ALWAYS
                        outlineVisible: false
                        enableUserDefinedSort: true
                        gridAllowed: true
                        listAllowed: true
                        overrideDefaultSort: false
                        tableAllowed: true
                        sortExpression: IdentifiantsERP ASC
                        
                    # - _type: BusinessViewTransition
                    #   _name: MasterRecordsLots
                    #   displayFormTabAs: ICON_LABEL
                    #   useCustomLabel: false
                    #   enableHierarchyInterpreter: LITERAL
                    #   filter: 1=1
                    #   iconUrl: images://mdi/puzzle.svg
                    #   label: Masters Records
