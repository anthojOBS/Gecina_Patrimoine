_package: Batiments.entities.Batiment.business_views
_type: BusinessView
_name: BatimentSuggestedMatchesBusinessView
entity: Batiments.entities.Batiment.Batiment
rootLabel: Batiments Suggestions
rootPluralLabel: Batiments Suggestions
displayRootNodeAs: ICON_LABEL
label: Bâtiments Suggested Matches
rootFilter: HasSuggestedMerge = '1'

rootBusinessViewEntity:
  _type: BusinessViewEntity
  _name: BatimentSugg
  displayCard: Batiments.entities.Batiment.display_cards.BatimentDisplayCard
  entity: Batiments.entities.Batiment.Batiment
  actionSet: Batiments.entities.Batiment.action_sets.BatimentActionSet
  collection: Batiments.entities.Batiment.collection_views.BatimentCollectionView
  form: Batiments.entities.Batiment.forms.BatimentConsultation
  outlineVisible: false
  displayRecordCount: ALWAYS
  businessEntitySearchConfigs:
    - _name: TextConfig
      _type: BusinessEntitySearchTypeConfig
      searchType: TEXT
    - _name: FormConfig
      _type: BusinessEntitySearchTypeConfig
      searchType: BY_FORM
    - _name: AdvancedConfig
      _type: BusinessEntitySearchTypeConfig
      searchType: ADVANCED
    - _name: SemqlConfig
      _type: BusinessEntitySearchTypeConfig
      searchType: SEMQL
  overrideDefaultSort: false
  enableUserDefinedSort: true
  listAllowed: true
  tableAllowed: true
  gridAllowed: true

  transitions:
    - _name: GoldenHistoryRecords
      _type: BusinessViewTransition
      displayFormTabAs: ICON_LABEL
      displayTransitionNodeAs: ICON_LABEL
      enableHierarchy: '0'
      enableHierarchyInterpreter: LITERAL
      expandHierarchyByDefault: false
      iconUrl: images://mdi/history.svg
      label: History
      pluralLabel: History
      transitionPath: GoldenHistoryRecords
      transitionType: FULLY_QUALIFIED
      transitionVisible: '1'
      transitionVisibleInterpreter: LITERAL
      useCustomLabel: true
      businessViewEntity: 
        _type: BusinessViewEntityReference
        ref: Batiments.entities.Batiment.business_views.BatimentSuggestedMatchesBusinessView.BatimentSugg
      filter: 1 = 1
    - _type: BusinessViewTransition
      _name: MasterRecords
      displayFormTabAs: ICON_LABEL
      useCustomLabel: false
      enableHierarchyInterpreter: LITERAL
      filter: 1=1
      iconUrl: images://mdi/puzzle.svg
      label: Masters Records
      pluralLabel: Masters Records
      transitionType: FULLY_QUALIFIED
      transitionPath:  MasterRecords 
      businessViewEntity: 
        _type: BusinessViewEntity
        _name: MasterRecord
        displayCard: Batiments.entities.Batiment.display_cards.BatimentDisplayCard
        entity: Batiments.entities.Batiment.Batiment
        actionSet: Batiments.entities.Batiment.action_sets.BatimentActionSet
        collection: Batiments.entities.Batiment.collection_views.BatimentCollectionView
        form: Batiments.entities.Batiment.forms.BatimentConsultation
        displayRecordCount: ALWAYS
        outlineVisible: false
        enableUserDefinedSort: true
        gridAllowed: true
        listAllowed: true
        overrideDefaultSort: false
        tableAllowed: true
enableHierarchyView: false
useHierarchyOnOpen: false
