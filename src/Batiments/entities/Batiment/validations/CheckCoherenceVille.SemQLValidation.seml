_package: Batiments.entities.Batiment.validations
_name: CheckCoherenceVille
_type: SemQLValidation
entity: Batiments.entities.Batiment.Batiment
label: Coherence ville
condition: (Upper(Immeuble.VilleEnrichie) = Upper(VilleEnrichie) and VilleEnrichie is not null) or VilleEnrichie is null
validationScope: POST_CONSO
validationLabel: La ville est différente de celle de immeuble

