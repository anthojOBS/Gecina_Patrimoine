_package: Batiments.entities.Batiment.action_sets
_type: ActionSet
_name: BatimentActionSet
entity: Batiments.entities.Batiment.Batiment
label: Batiment Action Set
defaultActionSet: true
actions:
  - _type: CreateAction
    _name: CreateAuthorBatiments
    label: Création bâtiment
    useCustomLabel: true
    stepper: Batiments.entities.Batiment.steppers.BatimentCreation
    createMultiple: false
    createdRecordType: GOLDEN
    waitDialogEnabled: false
    allowOtherPublishers: true
  - _type: EditAction
    _name: EditAuthorBatiments
    label: Modification bâtiment
    useCustomLabel: true
    stepper: Batiments.entities.Batiment.steppers.BatimentEdition
    multipleSelectionAllowed: true
    availableForGoldenData: true
    availableForMasterData: true
    availableForErrorData: true
    waitDialogEnabled: false
  - _type: MassUpdateAction
    _name: MassUpdateAuthorBatiments
    label: Mise à jour de masse
    useCustomLabel: true
    stepper: Batiments.entities.Batiment.steppers.BatimentEdition
    availableForGoldenData: true
    availableForErrorData: true
    availableForMasterData: true
    waitDialogEnabled: false
  - _type: DeleteAction
    _name: Delete
    label: Supprimer
    useCustomLabel: true
    multipleSelectionAllowed: true
    deleteType: HARD_DELETE
    waitDialogEnabled: false
    availableForGoldenData: true
    availableForMasterData: true
  - _type: ExportAction
    _name: Export
    label: Exporter
    useCustomLabel: true
    waitDialogEnabled: false
  - _type: ImportAction
    _name: ImportAuthorBatiments
    label: Importer
    useCustomLabel: true
    importMode: CREATE_AND_UPDATE
    stepper: Batiments.entities.Batiment.steppers.BatimentEdition
    importedRecordType: MASTER
    defaultPublisher: Batiments.publishers.VisionReelle
    waitDialogEnabled: false
    allowOtherPublishers: true
  - _type: BrowseGraphAction
    _name: BrowseGraph
    label: Recherche graphique
    useCustomLabel: true
    waitDialogEnabled: false
  - _type: DirectConfirmDupsAction
    _name: DirectConfirmDuplicates
    label: Confirmer doublons directement
    useCustomLabel: false
    waitDialogEnabled: false
  - _type: ReviewAndConfirm
    _name: ReviewAndConfirmDuplicatesManageDuplicatesOnBatiment
    label: Revue and Validation doublons
    useCustomLabel: true
    dupsManager: Batiments.entities.Batiment.dups_managers.ManageDuplicatesOnBatiment
    enableEdit: true
    mandateConfirmAll: false
    waitDialogEnabled: false
  - _type: MergeOrSplit
    _name: MergeOrSplitDuplicatesManageDuplicatesOnBatiment
    label: Fusion et défusion
    useCustomLabel: true
    dupsManager: Batiments.entities.Batiment.dups_managers.ManageDuplicatesOnBatiment
    enableEdit: true
    waitDialogEnabled: false
  - _type: ReviewSuggestions
    _name: ReviewSuggestionsDuplicatesManageDuplicatesOnBatiment
    label: Suggestions de doublons
    useCustomLabel: true
    dupsManager: Batiments.entities.Batiment.dups_managers.ManageDuplicatesOnBatiment
    enableEdit: true
    waitDialogEnabled: false
    onAcceptPromptGoldenId: false
    mandateResolveAllSuggestions: false
  - _type: ExplainRecordAction
    _name: ExplainRecord
    label: Expliquer l'enregistrement
    useCustomLabel: true
    displayCard: Batiments.entities.Batiment.display_cards.BatimentDisplayCard
    formTab: Batiments.entities.Batiment.forms.BatimentConsultation.Batiment
    waitDialogEnabled: false
