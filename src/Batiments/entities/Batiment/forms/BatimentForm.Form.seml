_package: Batiments.entities.Batiment.forms
_type: Form
_name: BatimentForm
entity: Batiments.entities.Batiment.Batiment
default: true
formTabs:
  - _type: FormTab
    _name: Batiment
    label: Fiche bâtiment
    documentationInterpreter: LITERAL
    visibleValue: "1"
    visibleValueInterpreter: LITERAL
    displayFormTabAs: ICON_LABEL
    content:
      # SECTION HAUT (FormContainer)
      - _type: FormContainer
        _name: SectionHaut
        layoutDirection: COLUMN
        content:
              # Identité bâtiment
              - _type: FormSection
                _name: IdentiteBatiment
                label: Identité bâtiment
                layoutDirection: COLUMN
                visibleValue: '1'
                visibleValueInterpreter: LITERAL
                labelWidth: 200px
                content:
                  - _type: TextField
                    _name: IdentifiantsERP
                    value: IdentifiantsERP
                    label: Numéro bâtiment
                    labelProperties:
                      alignment: left
                      typographyValueInterpreter: LITERAL
                      typography: body-2
                      color: md:black
                    useCustomLabel: true
                    dataType: STRING
                  - _type: TextField
                    _name: Libelle_Batiment
                    value: Libelle_Batiment
                    label: Libellé bâtiment
                    labelProperties:
                      alignment: left
                      typographyValueInterpreter: LITERAL
                      typography: body-2
                      color: md:black
                    useCustomLabel: true
                    dataType: STRING

                  - _type: CheckboxField
                    _name: BatimentPrincipal
                    value: BatimentPrincipal
                    label: Statut bâtiment principal
                    labelProperties:
                      alignment: left
                      typographyValueInterpreter: LITERAL
                      typography: body-2
                      color: md:black
                    useCustomLabel: true
                    dataType: BOOLEAN

                  - _type: ReferenceField
                    _name: FDN_Immeuble
                    value: FDN_Immeuble
                    label: Immeuble parent
                    labelProperties:
                      alignment: left
                      typographyValueInterpreter: LITERAL
                      typography: body-2
                      color: md:black
                    useCustomLabel: true
                    dataType: STRING
                    referencedEntity: Batiments.entities.Immeuble.Immeuble
                    
                  - _type: TextField
                    _name: SuperficieUtile
                    # value: SuperficieUtile
                    value: case when SuperficieUtile is not null then SuperficieUtile || ' m²' else null end
                    label: Superficie totale avec QP
                    documentation: Addition de toutes les surfaces utiles avec QP
                     Surface totale du bâtiment exprimée en m²
                 
                    labelProperties:
                      alignment: left
                      typographyValueInterpreter: LITERAL
                      typography: body-2
                      color: md:black
                    useCustomLabel: true
                    dataType: STRING



              # Localisation immeuble
              - _type: FormSection
                _name: LocalisationImmeuble
                label: Localisation 
                layoutDirection: COLUMN
                visibleValue: '1'
                visibleValueInterpreter: LITERAL
                labelWidth: 200px
                content:
                  # Bloc Adresse/Ville
                      - _type: TextField
                        _name: Adresse
                        value: Adresse
                        label: Adresse
                        labelProperties:
                          alignment: left
                          typographyValueInterpreter: LITERAL
                          typography: body-2
                          color: md:black
                        useCustomLabel: true
                        dataType: STRING

                      - _type: TextField
                        _name: CodePostal
                        value: CodePostal
                        label: Code postal
                        labelProperties:
                          alignment: left
                          typographyValueInterpreter: LITERAL
                          typography: body-2
                          color: md:black
                        useCustomLabel: true
                        dataType: STRING

                      - _type: TextField
                        _name: Ville
                        value: Ville
                        label: Ville
                        labelProperties:
                          alignment: left
                          typography: body-2
                          color: md:black
                        useCustomLabel: true
                        dataType: STRING

                      - _type: ReferenceField
                        _name: FDN_Pays
                        value: FDN_Pays
                        label: Pays
                        labelProperties:
                          alignment: left
                          typography: body-2
                          color: md:black    
                        useCustomLabel: true
                        dataType: STRING
                        referencedEntity: Batiments.entities.Pays.Pays



          # Usage
              - _type: FormSection
                _name: Usage
                label: Usage
                layoutDirection: COLUMN
                visibleValue: '1'
                visibleValueInterpreter: LITERAL
                labelWidth: 200px
                content:
                    - _type: ReferenceField
                      _name: FDN_Usage
                      value: FDN_Usage
                      label: Usage
                      labelProperties:
                        alignment: left
                        typographyValueInterpreter: LITERAL
                        typography: body-2
                        color: md:black
                      useCustomLabel: true
                      dataType: STRING
                      referencedEntity: Batiments.entities.Usage.Usage


          # Usage
              - _type: FormSection
                _name: Caracteristiques
                label: Caractéristiques générales
                layoutDirection: COLUMN
                visibleValue: '1'
                visibleValueInterpreter: LITERAL
                labelWidth: 200px
                content:
                  - _type: CheckboxField
                    _name: FlagAscenseur
                    value: FlagAscenseur
                    label: Statut ascenseur
                    labelProperties:
                      alignment: left
                      typographyValueInterpreter: LITERAL
                      typography: body-2
                      color: md:black
                    useCustomLabel: true
                    dataType: BOOLEAN

          # Gestion interne
              - _type: FormSection
                _name: GestionInterne
                label: Gestion interne
                layoutDirection: COLUMN
                visibleValue: '1'
                visibleValueInterpreter: LITERAL
                labelWidth: 200px
                content:
                  - _type: TextField
                    _name: FDN_OrgaResp
                    value: Immeuble.FDN_OrgaResp
                    label: Organisation responsable
                    labelProperties:
                      alignment: left
                      typographyValueInterpreter: LITERAL
                      typography: body-2
                      color: md:black
                    useCustomLabel: true
                    dataType: STRING

                  - _type: TextField
                    _name: FDN_Portefeuille
                    value: Immeuble.FDN_Portefeuille
                    label: Portefeuille
                    labelProperties:
                      alignment: left
                      typographyValueInterpreter: LITERAL
                      typography: body-2
                      color: md:black
                    useCustomLabel: true
                    dataType: STRING

                  - _type: TextField
                    _name: SousPortefeuille
                    value: Immeuble.SousPortefeuille
                    label: Sous-portefeuille
                    labelProperties:
                      alignment: left
                      typographyValueInterpreter: LITERAL
                      typography: body-2
                      color: md:black
                    useCustomLabel: true
                    dataType: STRING

  - _type: FormTab
    _name: CycleVieBatiment
    label: Cycle de vie
    iconUrl: images://mdi/sync-circle.svg
    documentationInterpreter: LITERAL
    visibleValue: "1"
    visibleValueInterpreter: LITERAL
    displayFormTabAs: ICON_LABEL
    content:
      - _type: FormSection
        _name: Phase
        label: Phase
        layoutDirection: COLUMN
        visibleValue: '1'
        visibleValueInterpreter: LITERAL
        labelWidth: 200px
        content:
          - _type: ReferenceField
            _name: FDN_Phase
            value: Immeuble.FDN_Phase
            label: Phase
            labelProperties:
              alignment: left
              typographyValueInterpreter: LITERAL
              typography: body-2
              color: md:black
            useCustomLabel: true
            dataType: STRING
            referencedEntity: Batiments.entities.Phase.Phase

          - _type: TextField
            _name: DateDebPhase
            value: Immeuble.DateDebPhase
            label: Date début phase
            labelProperties:
              alignment: left
              typographyValueInterpreter: LITERAL
              typography: body-2
              color: md:black
            useCustomLabel: true
            dataType: DATE

      - _type: FormSection
        _name: AcquisitionCession
        label: Acquisition/Cession
        layoutDirection: COLUMN
        visibleValue: "1"
        visibleValueInterpreter: LITERAL
        labelWidth: 200px
        content:

              - _type: TextField
                _name: DateAcquisition
                value: Immeuble.DateAcquisition
                label: Date acquisition
                labelProperties:
                  alignment: left
                  typographyValueInterpreter: LITERAL
                  typography: body-2
                  color: md:black
                useCustomLabel: true
                dataType: DATE
              - _type: TextField
                _name: DateVente
                value: Immeuble.DateVente
                label: Date vente
                labelProperties:
                  alignment: left
                  typographyValueInterpreter: LITERAL
                  typography: body-2
                  color: md:black
                useCustomLabel: true
                dataType: DATE

      - _type: FormSection
        _name: Construction
        label: Construction
        layoutDirection: COLUMN
        visibleValue: '1'
        visibleValueInterpreter: LITERAL
        labelWidth: 200px
        content:
              - _type: ReferenceField
                _name: FDN_PeriodeConstruction
                value: Immeuble.FDN_PeriodeConstruction
                label: Période de construction
                labelProperties:
                  alignment: left
                  typography: body-2
                  color: md:black
                useCustomLabel: true
                dataType: STRING
                referencedEntity: Batiments.entities.PeriodeConstruction.PeriodeConstruction
              - _type: TextField
                _name: DateDebutConstruction
                value: Immeuble.DateDebutConstruction
                label: Date début construction
                labelProperties:
                  alignment: left
                  typographyValueInterpreter: LITERAL
                  typography: body-2
                  color: md:black
                useCustomLabel: true
                dataType: DATE
              - _type: TextField
                _name: DateFinConstruction
                value: Immeuble.DateFinConstruction
                label: Date fin construction
                labelProperties:
                  alignment: left
                  typographyValueInterpreter: LITERAL
                  typography: body-2
                  color: md:black
                useCustomLabel: true
                dataType: DATE
              - _type: TextField
                _name: DateLivraison
                value: Immeuble.DateLivraison
                label: Date livraison
                labelProperties:
                  alignment: left
                  typographyValueInterpreter: LITERAL
                  typography: body-2
                  color: md:black
                useCustomLabel: true
                dataType: DATE


  

  - _type: FormTab
    _name: FiscaliteJuridique
    label: Juridique et propriété
    iconUrl: images://mdi/bank.svg
    documentationInterpreter: LITERAL
    visibleValue: "1"
    visibleValueInterpreter: LITERAL
    displayFormTabAs: ICON_LABEL
    content:
      - _type: FormSection
        _name: Juridique
        label: Juridique
        layoutDirection: COLUMN
        visibleValue: "1"
        visibleValueInterpreter: LITERAL
        # labelWidth: 200px
        content:
          - _type: TextField
            _name: FDN_FiscaliteCible
            value: Immeuble.FDN_FiscaliteCible
            label: Régime TVA
            labelProperties:
              alignment: left
              typographyValueInterpreter: LITERAL
              typography: body-2
              color: md:black
            useCustomLabel: true
            dataType: STRING
          - _type: TextField
            _name: Juridique
            value: Immeuble.FDN_RegimeJuridique
            label: Régime juridique
            labelProperties:
              alignment: left
              typographyValueInterpreter: LITERAL
              typography: body-2
              color: md:black
            useCustomLabel: true
            dataType: STRING
            referencedEntity: Batiments.entities.RegimeJuridique.RegimeJuridique
      - _type: FormSection
        _name: SocietesProprietaires
        label: Société propriétaire
        layoutDirection: COLUMN
        visibleValue: "1"
        visibleValueInterpreter: LITERAL
        # labelWidth: 200px
        content:
          - _type: FormCollection
            _name: SocietesProprietaires
            label: Société propriétaire
            useCustomLabel: true
            collection: Batiments.entities.RelBatSoc.collection_views.Societe
            tableAllowed: true
            listAllowed: false
            gridAllowed: false
            displayRecordCount: ALWAYS
            enableUserDefinedSort: true
            transitionPath: RelBatSoc
            sortExpression: 1 DESC
            filter:  1=1
            targetEntity: Batiments.entities.RelBatSoc.RelBatSoc

      - _type: FormSection
        _name: SocietesExploitantes
        label: Société exploitante
        layoutDirection: COLUMN
        visibleValue: "1"
        visibleValueInterpreter: LITERAL
        labelWidth: 200px
        content:
          - _type: FormCollection
            _name: SocietesExploitante
            label: Société exploitante
            useCustomLabel: true
            collection: Batiments.entities.RelBatSoc.collection_views.Societe
            tableAllowed: true
            listAllowed: false
            gridAllowed: false
            displayRecordCount: ALWAYS
            enableUserDefinedSort: true
            transitionPath: RelBatSoc
            sortExpression: 1 DESC
            filter: 1=1
            targetEntity: Batiments.entities.RelBatSoc.RelBatSoc
