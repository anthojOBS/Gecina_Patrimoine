_package: Batiments.entities.Batiment.enrichers
_name: ConcatAddress
_type: SemQLEnricher
entity: Batiments.entities.Batiment.Batiment
label: Concat Address
enricherExecutionScope: PRE_CONSO
afterEnrichers: Batiments.entities.Batiment.enrichers.StandardizeAddress
semQlEnricherExpressions: 
  - attributeName: AdresseStandardise
    expression: substr(AdresseEnrichie, 1, sem_instr(AdresseEnrichie,',')-1)
condition: Adresse is not null or CodePostal is not null or Ville is not null