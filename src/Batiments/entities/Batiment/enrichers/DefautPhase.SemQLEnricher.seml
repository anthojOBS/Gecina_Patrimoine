_package: Batiments.entities.Batiment.enrichers
_name: DefautPhase
_type: SemQLEnricher
entity: Batiments.entities.Batiment.Batiment
label: Default Phase
enricherExecutionScope: NONE
semQlEnricherExpressions: 
  - attributeName: FID_Phase
    expression: case when FID_Phase is NULL then 'ACTIF' else FID_Phase end
condition: FID_Phase is NULL 