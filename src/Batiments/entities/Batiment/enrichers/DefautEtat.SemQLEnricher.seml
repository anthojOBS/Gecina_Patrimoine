_package: Batiments.entities.Batiment.enrichers
_name: DefautEtat
_type: SemQLEnricher
entity: Batiments.entities.Batiment.Batiment
label: Default Etat
enricherExecutionScope: POST_CONSO
semQlEnricherExpressions: 
  - attributeName: FID_Etat
    expression: case when FID_Etat is NULL then 'EXP' else FID_Etat end
condition: FID_Etat is NULL 