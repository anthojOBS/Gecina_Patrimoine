_package: Batiments.entities.Batiment.enrichers
_name: FormatPays
_type: SemQLEnricher
entity: Batiments.entities.Batiment.Batiment
label: Mise en qualité du pays
enricherExecutionScope: PRE_CONSO
afterEnrichers: Batiments.entities.Batiment.enrichers.StandardizeAddress
semQlEnricherExpressions: 
  - attributeName: FID_Pays
    expression: case when  any Pays.Batiment have (Pays.iso3 = Upper(substr(PaysEnrichie, 1, 3))) then UPPER(substr(PaysEnrichie, 1, 3)) else 'FRA' end
condition: Adresse is not null and CodePostal is not null and Ville is not null


 
         