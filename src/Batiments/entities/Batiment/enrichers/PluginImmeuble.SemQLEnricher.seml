_package: Batiments.entities.Batiment.enrichers
_name: PluginImmeuble
_type: JavaPluginEnricher
entity: Batiments.entities.Batiment.Batiment
label: Alimentation attibut depuis Immeuble
afterEnrichers: Batiments.entities.Batiment.enrichers.PrerequisImmeuble
enricherExecutionScope: PRE_CONSO

numberOfRetry: 1
onErrorBehavior: FAIL_JOB

pluginId: com.semarchy.engine.plugins.convergence.lookup
pluginParams:
  - paramName: PARAM_CACHE
    value: NO_CACHE

  - paramName: PARAM_CUSTOM_SQL
    value: |  
      SELECT DISTINCT M.IDENTIFIANTS_ERP LOOKUP_COLUMN, I.ADRESSE OUTPUT_COLUMN1 , 
      I.CODE_POSTAL OUTPUT_COLUMN2, I.VILLE OUTPUT_COLUMN3, I.F_PAYS_ID_ISO3 OUTPUT_COLUMN4, I.ADRESSE_STANDARDISEE OUTPUT_COLUMN5,
      I.CODE_POSTAL_ENRICHI OUTPUT_COLUMN6, I.VILLE_ENRICHIE OUTPUT_COLUMN7, I.PAYS_ENRICHIE OUTPUT_COLUMN8,
      I.F_FISCALITE_CIBLE_ID OUTPUT_COLUMN9, I.F_REGIME_JURIDIQUE_ID OUTPUT_COLUMN10, I.F_PERIODECONSTRUCTION_ID OUTPUT_COLUMN11,
      I.DATE_ACQUISITION OUTPUT_COLUMN12, I.DATE_LIVRAISON OUTPUT_COLUMN13
      FROM GD_IMMEUBLE I , MD_IMMEUBLE M 
      WHERE I.IMMEUBLE_ID=M.IMMEUBLE_ID

  - paramName: PARAM_FALLBACK_BEHAVIOR
    value: USE_FALLBACK

  # - paramName: PARAM_FALLBACK
  #   value: IN_LOOKUP_VALUE

  # - paramName: PARAM_LOOKUP_COLUMN
  #   value: IDENTIFIANTS_ERP

  # - paramName: PARAM_MAPPING_TABLE
  #   value: GD_IMMEUBLE

  # - paramName: PARAM_OUTPUT_COLUMNS
  #   value: IMMEUBLE_ID



pluginInputs:
  - inputName: IN_LOOKUP_VALUE
    expression: IdentifiantsERP_immeuble
    

pluginOutputs: 
  - outputName: OUT_RESULT1
    attributeName: Adresse
  - outputName: OUT_RESULT2
    attributeName: CodePostal
  - outputName: OUT_RESULT3
    attributeName: Ville
  - outputName: OUT_RESULT4
    attributeName: FID_Pays
  - outputName: OUT_RESULT5
    attributeName: AdresseStandardise
  - outputName: OUT_RESULT6
    attributeName: CodePostalEnrichi
  - outputName: OUT_RESULT7
    attributeName: VilleEnrichie
  - outputName: OUT_RESULT8
    attributeName: PaysEnrichie
  - outputName: OUT_RESULT9
    attributeName: FID_FiscaliteCible
  - outputName: OUT_RESULT10
    attributeName: FID_RegimeJuridique
  - outputName: OUT_RESULT11
    attributeName: FID_PeriodeConstruction
  - outputName: OUT_RESULT12
    attributeName:  DateAcquisition_Immeuble
  - outputName: OUT_RESULT13
    attributeName:  DateLivraison_Immeuble



processingBatchSize: 1000
threadPoolSize: 1