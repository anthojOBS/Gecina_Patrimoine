_package: Batiments.entities.SousLot.steppers
_type: Stepper
_name: SousLotsCreation
entity: Batiments.entities.SousLot.SousLot
label: Sous-lot
rootStep:
  _type: CollectionStep
  _name: SousLots
  label: Sous-lot
  canFinishSubLevel: true
  enabledOnParentCreate: true
  enabledOnParentEdit: true
  formFieldsMode: AUTO
  linear: false
  childDeleteType: HARD_DELETE
  collectionView: Batiments.entities.SousLot.collection_views.SousLotCollectionView
  defaultDisplayType: TABLE
  customSortEnabled: false
  userDefinedSortEnabled: true
  displayGridAllowed: false
  displayListAllowed: true
  displayTableAllowed: true
  useCustomCollectionLabel: false
  childSteps:
    - _type: FormStep
      _name: Lot
      label: Sous-lot
      canFinishSubLevel: true
      enabledOnParentCreate: true
      enabledOnParentEdit: true
      formFieldsMode: AUTO
      enableMasterValuePicking: false
      formTab: Batiments.entities.SousLot.forms.SousLotCreation.SousLot

      formStepEnrichers:   
        - enricher: Batiments.entities.SousLot.enrichers.DefautDtDebStatut
          executedOnButtonClick: false
          executedOnDataChange: false
          executedOnFormOpen: true
 
        - enricher: Batiments.entities.SousLot.enrichers.DefautLouable
          executedOnButtonClick: false
          executedOnDataChange: false
          executedOnFormOpen: true

      formStepValidations:  
        - executedOnDataChange: true
          executedOnFormOpen: true
          validationType: MANDATORY
          attribute: Batiments.entities.SousLot.SousLot.Libelle
        - executedOnDataChange: true
          executedOnFormOpen: true
          validationType: MANDATORY
          attribute: Batiments.entities.SousLot.SousLot.IdentifiantsERP
        - executedOnDataChange: true
          executedOnFormOpen: true
          validationType: MANDATORY
          attribute: Batiments.entities.SousLot.SousLot.DateDebStatut

        - validator: Batiments.entities.SousLot.validations.CheckRaisonNonLouable
          executedOnDataChange: true
          executedOnFormOpen: true
          validationType: CHECK
          attribute: Batiments.references.SousLotToRaison.RaisonNonLouable




      stepTransitionValidations:
        - onStepExit: BLOCK
          validationType: MANDATORY
          attribute: Batiments.entities.SousLot.SousLot.Libelle
        - onStepExit: BLOCK
          validationType: MANDATORY
          attribute: Batiments.entities.SousLot.SousLot.IdentifiantsERP
        - onStepExit: BLOCK
          validationType: MANDATORY
          attribute: Batiments.entities.SousLot.SousLot.DateDebStatut

        - onStepExit: BLOCK
          validationType: CHECK
          validator: Batiments.entities.SousLot.validations.CheckRaisonNonLouable


    - _type: FormStep
      _name: Composition
      label: Composition
      canFinishSubLevel: true
      enabledOnParentCreate: true
      enabledOnParentEdit: true
      formFieldsMode: AUTO
      enableMasterValuePicking: false
      formTab: Batiments.entities.SousLot.forms.SousLotCreation.Composition

      formStepValidations:  
        - executedOnDataChange: true
          executedOnFormOpen: true
          validationType: MANDATORY
          attribute: Batiments.entities.SousLot.SousLot.SuperficieHabitable
        - executedOnDataChange: true
          executedOnFormOpen: true
          validationType: MANDATORY
          attribute: Batiments.entities.SousLot.SousLot.SuperficieUtileQP


      stepTransitionValidations:
        - onStepExit: BLOCK
          validationType: MANDATORY
          attribute: Batiments.entities.SousLot.SousLot.SuperficieHabitable
        - onStepExit: BLOCK
          validationType: MANDATORY
          attribute: Batiments.entities.SousLot.SousLot.SuperficieUtileQP

    - _type: FormStep
      _name: CycleDeVie
      label: Cycle de vie
      canFinishSubLevel: true
      enabledOnParentCreate: true
      enabledOnParentEdit: true
      formFieldsMode: AUTO
      enableMasterValuePicking: false
      formTab: Batiments.entities.SousLot.forms.SousLotCreation.CycleVie

      formStepEnrichers:   
        - enricher: Batiments.entities.SousLot.enrichers.DefautPhase
          executedOnButtonClick: false
          executedOnDataChange: false
          executedOnFormOpen: true
        - enricher: Batiments.entities.SousLot.enrichers.DefautDtDebPhase
          executedOnButtonClick: false
          executedOnDataChange: false
          executedOnFormOpen: true

      formStepValidations:  
        - executedOnDataChange: true
          executedOnFormOpen: true
          validationType: MANDATORY
          attribute:  Batiments.references.SousLotToPhase.Phase
        - executedOnDataChange: true
          executedOnFormOpen: true
          validationType: MANDATORY
          attribute: Batiments.entities.SousLot.SousLot.DateDebPhase

      stepTransitionValidations:
        - onStepExit: BLOCK
          validationType: MANDATORY
          attribute:  Batiments.references.SousLotToPhase.Phase
        - onStepExit: BLOCK
          validationType: MANDATORY
          attribute: Batiments.entities.SousLot.SousLot.DateDebPhase

    # - _type: FormStep
    #   _name: FiscaliteJuridique
    #   label: Fiscalité et Juridique
    #   canFinishSubLevel: true
    #   enabledOnParentCreate: true
    #   enabledOnParentEdit: true
    #   formFieldsMode: AUTO
    #   enableMasterValuePicking: false
    #   formTab: Batiments.entities.SousLot.forms.SousLotCreation.JuridiquePropriete



stepperFinishValidations:
  - onStepperFinish: WARN
    validationType: DETECT_DUPS

  - onStepperFinish: BLOCK
    validationType: MANDATORY
    attribute: Batiments.entities.SousLot.SousLot.Libelle
  - onStepperFinish: BLOCK
    validationType: MANDATORY
    attribute: Batiments.entities.SousLot.SousLot.IdentifiantsERP
  - onStepperFinish: BLOCK
    validationType: MANDATORY
    attribute: Batiments.entities.SousLot.SousLot.DateDebStatut
  - onStepperFinish: BLOCK
    validationType: MANDATORY
    attribute: Batiments.entities.SousLot.SousLot.SuperficieHabitable
  - onStepperFinish: BLOCK
    validationType: MANDATORY
    attribute: Batiments.entities.SousLot.SousLot.SuperficieUtileQP
  - onStepperFinish: BLOCK
    validationType: MANDATORY
    attribute:  Batiments.references.SousLotToPhase.Phase
  - onStepperFinish: BLOCK
    validationType: MANDATORY
    attribute: Batiments.entities.SousLot.SousLot.DateDebPhase
  - onStepperFinish: BLOCK
    validationType: CHECK
    validator: Batiments.entities.SousLot.validations.CheckRaisonNonLouable
