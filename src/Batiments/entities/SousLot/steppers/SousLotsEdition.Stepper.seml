_package: Batiments.entities.SousLot.steppers
_type: Stepper
_name: SousLotsEdition
entity: Batiments.entities.SousLot.SousLot
label: Sous-lot
rootStep:
  _type: CollectionStep
  _name: Lots
  label: Fiche Sous-lot
  canFinishSubLevel: true
  enabledOnParentCreate: true
  enabledOnParentEdit: true
  formFieldsMode: AUTO
  linear: false
  childDeleteType: HARD_DELETE
  collectionView: Batiments.entities.SousLot.collection_views.SousLotCollectionView
  defaultDisplayType: TABLE
  customSortEnabled: false
  userDefinedSortEnabled: true
  displayGridAllowed: false
  displayListAllowed: true
  displayTableAllowed: true
  useCustomCollectionLabel: false
  childSteps:
    - _type: FormStep
      _name: Lot
      label: Sous-lot
      canFinishSubLevel: true
      enabledOnParentCreate: true
      enabledOnParentEdit: true
      formFieldsMode: AUTO
      enableMasterValuePicking: false
      formTab: Batiments.entities.SousLot.forms.SousLotEdition.SousLot

      formStepEnrichers:   
        - enricher: Batiments.entities.SousLot.enrichers.DefautDtDebStatut
          executedOnButtonClick: false
          executedOnDataChange: true
          executedOnFormOpen: true



      formStepValidations:  
        - validator: Batiments.entities.SousLot.validations.CheckRaisonNonLouable
          executedOnDataChange: true
          executedOnFormOpen: true
          validationType: CHECK
          attribute: Batiments.references.SousLotToRaison.RaisonNonLouable


        - executedOnDataChange: true
          executedOnFormOpen: true
          validationType: MANDATORY
          attribute: Batiments.entities.SousLot.SousLot.DateDebStatut

      stepTransitionValidations:
       
        - onStepExit: BLOCK
          validationType: CHECK
          validator: Batiments.entities.SousLot.validations.CheckRaisonNonLouable

        - onStepExit: BLOCK
          validationType: MANDATORY
          attribute: Batiments.entities.SousLot.SousLot.DateDebStatut


    - _type: FormStep
      _name: Composition
      label: Composition
      canFinishSubLevel: true
      enabledOnParentCreate: true
      enabledOnParentEdit: true
      formFieldsMode: AUTO
      enableMasterValuePicking: false
      formTab: Batiments.entities.SousLot.forms.SousLotEdition.Composition

      formStepValidations:  
        - validator: Batiments.entities.SousLot.validations.CheckSuperficieHabitable
          executedOnDataChange: true
          executedOnFormOpen: true
          validationType: CHECK
          attribute: Batiments.entities.SousLot.SousLot.SuperficieHabitable

      stepTransitionValidations:
        - onStepExit: BLOCK
          validationType: CHECK
          validator: Batiments.entities.SousLot.validations.CheckSuperficieHabitable



    - _type: FormStep
      _name: CycleDeVie
      label: Cycle de vie
      canFinishSubLevel: true
      enabledOnParentCreate: true
      enabledOnParentEdit: true
      formFieldsMode: AUTO
      enableMasterValuePicking: false
      formTab: Batiments.entities.SousLot.forms.SousLotEdition.CycleVie

      referenceFormFieldConfigs:
        - enableCreateReference: false
          enableUserSort: true
          referencePickerType: AUTO_COMPLETE
          fdnFormField: Batiments.entities.SousLot.forms.SousLotEdition.CycleVie.Cycle.Etat.FDN_Etat          
          referenceFilter: Referenced.EtatCode <> 'VENDU'
          referencePickerCollectionView: Batiments.entities.Etat.collection_views.EtatCollectionView
          # referencePickerSearchTypeConfigs: []

      formStepEnrichers:   
        - enricher: Batiments.entities.SousLot.enrichers.DefautEtat
          executedOnButtonClick: false
          executedOnDataChange: false
          executedOnFormOpen: true
        - enricher: Batiments.entities.SousLot.enrichers.DefautFinGestion
          executedOnButtonClick: false
          executedOnDataChange: true
          executedOnFormOpen: false

      formStepValidations:  
        - executedOnDataChange: true
          executedOnFormOpen: true
          validationType: MANDATORY
          attribute:  Batiments.references.SousLotToEtat.Etat

      stepTransitionValidations:
        - onStepExit: BLOCK
          validationType: MANDATORY
          attribute:  Batiments.references.SousLotToEtat.Etat

    - _type: FormStep
      _name: FiscaliteJuridique
      label: Juridique et propriété
      canFinishSubLevel: true
      enabledOnParentCreate: true
      enabledOnParentEdit: true
      formFieldsMode: AUTO
      enableMasterValuePicking: false
      formTab: Batiments.entities.SousLot.forms.SousLotEdition.JuridiquePropriete

      formStepEnrichers:   
        - enricher: Batiments.entities.SousLot.enrichers.DefautRegimeTVA
          executedOnButtonClick: false
          executedOnDataChange: false
          executedOnFormOpen: true

stepperFinishValidations:
  # - onStepperFinish: WARN
  #   validationType: DETECT_DUPS

  - onStepperFinish: BLOCK
    validationType: MANDATORY
    attribute: Batiments.entities.SousLot.SousLot.DateDebStatut
  - onStepperFinish: BLOCK
    validationType: CHECK
    validator: Batiments.entities.SousLot.validations.CheckRaisonNonLouable


  - onStepperFinish: BLOCK
    validationType: MANDATORY
    attribute:  Batiments.references.SousLotToEtat.Etat


  - onStepperFinish: BLOCK
    validationType: CHECK
    validator: Batiments.entities.SousLot.validations.CheckSuperficieHabitable

