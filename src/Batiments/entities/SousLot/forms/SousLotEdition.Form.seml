_package: Batiments.entities.SousLot.forms
_type: Form
_name: SousLotEdition
entity: Batiments.entities.SousLot.SousLot
default: false
formTabs:
  - _type: FormTab
    _name: SousLot
    label: Fiche Sous-lot
    documentationInterpreter: LITERAL
    visibleValue: "1"
    visibleValueInterpreter: LITERAL
    displayFormTabAs: ICON_LABEL
    content:
      # SECTION HAUT (FormContainer)
      - _type: FormContainer
        _name: Identite
        layoutDirection: COLUMN
        content:
              # Identité bâtiment
                    # SECTION 1 (FormContainer)
          - _type: FormContainer
            _name: haut
            layoutDirection: ROW
            content:
              - _type: FormSection
                _name: IdentiteSousLot
                label: Identité sous-lot
                layoutDirection: COLUMN
                visibleValue: '1'
                visibleValueInterpreter: LITERAL
                labelWidth: 200px
                content:
                  - _type: TextField
                    _name: IdentifiantsERP
                    value: IdentifiantsERP
                    label: Numéro sous-lot
                    authoringMode: force-read-only
                    labelProperties:
                      alignment: left
                      typographyValueInterpreter: LITERAL
                      typography: body-2
                      color: md:black
                    useCustomLabel: true
                    dataType: STRING
                    


                  - _type: ReferenceField
                    _name: FDN_Lot
                    value: FDN_Lot
                    label: Lot parent
                    authoringMode: force-read-only
                    labelProperties:
                      alignment: left
                      typographyValueInterpreter: LITERAL
                      typography: body-2
                      color: md:black
                    useCustomLabel: true
                    dataType: STRING
                    referencedEntity: Batiments.entities.Lot.Lot

                  - _type: ReferenceField
                    _name: FDN_Etage
                    value: Lot.FDN_Etage
                    label: Etage
                    authoringMode: force-read-only
                    labelProperties:
                      alignment: left
                      typographyValueInterpreter: LITERAL
                      typography: body-2
                      color: md:black
                    useCustomLabel: true
                    dataType: STRING
                    referencedEntity: Batiments.entities.Etage.Etage

                  - _type: TextField
                    _name: IdentifiantPhysique
                    value: IdentifiantPhysique
                    label: Identifiant physique
                    labelProperties:
                      alignment: left
                      typographyValueInterpreter: LITERAL
                      typography: body-2
                      color: md:black
                    useCustomLabel: true
                    visibleValue: Lot.FID_TypologieLot in ('AP','PK','PI')
                    visibleValueInterpreter: SEMQL
                    dataType: STRING
      
              - _type: FormSection
                _name: SituationLocative
                label: Situation locative
                layoutDirection: COLUMN
                visibleValue: '1'
                visibleValueInterpreter: LITERAL
                labelWidth: 200px
                content:
                  - _type: CheckboxField
                    _name: StatutLouable
                    value: StatutLouable
                    label: Statut louable
                    labelProperties:
                      alignment: left
                      typographyValueInterpreter: LITERAL
                      typography: body-2
                      color: md:black
                    useCustomLabel: true
                    dataType: BOOLEAN

                  - _type: DateField
                    _name: DateDebStatut
                    value: DateDebStatut
                    label: Date début statut
                    authoringMode: case when StatutLouable <> GoldenRecord.StatutLouable then 'auto' else 'force-read-only' end
                    authoringModeValueInterpreter: SEMQL 
                    labelProperties:
                      alignment: left
                      typographyValueInterpreter: LITERAL
                      typography: body-2
                      color: md:black
                    componentProperties:                 
                      displayFormat: dd/MM/yyyy                
                      displayFormatValueInterpreter: LITERAL            
                      editingFormat: dd/MM/yyyy                 
                      editingFormatValueInterpreter: LITERAL
                    useCustomLabel: true
                    dataType: DATE
                  - _type: ReferenceField
                    _name: FDN_RaisonNonLouable
                    value: FDN_RaisonNonLouable
                    label: Raison non louable
                    labelProperties:
                      alignment: left
                      typographyValueInterpreter: LITERAL
                      typography: body-2
                      color: md:black
                    useCustomLabel: true
                    visibleValue: StatutLouable = '0' 
                    visibleValueInterpreter: SEMQL
                    dataType: STRING
                    referencedEntity: Batiments.entities.RaisonNonLouable.RaisonNonLouable

          - _type: FormContainer
            _name: bas
            layoutDirection: ROW
            content:
              - _type: FormSection
                _name: Commentaires
                label: Commentaires
                layoutDirection: COLUMN
                visibleValue: "1"
                visibleValueInterpreter: LITERAL
                labelWidth: 200px
                content:
                        - _type: TextField
                          _name: Commentaire
                          value: Commentaire
                          label: Commentaires
                          labelProperties:
                            alignment: left
                            typography: body-2
                            color: md:black
                          useCustomLabel: false
                          dataType: STRING

  - _type: FormTab
    _name: Composition
    label: Composition
    iconUrl: images://mdi/view-dashboard.svg
    documentationInterpreter: LITERAL
    visibleValue: "1"
    visibleValueInterpreter: LITERAL
    displayFormTabAs: ICON_LABEL
    content:
      - _type: FormContainer
        _name: Composition
        layoutDirection: COLUMN
        content:

          - _type: FormSection
            _name: Superficies
            label: Superficies
            layoutDirection: COLUMN
            visibleValue: "1"
            visibleValueInterpreter: LITERAL
            labelWidth: 300px
            content:
              - _type: TextField
                _name: SuperficieHabitable
                value: SuperficieHabitable 
                label: Superficie habitable (SHAB)
                documentation: Superficie habitable (SHAB).
                labelProperties:
                  alignment: left
                  typographyValueInterpreter: LITERAL
                  typography: body-2
                  color: md:black
                useCustomLabel: true
                dataType: STRING

              - _type: TextField
                _name: SuperficieHabitableQP
                value: SuperficieHabitableQP
                label: Superficie habitable avec QP
                documentation: Superficie habitable avec quote-part de parties communes.
                labelProperties:
                  alignment: left
                  typographyValueInterpreter: LITERAL
                  typography: body-2
                  color: md:black
                useCustomLabel: true
                dataType: STRING 

   

  - _type: FormTab
    _name: CycleVie
    label: Cycle de vie
    iconUrl: images://mdi/sync-circle.svg
    documentationInterpreter: LITERAL
    visibleValue: "1"
    visibleValueInterpreter: LITERAL
    displayFormTabAs: ICON_LABEL
    content:
    
    - _type: FormContainer
      _name: Cycle
      layoutDirection: ROW
      content:

      - _type: FormSection
        _name: Etat
        label: Etat
        layoutDirection: COLUMN
        visibleValue: '1'
        visibleValueInterpreter: LITERAL
        labelWidth: 300px
        content:
          - _type: ReferenceField
            _name: FDN_Etat
            value: FDN_Etat
            label: Etat
            labelProperties:
              alignment: left
              typographyValueInterpreter: LITERAL
              typography: body-2
              color: md:black
            useCustomLabel: true
            dataType: STRING
            referencedEntity: Batiments.entities.Etat.Etat



          - _type: DateField
            _name: DateFinGestion
            value: DateFinGestion
            label: Date fin gestion
            visibleValue: DateFinGestion is not null
            visibleValueInterpreter: SEMQL
            labelProperties:
              alignment: left
              typographyValueInterpreter: LITERAL
              typography: body-2
              color: md:black
            componentProperties:                 
              displayFormat: dd/MM/yyyy                
              displayFormatValueInterpreter: LITERAL            
              editingFormat: dd/MM/yyyy                 
              editingFormatValueInterpreter: LITERAL 
            useCustomLabel: true
            dataType: DATE



  - _type: FormTab
    _name: JuridiquePropriete
    label: Juridique et propriété
    iconUrl: images://mdi/bank.svg
    documentationInterpreter: LITERAL
    visibleValue: "1"
    visibleValueInterpreter: LITERAL
    displayFormTabAs: ICON_LABEL
    content:
      - _type: FormSection
        _name: Juridique
        label: Juridique
        layoutDirection: COLUMN
        visibleValue: '1'
        visibleValueInterpreter: LITERAL
        labelWidth: 200px
        content:
          - _type: ReferenceField
            _name: FDN_FiscaliteCible
            value: FDN_FiscaliteCible
            label: Régime TVA
            labelProperties:
              alignment: left
              typographyValueInterpreter: LITERAL
              typography: body-2
              color: md:black
            useCustomLabel: true
            dataType: STRING
            referencedEntity: Batiments.entities.FiscaliteCible.FiscaliteCible

          - _type: DateField
            _name: DateDebRegimeTVA
            value: DateRegimeTVA
            label: Date régime TVA
            labelProperties:
              alignment: left
              typographyValueInterpreter: LITERAL
              typography: body-2
              color: md:black
            componentProperties:                 
              displayFormat: dd/MM/yyyy                
              displayFormatValueInterpreter: LITERAL            
              editingFormat: dd/MM/yyyy                 
              editingFormatValueInterpreter: LITERAL   
            useCustomLabel: true
            dataType: DATE


                              