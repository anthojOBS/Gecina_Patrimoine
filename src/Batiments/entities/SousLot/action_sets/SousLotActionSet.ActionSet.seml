_package: Batiments.entities.SousLot.action_sets
_type: ActionSet
_name: SousLotActionSet
entity: Batiments.entities.SousLot.SousLot
label: Sous-lot Action Set
defaultActionSet: true
actions:
  - _type: CreateAction
    _name: CreateAuthorLots
    label: Création sous-lot
    useCustomLabel: true
    stepper: Batiments.entities.SousLot.steppers.SousLotsCreation
    createMultiple: false
    createdRecordType: GOLDEN
    waitDialogEnabled: false
    allowOtherPublishers: true
  - _type: EditAction
    _name: EditAuthorLots
    label: Modification sous-lot
    useCustomLabel: true
    stepper: Batiments.entities.SousLot.steppers.SousLotsEdition
    multipleSelectionAllowed: true
    availableForGoldenData: true
    availableForMasterData: true
    availableForErrorData: true
    waitDialogEnabled: false
  # - _type: StartWorkflowEntityAction
  #   _name: EditSurfaceLot
  #   label: Editer Surface Lot (Workflow)
  #   useCustomLabel: true
  #   waitDialogEnabled: false
  #   workflow: Batiments.workflows.ModificationSurfaceLot
  #   startEvent: Batiments.workflows.ModificationSurfaceLot.StartEdit
  - _type: MassUpdateAction
    _name: MassUpdateAuthorLots
    label: Mise à jour de masse
    useCustomLabel: true
    stepper: Batiments.entities.SousLot.steppers.SousLotsEdition
    availableForGoldenData: true
    availableForErrorData: true
    availableForMasterData: true
    waitDialogEnabled: false
  - _type: DeleteAction
    _name: Delete
    label: Supprimer
    useCustomLabel: true
    multipleSelectionAllowed: true
    deleteType: HARD_DELETE
    waitDialogEnabled: false
    availableForGoldenData: true
    availableForMasterData: true
    requiredRole: semarchyAdmin
  - _type: ExportAction
    _name: Export
    label: Exporter
    useCustomLabel: true
    waitDialogEnabled: false
  - _type: ImportAction
    _name: Import
    label: Importer
    useCustomLabel: true
    importMode: CREATE_AND_UPDATE
    stepper: Batiments.entities.SousLot.steppers.SousLotsConsultation
    importedRecordType: MASTER
    waitDialogEnabled: false
    allowOtherPublishers: true
  - _type: BrowseGraphAction
    _name: BrowseGraph
    label: Recherche graphique
    useCustomLabel: true
    waitDialogEnabled: false
    requiredRole: semarchyAdmin
  - _type: DirectConfirmDupsAction
    _name: DirectConfirmDuplicates
    label: Confirmer doublons directement
    useCustomLabel: false
    waitDialogEnabled: false
  - _type: ReviewAndConfirm
    _name: ReviewAndConfirmDuplicatesManageDuplicatesOnLot
    label: Revue and Validation doublons
    useCustomLabel: true
    dupsManager: Batiments.entities.SousLot.dups_managers.ManageDuplicatesOnSousLot
    enableEdit: true
    mandateConfirmAll: false
    waitDialogEnabled: false
  - _type: MergeOrSplit
    _name: MergeOrSplitDuplicatesManageDuplicatesOnLot
    label: Fusion et défusion
    useCustomLabel: true
    dupsManager: Batiments.entities.SousLot.dups_managers.ManageDuplicatesOnSousLot
    enableEdit: true
    waitDialogEnabled: false
  - _type: ReviewSuggestions
    _name: ReviewSuggestionsDuplicatesManageDuplicatesOnLot
    label: Suggestions de doublons
    useCustomLabel: true
    dupsManager: Batiments.entities.SousLot.dups_managers.ManageDuplicatesOnSousLot
    enableEdit: true
    waitDialogEnabled: false
    onAcceptPromptGoldenId: false
    mandateResolveAllSuggestions: false
  - _type: ExplainRecordAction
    _name: ExplainRecord
    label: Expliquer l'enregistrement
    useCustomLabel: true
    displayCard: Batiments.entities.SousLot.display_cards.SousLotDisplayCard
    formTab: Batiments.entities.SousLot.forms.SousLotExplication.SousLot
    waitDialogEnabled: false
