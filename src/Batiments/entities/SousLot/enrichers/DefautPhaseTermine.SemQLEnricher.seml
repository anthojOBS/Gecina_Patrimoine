_package: Batiments.entities.SousLot.enrichers
_name: DefautPhaseTermine
_type: SemQLEnricher
entity: Batiments.entities.SousLot.SousLot
label: Phase Terminé
enricherExecutionScope: POST_CONSO
semQlEnricherExpressions: 
  - attributeName: FID_Phase
    expression: case when Lot.FID_Phase = 'TER'  then 'TER' else FID_Phase end