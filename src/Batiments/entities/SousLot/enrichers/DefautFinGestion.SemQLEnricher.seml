_package: Batiments.entities.SousLot.enrichers
_name: DefautFinGestion
_type: SemQLEnricher
entity: Batiments.entities.SousLot.SousLot
label: Default Country
enricherExecutionScope: NONE
semQlEnricherExpressions: 
  - attributeName: DateFinPhase
    expression: case when FID_Phase <> GoldenRecord.FID_Phase and GoldenRecord.FID_Phase is not null 
     and GoldenRecord.DateFinPhase is null and DateFinPhase is null
     then CURRENT_DATE() 
     when GoldenRecord.DateFinPhase  is not null  and GoldenRecord.DateFinPhase <> DateFinPhase then GoldenRecord.DateFinPhase  else DateFinPhase end