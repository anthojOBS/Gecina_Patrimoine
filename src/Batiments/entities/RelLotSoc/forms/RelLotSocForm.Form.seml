_package: Batiments.entities.RelLotSoc.forms
_type: Form
_name: RelLotSocForm
entity: Batiments.entities.RelLotSoc.RelLotSoc
default: true
formTabs:
  - _type: FormTab
    _name: RelLotSoc
    label: RelLotSoc 
    documentationInterpreter: LITERAL
    visibleValue: "1"
    visibleValueInterpreter: LITERAL
    displayFormTabAs: LABEL
    content:
      - _type: IdField
        _name: RelLotSocCode
        value: RelLotSocCode
        useCustomLabel: false
        dataType: STRING
        labelProperties:
          typographyValueInterpreter: LITERAL
          typography: body-2
          color: md:black
          alignment: left
