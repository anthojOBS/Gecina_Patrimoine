_package: Batiments.entities.RelLotSoc.action_sets
_type: ActionSet
_name: RelLotSocActionSet
entity: Batiments.entities.RelLotSoc.RelLotSoc
label: RelLotSoc Action Set
defaultActionSet: true
actions:
  - _type: CreateAction
    _name: CreateAuthorRelLotSoc
    label: Create
    useCustomLabel: true
    stepper: Batiments.entities.RelLotSoc.steppers.AuthorRelLotSoc
    createMultiple: false
    createdRecordType: GOLDEN
    waitDialogEnabled: false
    allowOtherPublishers: true
  - _type: EditAction
    _name: EditAuthorRelLotSoc
    label: Edit
    useCustomLabel: true
    stepper: Batiments.entities.RelLotSoc.steppers.AuthorRelLotSoc
    multipleSelectionAllowed: true
    availableForGoldenData: true
    availableForMasterData: true
    availableForErrorData: true
    waitDialogEnabled: false
  - _type: DeleteAction
    _name: Delete
    label: Delete
    useCustomLabel: true
    multipleSelectionAllowed: true
    deleteType: HARD_DELETE
    waitDialogEnabled: false
    availableForGoldenData: true
    availableForMasterData: true
  - _type: ExportAction
    _name: Export
    label: Export
    useCustomLabel: true
    waitDialogEnabled: false
  - _type: ImportAction
    _name: ImportAuthorRelLotSoc
    label: Import
    useCustomLabel: true
    importMode: CREATE_AND_UPDATE
    stepper: Batiments.entities.RelLotSoc.steppers.AuthorRelLotSoc
    importedRecordType: MASTER
    waitDialogEnabled: false
    allowOtherPublishers: true
  - _type: BrowseGraphAction
    _name: BrowseGraph
    label: Browse Graph
    useCustomLabel: true
    waitDialogEnabled: false
  - _type: DirectConfirmDupsAction
    _name: DirectConfirmDuplicates
    label: Direct Confirm Duplicates
    useCustomLabel: false
    waitDialogEnabled: false
  - _type: ReviewAndConfirm
    _name: ReviewAndConfirmDuplicatesManageDuplicatesOnRelLotSoc
    label: Review and Confirm Duplicates
    useCustomLabel: true
    dupsManager: Batiments.entities.RelLotSoc.dups_managers.ManageDuplicatesOnRelLotSoc
    enableEdit: true
    mandateConfirmAll: false
    waitDialogEnabled: false
  - _type: MergeOrSplit
    _name: MergeOrSplitDuplicatesManageDuplicatesOnRelLotSoc
    label: Merge Or Split Duplicates
    useCustomLabel: true
    dupsManager: Batiments.entities.RelLotSoc.dups_managers.ManageDuplicatesOnRelLotSoc
    enableEdit: true
    waitDialogEnabled: false
  - _type: ReviewSuggestions
    _name: ReviewSuggestionsDuplicatesManageDuplicatesOnRelLotSoc
    label: Review Duplicates Suggestions
    useCustomLabel: true
    dupsManager: Batiments.entities.RelLotSoc.dups_managers.ManageDuplicatesOnRelLotSoc
    enableEdit: true
    waitDialogEnabled: false
    onAcceptPromptGoldenId: false
    mandateResolveAllSuggestions: false
  - _type: ExplainRecordAction
    _name: ExplainRecord
    label: Explain Record
    useCustomLabel: true
    displayCard: Batiments.entities.RelLotSoc.display_cards.RelLotSocDisplayCard
    formTab: Batiments.entities.RelLotSoc.forms.RelLotSocForm.RelLotSoc
    waitDialogEnabled: false
