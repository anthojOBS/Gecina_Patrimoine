_package: Batiments.entities.Usage.forms
_type: Form
_name: UsageForm
entity: Batiments.entities.Usage.Usage
default: true
formTabs:
  - _type: FormTab
    _name: Usage
    label: Usage
    documentationInterpreter: LITERAL
    visibleValue: "1"
    visibleValueInterpreter: LITERAL
    displayFormTabAs: LABEL
    content:
      - _type: IdField
        _name: UsageCode
        value: UsageCode
        useCustomLabel: false
        dataType: STRING
        labelProperties:
          typographyValueInterpreter: LITERAL
          typography: body-2
          color: md:black
      - _type: TextField
        _name: UsageLibelle
        value: UsageLibelle
        useCustomLabel: false
        dataType: STRING
        labelProperties:
          typographyValueInterpreter: LITERAL
          typography: body-2
          color: md:black