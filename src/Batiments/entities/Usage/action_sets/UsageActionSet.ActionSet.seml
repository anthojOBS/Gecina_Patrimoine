_package: Batiments.entities.Usage.action_sets
_type: ActionSet
_name: UsageActionSet
entity: Batiments.entities.Usage.Usage
label: Usage Action Set
defaultActionSet: true
actions:
  - _type: CreateAction
    _name: CreateAuthorUsages
    label: Create
    useCustomLabel: true
    stepper: Batiments.entities.Usage.steppers.AuthorUsages
    createMultiple: false
    createdRecordType: GOLDEN
    waitDialogEnabled: false
    allowOtherPublishers: true
  - _type: EditAction
    _name: EditAuthorUsages
    label: Edit
    useCustomLabel: true
    stepper: Batiments.entities.Usage.steppers.AuthorUsages
    multipleSelectionAllowed: true
    availableForGoldenData: true
    availableForMasterData: false
    availableForErrorData: true
    waitDialogEnabled: false
  - _type: MassUpdateAction
    _name: MassUpdateAuthorUsages
    label: Mass Update
    useCustomLabel: true
    stepper: Batiments.entities.Usage.steppers.AuthorUsages
    availableForGoldenData: true
    availableForErrorData: true
    availableForMasterData: false
    waitDialogEnabled: false
  - _type: DeleteAction
    _name: Delete
    label: Delete
    useCustomLabel: true
    multipleSelectionAllowed: true
    deleteType: HARD_DELETE
    waitDialogEnabled: false
    availableForGoldenData: true
    availableForMasterData: false
    requiredRole: semarchyAdmin
  - _type: ExportAction
    _name: Export
    label: Export
    useCustomLabel: true
    waitDialogEnabled: false
  - _type: ImportAction
    _name: ImportAuthorUsages
    label: Import
    useCustomLabel: true
    importMode: CREATE_AND_UPDATE
    stepper: Batiments.entities.Usage.steppers.AuthorUsages
    importedRecordType: GOLDEN
    waitDialogEnabled: false
    allowOtherPublishers: true
