_package: Batiments.entities.ZoneGeographique.business_views
_type: BusinessView
_name: ZoneGeographiqueBusinessView
entity: Batiments.entities.ZoneGeographique.ZoneGeographique
rootLabel: Zone Geographiques
rootPluralLabel: Zones Géographiques
displayRootNodeAs: ICON_LABEL
label: Zones Géographiques
rootBusinessViewEntity:
  _type: BusinessViewEntity
  _name: ZoneGeographique
  displayCard: Batiments.entities.ZoneGeographique.display_cards.ZoneGeographiqueDisplayCard
  entity: Batiments.entities.ZoneGeographique.ZoneGeographique
  actionSet: Batiments.entities.ZoneGeographique.action_sets.ZoneGeographiqueActionSet
  collection: Batiments.entities.ZoneGeographique.collection_views.ZoneGeographiqueCollectionView
  form: Batiments.entities.ZoneGeographique.forms.ZoneGeographiqueForm
  outlineVisible: false
  displayRecordCount: ALWAYS
  businessEntitySearchConfigs:
    - _name: TextConfig
      _type: BusinessEntitySearchTypeConfig
      searchType: TEXT
    - _name: FormConfig
      _type: BusinessEntitySearchTypeConfig
      searchType: BY_FORM
    - _name: AdvancedConfig
      _type: BusinessEntitySearchTypeConfig
      searchType: ADVANCED
    - _name: SemqlConfig
      _type: BusinessEntitySearchTypeConfig
      searchType: SEMQL
  overrideDefaultSort: false
  enableUserDefinedSort: true
  listAllowed: true
  tableAllowed: true
  gridAllowed: true

  transitions:
    - _name: GoldenHistoryRecords
      _type: BusinessViewTransition
      displayFormTabAs: ICON_LABEL
      displayTransitionNodeAs: ICON_LABEL
      enableHierarchy: '0'
      enableHierarchyInterpreter: LITERAL
      expandHierarchyByDefault: false
      iconUrl: images://mdi/history.svg
      label: History
      pluralLabel: History
      transitionPath: GoldenHistoryRecords
      transitionType: FULLY_QUALIFIED
      transitionVisible: '1'
      transitionVisibleInterpreter: LITERAL
      useCustomLabel: true
      businessViewEntity: 
        _type: BusinessViewEntityReference
        ref: Batiments.entities.ZoneGeographique.business_views.ZoneGeographiqueBusinessView.ZoneGeographique
      filter: 1 = 1
enableHierarchyView: false
useHierarchyOnOpen: false
