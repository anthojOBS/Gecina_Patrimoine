_package: Batiments.entities.ZoneGeographique.forms
_type: Form
_name: ZoneGeographiqueForm
entity: Batiments.entities.ZoneGeographique.ZoneGeographique
default: true
formTabs:
  - _type: FormTab
    _name: ZoneGeographique
    label: Zone Geographique
    documentationInterpreter: LITERAL
    visibleValue: "1"
    visibleValueInterpreter: LITERAL
    displayFormTabAs: LABEL
    content:
      - _type: IdField
        _name: ZoneGeoCode
        value: ZoneGeoCode
        useCustomLabel: false
        dataType: STRING
        labelProperties:
          typographyValueInterpreter: LITERAL
          typography: body-2
          color: md:black
      - _type: TextField
        _name: ZoneGeoLibelle
        value: ZoneGeoLibelle
        useCustomLabel: false
        dataType: STRING
        labelProperties:
          typographyValueInterpreter: LITERAL
          typography: body-2
          color: md:black
