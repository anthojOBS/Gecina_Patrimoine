    createMultiple: false
    createdRecordType: GOLDEN
    waitDialogEnabled: false
    allowOtherPublishers: true
  - _type: EditAction
    _name: EditAuthorZoneGeographiques
    label: Edit
    useCustomLabel: true
    stepper: Batiments.entities.ZoneGeographique.steppers.AuthorZoneGeographiques
    multipleSelectionAllowed: true
    availableForGoldenData: true
    availableForMasterData: false
    availableForErrorData: true
    waitDialogEnabled: false
  - _type: MassUpdateAction
    _name: MassUpdateAuthorZoneGeographiques
    label: Mass Update
    useCustomLabel: true
    stepper: Batiments.entities.ZoneGeographique.steppers.AuthorZoneGeographiques
    availableForGoldenData: true
    availableForErrorData: true
    availableForMasterData: false
    waitDialogEnabled: false
  - _type: DeleteAction
    _name: Delete
    label: Delete
    useCustomLabel: true
    multipleSelectionAllowed: true
    deleteType: HARD_DELETE
    waitDialogEnabled: false
    availableForGoldenData: true
    availableForMasterData: false
  - _type: ExportAction
    _name: Export
    label: Export
    useCustomLabel: true
    waitDialogEnabled: false
  - _type: ImportAction
    _name: ImportAuthorZoneGeographiques
    label: Import
    useCustomLabel: true
    importMode: CREATE_AND_UPDATE
    stepper: Batiments.entities.ZoneGeographique.steppers.AuthorZoneGeographiques
    importedRecordType: GOLDEN
