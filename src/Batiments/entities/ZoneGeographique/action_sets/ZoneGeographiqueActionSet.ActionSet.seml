_package: Batiments.entities.ZoneGeographique.action_sets
_type: ActionSet
_name: ZoneGeographiqueActionSet
entity: Batiments.entities.ZoneGeographique.ZoneGeographique
label: Zone Geographique Action Set
defaultActionSet: true
actions:
  - _type: CreateAction
    _name: CreateAuthorZoneGeographiques
    label: Create
    useCustomLabel: true
