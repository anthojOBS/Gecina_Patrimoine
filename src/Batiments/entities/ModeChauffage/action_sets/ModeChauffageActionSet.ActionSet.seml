    waitDialogEnabled: false
    availableForGoldenData: true
    availableForMasterData: false
    requiredRole: semarchyAdmin
  - _type: ExportAction
    _name: Export
    label: Export
    useCustomLabel: true
    waitDialogEnabled: false
  - _type: ImportAction
    _name: ImportAuthorModeChauffages
