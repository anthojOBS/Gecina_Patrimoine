_package: Batiments.entities.Phase
_type: Entity
_name: Phase
label: Phase
pluralLabel: Phases
entityType: BASIC
physicalTableName: PHASE
iconUrl: images://mdi/timeline-text.svg
description: ""
documentation: |
  La **Phase** représente l'état d'avancement d'un actif immobilier dans son cycle de vie.
  
  Une phase permet de suivre l'évolution d'un immeuble, d'un bâtiment ou d'un lot depuis sa conception jusqu'à son exploitation (en projet, en construction, livré, en exploitation, etc.).
  
  Cette entité est essentielle pour le pilotage des projets immobiliers et la gestion du portefeuille.
historizeGolden: true
historizeMaster: false
enableDelete: true
attributes:
  - _type: EntityAttribute
    _name: PhaseCode
    label: Code Phase
    physicalName: PHASE_ID
    dataType: String
    length: 50
    mandatory: true
    searchable: true
  - _type: EntityAttribute
    _name: PhaseLibelle
    label: Libellé Phase
    physicalName: LIBELLE
    dataType: String
    length: 255
    mandatory: false
    searchable: true
sourceIdGeneration:
  mode: MANUAL
primaryKey: Batiments.entities.Phase.Phase.PhaseCode
