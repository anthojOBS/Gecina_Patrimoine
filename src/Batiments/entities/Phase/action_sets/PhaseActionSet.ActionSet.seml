_package: Batiments.entities.Phase.action_sets
_type: ActionSet
_name: PhaseActionSet
entity: Batiments.entities.Phase.Phase
label: Phase Action Set
defaultActionSet: true
actions:
  - _type: CreateAction
    _name: CreateAuthorPhases
    label: Create
    useCustomLabel: true
    stepper: Batiments.entities.Phase.steppers.AuthorPhases
    createMultiple: false
    createdRecordType: GOLDEN
    waitDialogEnabled: false
    allowOtherPublishers: true
  - _type: EditAction
    _name: EditAuthorPhases
    label: Edit
    useCustomLabel: true
    stepper: Batiments.entities.Phase.steppers.AuthorPhases
    multipleSelectionAllowed: true
    availableForGoldenData: true
    availableForMasterData: false
    availableForErrorData: true
    waitDialogEnabled: false
  - _type: MassUpdateAction
    _name: MassUpdateAuthorPhases
    label: Mass Update
    useCustomLabel: true
    stepper: Batiments.entities.Phase.steppers.AuthorPhases
    availableForGoldenData: true
    availableForErrorData: true
    availableForMasterData: false
    waitDialogEnabled: false
  - _type: DeleteAction
    _name: Delete
    label: Delete
    useCustomLabel: true
    multipleSelectionAllowed: true
    deleteType: HARD_DELETE
    waitDialogEnabled: false
    availableForGoldenData: true
    availableForMasterData: false
    requiredRole: semarchyAdmin
  - _type: ExportAction
    _name: Export
    label: Export
    useCustomLabel: true
    waitDialogEnabled: false
  - _type: ImportAction
    _name: ImportAuthorPhases
    label: Import
    useCustomLabel: true
    importMode: CREATE_AND_UPDATE
    stepper: Batiments.entities.Phase.steppers.AuthorPhases
    importedRecordType: GOLDEN
    waitDialogEnabled: false
    allowOtherPublishers: true
