_package: Batiments.entities.Phase.business_views
_type: BusinessView
_name: PhaseBusinessView
entity: Batiments.entities.Phase.Phase
rootLabel: Phase
rootPluralLabel: Phase
displayRootNodeAs: ICON_LABEL
label: Phase
rootBusinessViewEntity:
  _type: BusinessViewEntity
  _name: Phase
  displayCard: Batiments.entities.Phase.display_cards.PhaseDisplayCard
  entity: Batiments.entities.Phase.Phase
  actionSet: Batiments.entities.Phase.action_sets.PhaseActionSet
  collection: Batiments.entities.Phase.collection_views.PhaseCollectionView
  form: Batiments.entities.Phase.forms.PhaseForm
  outlineVisible: false
  displayRecordCount: ALWAYS
  businessEntitySearchConfigs:
    - _name: TextConfig
      _type: BusinessEntitySearchTypeConfig
      searchType: TEXT
    - _name: FormConfig
      _type: BusinessEntitySearchTypeConfig
      searchType: BY_FORM
    - _name: AdvancedConfig
      _type: BusinessEntitySearchTypeConfig
      searchType: ADVANCED
    - _name: SemqlConfig
      _type: BusinessEntitySearchTypeConfig
      searchType: SEMQL
  overrideDefaultSort: false
  enableUserDefinedSort: true
  listAllowed: true
  tableAllowed: true
  gridAllowed: true

  transitions:
    - _name: GoldenHistoryRecords
      _type: BusinessViewTransition
      displayFormTabAs: ICON_LABEL
      displayTransitionNodeAs: ICON_LABEL
      enableHierarchy: '0'
      enableHierarchyInterpreter: LITERAL
      expandHierarchyByDefault: false
      iconUrl: images://mdi/history.svg
      label: History
      pluralLabel: History
      transitionPath: GoldenHistoryRecords
      transitionType: FULLY_QUALIFIED
      transitionVisible: '1'
      transitionVisibleInterpreter: LITERAL
      useCustomLabel: true
      businessViewEntity: 
        _type: BusinessViewEntityReference
        ref: Batiments.entities.Phase.business_views.PhaseBusinessView.Phase
      filter: 1 = 1
enableHierarchyView: false
useHierarchyOnOpen: false
