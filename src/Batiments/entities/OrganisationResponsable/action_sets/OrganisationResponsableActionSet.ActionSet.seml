_package: Batiments.entities.OrganisationResponsable.action_sets
_type: ActionSet
_name: OrganisationResponsableActionSet
entity: Batiments.entities.OrganisationResponsable.OrganisationResponsable
label: Organisation responsable Action Set
defaultActionSet: true
actions:
  - _type: CreateAction
    _name: CreateAuthorOrganisationResponsable
    label: Create
    useCustomLabel: true
    stepper: Batiments.entities.OrganisationResponsable.steppers.AuthorOrganisationResponsable
    createMultiple: false
    createdRecordType: GOLDEN
    waitDialogEnabled: false
    allowOtherPublishers: true
  - _type: EditAction
    _name: EditAuthorPhases
    label: Edit
    useCustomLabel: true
    stepper: Batiments.entities.OrganisationResponsable.steppers.AuthorOrganisationResponsable
    multipleSelectionAllowed: true
    availableForGoldenData: true
    availableForMasterData: false
    availableForErrorData: true
    waitDialogEnabled: false
  - _type: MassUpdateAction
    _name: MassUpdateAuthorOrganisationResponsables
    label: Mass Update
    useCustomLabel: true
    stepper: Batiments.entities.OrganisationResponsable.steppers.AuthorOrganisationResponsable
    availableForGoldenData: true
    availableForErrorData: true
    availableForMasterData: false
    waitDialogEnabled: false
  - _type: DeleteAction
    _name: Delete
    label: Delete
    useCustomLabel: true
    multipleSelectionAllowed: true
    deleteType: HARD_DELETE
    waitDialogEnabled: false
    availableForGoldenData: true
    availableForMasterData: false
    requiredRole: semarchyAdmin
  - _type: ExportAction
    _name: Export
    label: Export
    useCustomLabel: true
    waitDialogEnabled: false
  - _type: ImportAction
    _name: ImportAuthorPhases
    label: Import
    useCustomLabel: true
    importMode: CREATE_AND_UPDATE
    stepper: Batiments.entities.OrganisationResponsable.steppers.AuthorOrganisationResponsable
    importedRecordType: GOLDEN
    waitDialogEnabled: false
    allowOtherPublishers: true
