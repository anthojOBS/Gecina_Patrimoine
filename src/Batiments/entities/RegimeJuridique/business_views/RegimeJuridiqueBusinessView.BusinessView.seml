label: Régimes Juridiques
rootBusinessViewEntity:
  _type: BusinessViewEntity
  _name: RegimeJuridique
  displayCard: Batiments.entities.RegimeJuridique.display_cards.RegimeJuridiqueDisplayCard
  entity: Batiments.entities.RegimeJuridique.RegimeJuridique
  actionSet: Batiments.entities.RegimeJuridique.action_sets.RegimeJuridiqueActionSet
  collection: Batiments.entities.RegimeJuridique.collection_views.RegimeJuridiqueCollectionView
  form: Batiments.entities.RegimeJuridique.forms.RegimeJuridiqueForm
  outlineVisible: false
  displayRecordCount: ALWAYS
  businessEntitySearchConfigs:
    - _name: TextConfig
      _type: BusinessEntitySearchTypeConfig
      searchType: TEXT
    - _name: FormConfig
      _type: BusinessEntitySearchTypeConfig
      searchType: BY_FORM
    - _name: AdvancedConfig
      _type: BusinessEntitySearchTypeConfig
      searchType: ADVANCED
    - _name: SemqlConfig
