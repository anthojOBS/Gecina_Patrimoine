_package: Batiments.entities.RegimeJuridique.business_views
_type: BusinessView
_name: RegimeJuridiqueBusinessView
entity: Batiments.entities.RegimeJuridique.RegimeJuridique
rootLabel: Regime Juridiques
rootPluralLabel: Regime Juridiques
