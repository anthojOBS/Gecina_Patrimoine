_package: Batiments.entities.Pays.action_sets
_type: ActionSet
_name: PaysActionSet
entity: Batiments.entities.Pays.Pays
label: Pays Action Set
defaultActionSet: true
actions:
  - _type: CreateAction
    _name: CreateAuthorPayss
    label: Create
    useCustomLabel: true
    stepper: Batiments.entities.Pays.steppers.AuthorPays
    createMultiple: false
    createdRecordType: GOLDEN
    waitDialogEnabled: false
    allowOtherPublishers: true
  - _type: EditAction
    _name: EditAuthorPayss
    label: Edit
    useCustomLabel: true
    stepper: Batiments.entities.Pays.steppers.AuthorPays
    multipleSelectionAllowed: true
    availableForGoldenData: true
    availableForMasterData: false
    availableForErrorData: true
    waitDialogEnabled: false
  - _type: MassUpdateAction
    _name: MassUpdateAuthorPayss
    label: Mass Update
    useCustomLabel: true
    stepper: Batiments.entities.Pays.steppers.AuthorPays
    availableForGoldenData: true
    availableForErrorData: true
    availableForMasterData: false
    waitDialogEnabled: false
  - _type: DeleteAction
    _name: Delete
    label: Delete
    useCustomLabel: true
    multipleSelectionAllowed: true
    deleteType: HARD_DELETE
    waitDialogEnabled: false
    availableForGoldenData: true
    availableForMasterData: true
  - _type: ExportAction
    _name: Export
    label: Export
    useCustomLabel: true
    waitDialogEnabled: false
  - _type: ImportAction
    _name: ImportAuthorPayss
    label: Import
    useCustomLabel: true
    importMode: CREATE_AND_UPDATE
    stepper: Batiments.entities.Pays.steppers.AuthorPays
    importedRecordType: GOLDEN
    waitDialogEnabled: false
    allowOtherPublishers: true
  - _type: BrowseGraphAction
    _name: BrowseGraph
    label: Browse Graph
    useCustomLabel: true
    waitDialogEnabled: false
