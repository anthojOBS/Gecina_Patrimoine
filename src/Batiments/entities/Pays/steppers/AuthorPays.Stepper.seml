_package: Batiments.entities.Pays.steppers
_name: AuthorPays
_type: Stepper
entity: Batiments.entities.Pays.Pays
label: Pays
rootStep:
  _type: CollectionStep
  _name: Pays
  label: Pays
  canFinishSubLevel: true
  enabledOnParentCreate: true
  enabledOnParentEdit: true
  formFieldsMode: AUTO
  linear: false
  childDeleteType: HARD_DELETE
  collectionView: Batiments.entities.Pays.collection_views.PaysCollectionView
  defaultDisplayType: TABLE
  customSortEnabled: false
  userDefinedSortEnabled: true
  displayGridAllowed: false
  displayListAllowed: true
  displayTableAllowed: true
  useCustomCollectionLabel: false
  childSteps:
    - _type: FormStep
      _name: Pays_Step
      label: Pays
      canFinishSubLevel: true
      enabledOnParentCreate: true
      enabledOnParentEdit: true
      formFieldsMode: AUTO
      enableMasterValuePicking: false
      formTab: Batiments.entities.Pays.forms.PaysForm.Pays
      formStepValidations: 
        - executedOnDataChange: true
          executedOnFormOpen: false
          validationType: MANDATORY
          attribute: Batiments.entities.Pays.Pays.nom
        - executedOnDataChange: true
          executedOnFormOpen: false
          validationType: MANDATORY
          attribute: Batiments.entities.Pays.Pays.iso2
        - executedOnDataChange: true
          executedOnFormOpen: false
          validationType: MANDATORY
          attribute: Batiments.entities.Pays.Pays.iso3
      stepTransitionValidations:
        - onStepExit: BLOCK
          validationType: MANDATORY
          attribute: Batiments.entities.Pays.Pays.nom
        - onStepExit: BLOCK
          validationType: MANDATORY
          attribute: Batiments.entities.Pays.Pays.iso2
        - onStepExit: BLOCK
          validationType: MANDATORY
          attribute: Batiments.entities.Pays.Pays.iso3