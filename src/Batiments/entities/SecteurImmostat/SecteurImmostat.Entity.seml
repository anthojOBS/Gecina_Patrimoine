    _name: SecteurImmostatCode
    label: Code Secteur Immostat
    physicalName: SECTEUR_IMMOSTAT_ID
    dataType: String
    length: 50
    mandatory: true
    searchable: true
  - _type: EntityAttribute
    _name: SecteurImmostatLibelle
    label: Libellé Secteur Immostat
    physicalName: LIBELLE
    dataType: String
    length: 255
    mandatory: false
    searchable: true
sourceIdGeneration:
