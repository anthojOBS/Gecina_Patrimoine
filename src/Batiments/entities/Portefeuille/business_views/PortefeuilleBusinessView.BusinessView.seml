_package: Batiments.entities.Portefeuille.business_views
_type: BusinessView
_name: PortefeuilleBusinessView
entity: Batiments.entities.Portefeuille.Portefeuille
rootLabel: Portefeuilles
rootPluralLabel: Portefeuilles
displayRootNodeAs: ICON_LABEL
label: Portefeuilles
rootBusinessViewEntity:
  _type: BusinessViewEntity
  _name: Portefeuille
  displayCard: Batiments.entities.Portefeuille.display_cards.PortefeuilleDisplayCard
  entity: Batiments.entities.Portefeuille.Portefeuille
  actionSet: Batiments.entities.Portefeuille.action_sets.PortefeuilleActionSet
  collection: Batiments.entities.Portefeuille.collection_views.PortefeuilleCollectionView
  form: Batiments.entities.Portefeuille.forms.PortefeuilleForm
  outlineVisible: false
  displayRecordCount: ALWAYS
  businessEntitySearchConfigs:
    - _name: TextConfig
      _type: BusinessEntitySearchTypeConfig
      searchType: TEXT
    # - _name: FormConfig
    #   _type: BusinessEntitySearchTypeConfig
    #   searchType: BY_FORM
    # - _name: AdvancedConfig
    #   _type: BusinessEntitySearchTypeConfig
    #   searchType: ADVANCED
    # - _name: SemqlConfig
    #   _type: BusinessEntitySearchTypeConfig
    #   searchType: SEMQL
  overrideDefaultSort: false
  enableUserDefinedSort: true
  listAllowed: true
  tableAllowed: true
  gridAllowed: true

  transitions:
    - _name: GoldenHistoryRecords
      _type: BusinessViewTransition
      displayFormTabAs: ICON_LABEL
      displayTransitionNodeAs: ICON_LABEL
      enableHierarchy: '0'
      enableHierarchyInterpreter: LITERAL
      expandHierarchyByDefault: false
      iconUrl: images://mdi/history.svg
      label: History
      pluralLabel: History
      transitionPath: GoldenHistoryRecords
      transitionType: FULLY_QUALIFIED
      transitionVisible: '1'
      transitionVisibleInterpreter: LITERAL
      useCustomLabel: true
      businessViewEntity: 
        _type: BusinessViewEntityReference
        ref: Batiments.entities.Portefeuille.business_views.PortefeuilleBusinessView.Portefeuille
      filter: 1 = 1
enableHierarchyView: false
useHierarchyOnOpen: false
