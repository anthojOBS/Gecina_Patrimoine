_package: Batiments.entities.Portefeuille.action_sets
_type: ActionSet
_name: PortefeuilleActionSet
entity: Batiments.entities.Portefeuille.Portefeuille
label: Portefeuille Action Set
defaultActionSet: true
actions:
  - _type: CreateAction
    _name: CreateAuthorPortefeuilles
    label: Create
    useCustomLabel: true
    stepper: Batiments.entities.Portefeuille.steppers.AuthorPortefeuilles
    createMultiple: false
    createdRecordType: GOLDEN
    waitDialogEnabled: false
    allowOtherPublishers: true
  - _type: EditAction
    _name: EditAuthorPortefeuilles
    label: Edit
    useCustomLabel: true
    stepper: Batiments.entities.Portefeuille.steppers.AuthorPortefeuilles
    multipleSelectionAllowed: true
    availableForGoldenData: true
    availableForMasterData: false
    availableForErrorData: true
    waitDialogEnabled: false
  - _type: MassUpdateAction
    _name: MassUpdateAuthorPortefeuilles
    label: Mass Update
    useCustomLabel: true
    stepper: Batiments.entities.Portefeuille.steppers.AuthorPortefeuilles
    availableForGoldenData: true
    availableForErrorData: true
    availableForMasterData: false
    waitDialogEnabled: false
  - _type: DeleteAction
    _name: Delete
    label: Delete
    useCustomLabel: true
    multipleSelectionAllowed: true
    deleteType: HARD_DELETE
    waitDialogEnabled: false
    availableForGoldenData: true
    availableForMasterData: false
  - _type: ExportAction
    _name: Export
    label: Export
    useCustomLabel: true
    waitDialogEnabled: false
  - _type: ImportAction
    _name: ImportAuthorPortefeuilles
    label: Import
    useCustomLabel: true
    importMode: CREATE_AND_UPDATE
    stepper: Batiments.entities.Portefeuille.steppers.AuthorPortefeuilles
    importedRecordType: GOLDEN
    waitDialogEnabled: false
    allowOtherPublishers: true
  - _type: BrowseGraphAction
    _name: BrowseGraph
    label: Browse Graph
    useCustomLabel: true
    waitDialogEnabled: false
