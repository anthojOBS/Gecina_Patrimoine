_package: Batiments.entities.TypeEnergie.action_sets
_type: ActionSet
_name: TypeEnergieActionSet
entity: Batiments.entities.TypeEnergie.TypeEnergie
label: Type d'énergie Action Set
defaultActionSet: true
actions:
  - _type: CreateAction
    _name: CreateAuthorTypeEnergie
    label: Create
    useCustomLabel: true
    stepper: Batiments.entities.TypeEnergie.steppers.AuthorTypeEnergie
    createMultiple: false
    createdRecordType: GOLDEN
    waitDialogEnabled: false
    allowOtherPublishers: true
  - _type: EditAction
    _name: EditAuthorPhases
    label: Edit
    useCustomLabel: true
    stepper: Batiments.entities.TypeEnergie.steppers.AuthorTypeEnergie
    multipleSelectionAllowed: true
    availableForGoldenData: true
    availableForMasterData: false
    availableForErrorData: true
    waitDialogEnabled: false
  - _type: MassUpdateAction
    _name: MassUpdateAuthorTypeEnergies
    label: Mass Update
    useCustomLabel: true
    stepper: Batiments.entities.TypeEnergie.steppers.AuthorTypeEnergie
    availableForGoldenData: true
    availableForErrorData: true
    availableForMasterData: false
    waitDialogEnabled: false
  - _type: DeleteAction
    _name: Delete
    label: Delete
    useCustomLabel: true
    multipleSelectionAllowed: true
    deleteType: HARD_DELETE
    waitDialogEnabled: false
    availableForGoldenData: true
    availableForMasterData: false
  - _type: ExportAction
    _name: Export
    label: Export
    useCustomLabel: true
    waitDialogEnabled: false
  - _type: ImportAction
    _name: ImportAuthorPhases
    label: Import
    useCustomLabel: true
    importMode: CREATE_AND_UPDATE
    stepper: Batiments.entities.TypeEnergie.steppers.AuthorTypeEnergie
    importedRecordType: GOLDEN
    waitDialogEnabled: false
    allowOtherPublishers: true
  - _type: BrowseGraphAction
    _name: BrowseGraph
    label: Browse Graph
    useCustomLabel: true
    waitDialogEnabled: false
