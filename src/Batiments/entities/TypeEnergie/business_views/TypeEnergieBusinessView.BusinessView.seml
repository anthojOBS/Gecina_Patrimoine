_package: Batiments.entities.TypeEnergie.business_views
_type: BusinessView
_name: TypeEnergieBusinessView
entity: Batiments.entities.TypeEnergie.TypeEnergie
rootLabel: Type d'énergie
rootPluralLabel: Type d'énergie
