label: Type d'énergie
rootBusinessViewEntity:
  _type: BusinessViewEntity
  _name: TypeEnergie
  displayCard: Batiments.entities.TypeEnergie.display_cards.TypeEnergieDisplayCard
  entity: Batiments.entities.TypeEnergie.TypeEnergie
  actionSet: Batiments.entities.TypeEnergie.action_sets.TypeEnergieActionSet
  collection: Batiments.entities.TypeEnergie.collection_views.TypeEnergieCollectionView
  form: Batiments.entities.TypeEnergie.forms.TypeEnergieForm
  outlineVisible: false
  displayRecordCount: ALWAYS
  businessEntitySearchConfigs:
    - _name: TextConfig
      _type: BusinessEntitySearchTypeConfig
      searchType: TEXT
    - _name: FormConfig
      _type: BusinessEntitySearchTypeConfig
      searchType: BY_FORM
    - _name: AdvancedConfig
      _type: BusinessEntitySearchTypeConfig
      searchType: ADVANCED
