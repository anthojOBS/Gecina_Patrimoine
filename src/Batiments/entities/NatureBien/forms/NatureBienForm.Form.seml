_package: Batiments.entities.NatureBien.forms
_type: Form
_name: NatureBienForm
entity: Batiments.entities.NatureBien.NatureBien
default: true
formTabs:
  - _type: FormTab
    _name: NatureBien
    label: Nature Bien
    documentationInterpreter: LITERAL
    visibleValue: "1"
    visibleValueInterpreter: LITERAL
    displayFormTabAs: LABEL
    content:
      - _type: IdField
        _name: Code
        value: Code
        useCustomLabel: false
        dataType: STRING
        labelProperties:
          typographyValueInterpreter: LITERAL
          typography: body-2
          color: md:black
          alignment: left
      - _type: TextField
        _name: Libelle
        value: Libelle
        useCustomLabel: false
        dataType: STRING
        labelProperties:
          typographyValueInterpreter: LITERAL
          typography: body-2
          color: md:black
