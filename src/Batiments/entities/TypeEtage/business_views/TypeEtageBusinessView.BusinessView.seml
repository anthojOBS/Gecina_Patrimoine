_package: Batiments.entities.TypeEtage.business_views
_type: BusinessView
_name: TypeEtageBusinessView
entity: Batiments.entities.TypeEtage.TypeEtage
rootLabel: Type d'Etages
rootPluralLabel: Type d'Etages 
displayRootNodeAs: ICON_LABEL
label: Type d'Etages
rootBusinessViewEntity:
  _type: BusinessViewEntity
  _name: TypeEtage
  displayCard: Batiments.entities.TypeEtage.display_cards.TypeEtageDisplayCard
  entity: Batiments.entities.TypeEtage.TypeEtage
  actionSet: Batiments.entities.TypeEtage.action_sets.TypeEtageActionSet
  collection: Batiments.entities.TypeEtage.collection_views.TypeEtageCollectionView
  form: Batiments.entities.TypeEtage.forms.TypeEtageForm
  outlineVisible: false
  displayRecordCount: ALWAYS
  businessEntitySearchConfigs:
    - _name: TextConfig
      _type: BusinessEntitySearchTypeConfig
      searchType: TEXT
    # - _name: FormConfig
    #   _type: BusinessEntitySearchTypeConfig
    #   searchType: BY_FORM
    # - _name: AdvancedConfig
    #   _type: BusinessEntitySearchTypeConfig
    #   searchType: ADVANCED
    # - _name: SemqlConfig
    #   _type: BusinessEntitySearchTypeConfig
    #   searchType: SEMQL
  overrideDefaultSort: false
  enableUserDefinedSort: true
  listAllowed: true
  tableAllowed: true
  gridAllowed: true

  transitions:
    - _name: GoldenHistoryRecords
      _type: BusinessViewTransition
      displayFormTabAs: ICON_LABEL
      displayTransitionNodeAs: ICON_LABEL
      enableHierarchy: '0'
      enableHierarchyInterpreter: LITERAL
      expandHierarchyByDefault: false
      iconUrl: images://mdi/history.svg
      label: History
      pluralLabel: History
      transitionPath: GoldenHistoryRecords
      transitionType: FULLY_QUALIFIED
      transitionVisible: '1'
      transitionVisibleInterpreter: LITERAL
      useCustomLabel: true
      businessViewEntity: 
        _type: BusinessViewEntityReference
        ref: Batiments.entities.TypeEtage.business_views.TypeEtageBusinessView.TypeEtage
      filter: 1 = 1
enableHierarchyView: false
useHierarchyOnOpen: false
