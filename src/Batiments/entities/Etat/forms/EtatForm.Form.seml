_package: Batiments.entities.Etat.forms
_type: Form
_name: EtatForm
entity: Batiments.entities.Etat.Etat
default: true
formTabs:
  - _type: FormTab
    _name: Etat
    label: Etat
    documentationInterpreter: LITERAL
    visibleValue: "1"
    visibleValueInterpreter: LITERAL
    displayFormTabAs: LABEL
    content:
      - _type: IdField
        _name: EtatCode
        value: EtatCode
        useCustomLabel: false
        dataType: STRING
        labelProperties:
          typographyValueInterpreter: LITERAL
          typography: body-2
          color: md:black
      - _type: TextField
        _name: EtatLibelle
        value: EtatLibelle
        useCustomLabel: false
        dataType: STRING
        labelProperties:
          typographyValueInterpreter: LITERAL
          typography: body-2
          color: md:black
