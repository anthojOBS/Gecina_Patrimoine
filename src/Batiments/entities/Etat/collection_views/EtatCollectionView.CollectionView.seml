tableColumns:
  - _type: IdColumn
    _name: EtatCode
    value: EtatCode
    useCustomLabel: false
    dataType: STRING
    columnAlign: LEFT
    visibleByDefault: true
  - _type: TextColumn
    _name: EtatLibelle
    value: EtatLibelle
    useCustomLabel: false
    dataType: STRING
    columnAlign: LEFT
    visibleByDefault: true

  - _type: TextColumn
    _name: UpdateDate
    value: UpdateDate
    useCustomLabel: false
    dataType: DATE
    columnAlign: LEFT
    visibleByDefault: true
    
  - _type: TextColumn
    _name: Updator
    value: Updator
    useCustomLabel: false
    dataType: STRING
    columnAlign: LEFT
    visibleByDefault: true

