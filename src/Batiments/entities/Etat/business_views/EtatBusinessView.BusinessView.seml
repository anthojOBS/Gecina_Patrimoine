_package: Batiments.entities.Etat.business_views
_type: BusinessView
_name: EtatBusinessView
entity: Batiments.entities.Etat.Etat
rootLabel: Etat
rootPluralLabel: Etat
displayRootNodeAs: ICON_LABEL
label: Etat
rootBusinessViewEntity:
  _type: BusinessViewEntity
  _name: Etat
  displayCard: Batiments.entities.Etat.display_cards.EtatDisplayCard
  entity: Batiments.entities.Etat.Etat
  actionSet: Batiments.entities.Etat.action_sets.EtatActionSet
  collection: Batiments.entities.Etat.collection_views.EtatCollectionView
  form: Batiments.entities.Etat.forms.EtatForm
  outlineVisible: false
  displayRecordCount: ALWAYS
  businessEntitySearchConfigs:
    - _name: TextConfig
      _type: BusinessEntitySearchTypeConfig
      searchType: TEXT
    # - _name: FormConfig
    #   _type: BusinessEntitySearchTypeConfig
    #   searchType: BY_FORM
    # - _name: AdvancedConfig
    #   _type: BusinessEntitySearchTypeConfig
    #   searchType: ADVANCED
    # - _name: SemqlConfig
    #   _type: BusinessEntitySearchTypeConfig
    #   searchType: SEMQL
  overrideDefaultSort: false
  enableUserDefinedSort: true
  listAllowed: true
  tableAllowed: true
  gridAllowed: true

  transitions:
    - _name: GoldenHistoryRecords
      _type: BusinessViewTransition
      displayFormTabAs: ICON_LABEL
      displayTransitionNodeAs: ICON_LABEL
      enableHierarchy: '0'
      enableHierarchyInterpreter: LITERAL
      expandHierarchyByDefault: false
      iconUrl: images://mdi/history.svg
      label: History
      pluralLabel: History
      transitionPath: GoldenHistoryRecords
      transitionType: FULLY_QUALIFIED
      transitionVisible: '1'
      transitionVisibleInterpreter: LITERAL
      useCustomLabel: true
      businessViewEntity: 
        _type: BusinessViewEntityReference
        ref: Batiments.entities.Etat.business_views.EtatBusinessView.Etat
      filter: 1 = 1
enableHierarchyView: false
useHierarchyOnOpen: false
