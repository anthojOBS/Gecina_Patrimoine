_package: Batiments.entities.Etat
_type: Entity
_name: Etat
label: Etat
pluralLabel: Etats
entityType: BASIC
physicalTableName: ETAT
iconUrl: images://mdi/timeline-text.svg
description: ""
documentation: |
  La **Etat** représente l'état d'avancement d'un actif immobilier dans son cycle de vie.
  
  Une Etat permet de suivre l'évolution d'un immeuble, d'un bâtiment ou d'un lot depuis sa conception jusqu'à son exploitation (en projet, en construction, livré, en exploitation, etc.).
  
  Cette entité est essentielle pour le pilotage des projets immobiliers et la gestion du portefeuille.
historizeGolden: true
historizeMaster: false
enableDelete: true
attributes:
  - _type: EntityAttribute
    _name: EtatCode
    label: Code Etat
    physicalName: ETAT_ID
    dataType: String
    length: 50
    mandatory: true
    searchable: true
  - _type: EntityAttribute
    _name: EtatLibelle
    label: Libellé Etat
    physicalName: LIBELLE
    dataType: String
    length: 255
    mandatory: false
    searchable: true
sourceIdGeneration:
  mode: MANUAL
primaryKey: Batiments.entities.Etat.Etat.EtatCode
