_package: Batiments.entities.LocalisationCompteur.forms
_type: Form
_name: LocalisationCompteurForm
entity: Batiments.entities.LocalisationCompteur.LocalisationCompteur
default: true
formTabs:
  - _type: FormTab
    _name: LocalisationCompteur
    label: Localisation compteur
    documentationInterpreter: LITERAL
    visibleValue: "1"
    visibleValueInterpreter: LITERAL
    displayFormTabAs: LABEL
    content:
      - _type: TextField
        _name: LocalisationCompteurCode 
        value: LocalisationCompteurCode 
        useCustomLabel: false
        dataType: STRING
        labelProperties:
          typographyValueInterpreter: LITERAL
          typography: body-2
          color: md:black
      - _type: TextField
        _name: LocalisationCompteurLibelle
        value: LocalisationCompteurLibelle
        useCustomLabel: false
        dataType: STRING
        labelProperties:
          typographyValueInterpreter: LITERAL
          typography: body-2
          color: md:black
