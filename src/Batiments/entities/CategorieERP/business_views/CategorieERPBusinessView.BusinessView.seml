_package: Batiments.entities.CategorieERP.business_views
_type: BusinessView
_name: CategorieERPBusinessView
entity: Batiments.entities.CategorieERP.CategorieERP
rootLabel: Catégorie ERP
rootPluralLabel: Catégories ERP
displayRootNodeAs: ICON_LABEL
label: Catégorie ERP
rootBusinessViewEntity:
  _type: BusinessViewEntity
  _name: CategorieERP
  displayCard: Batiments.entities.CategorieERP.display_cards.CategorieERPDisplayCard
  entity: Batiments.entities.CategorieERP.CategorieERP
  actionSet: Batiments.entities.CategorieERP.action_sets.CategorieERPActionSet
  collection: Batiments.entities.CategorieERP.collection_views.CategorieERPCollectionView
  form: Batiments.entities.CategorieERP.forms.CategorieERPForm
  outlineVisible: false
  displayRecordCount: ALWAYS
  businessEntitySearchConfigs:
    - _name: TextConfig
      _type: BusinessEntitySearchTypeConfig
      searchType: TEXT
    - _name: FormConfig
      _type: BusinessEntitySearchTypeConfig
      searchType: BY_FORM
    - _name: AdvancedConfig
      _type: BusinessEntitySearchTypeConfig
      searchType: ADVANCED
    - _name: SemqlConfig
      _type: BusinessEntitySearchTypeConfig
      searchType: SEMQL
  overrideDefaultSort: false
  enableUserDefinedSort: true
  listAllowed: true
  tableAllowed: true
  gridAllowed: true

  transitions:
    - _name: GoldenHistoryRecords
      _type: BusinessViewTransition
      displayFormTabAs: ICON_LABEL
      displayTransitionNodeAs: ICON_LABEL
      enableHierarchy: '0'
      enableHierarchyInterpreter: LITERAL
      expandHierarchyByDefault: false
      iconUrl: images://mdi/history.svg
      label: History
      pluralLabel: History
      transitionPath: GoldenHistoryRecords
      transitionType: FULLY_QUALIFIED
      transitionVisible: '1'
      transitionVisibleInterpreter: LITERAL
      useCustomLabel: true
      businessViewEntity: 
        _type: BusinessViewEntityReference
        ref: Batiments.entities.CategorieERP.business_views.CategorieERPBusinessView.CategorieERP
      filter: 1 = 1
enableHierarchyView: false
useHierarchyOnOpen: false
