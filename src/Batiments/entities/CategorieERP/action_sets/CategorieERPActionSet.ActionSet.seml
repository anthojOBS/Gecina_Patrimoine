_package: Batiments.entities.CategorieERP.action_sets
_type: ActionSet
_name: CategorieERPActionSet
entity: Batiments.entities.CategorieERP.CategorieERP
label: Catégorie ERP Action Set
defaultActionSet: true
actions:
  - _type: CreateAction
    _name: CreateAuthorCategorieERPs
    label: Create
    useCustomLabel: true
    stepper: Batiments.entities.CategorieERP.steppers.AuthorCategorieERP
    createMultiple: false
    createdRecordType: GOLDEN
    waitDialogEnabled: false
    allowOtherPublishers: true
  - _type: EditAction
    _name: EditAuthorCategorieERP
    label: Edit
    useCustomLabel: true
    stepper: Batiments.entities.CategorieERP.steppers.AuthorCategorieERP
    multipleSelectionAllowed: true
    availableForGoldenData: true
    availableForMasterData: false
    availableForErrorData: true
    waitDialogEnabled: false
  - _type: MassUpdateAction
    _name: MassUpdateAuthorCategorieERPs
    label: Mass Update
    useCustomLabel: true
    stepper: Batiments.entities.CategorieERP.steppers.AuthorCategorieERP
    availableForGoldenData: true
    availableForErrorData: true
    availableForMasterData: false
    waitDialogEnabled: false
  - _type: DeleteAction
    _name: Delete
    label: Delete
    useCustomLabel: true
    multipleSelectionAllowed: true
    deleteType: HARD_DELETE
    waitDialogEnabled: false
    availableForGoldenData: true
    availableForMasterData: false
  - _type: ExportAction
    _name: Export
    label: Export
    useCustomLabel: true
    waitDialogEnabled: false
  - _type: ImportAction
    _name: ImportAuthorCategorieERPs
    label: Import
    useCustomLabel: true
    importMode: CREATE_AND_UPDATE
    stepper: Batiments.entities.CategorieERP.steppers.AuthorCategorieERP
    importedRecordType: GOLDEN
    waitDialogEnabled: false
    allowOtherPublishers: true
  - _type: BrowseGraphAction
    _name: BrowseGraph
    label: Browse Graph
    useCustomLabel: true
    waitDialogEnabled: false
