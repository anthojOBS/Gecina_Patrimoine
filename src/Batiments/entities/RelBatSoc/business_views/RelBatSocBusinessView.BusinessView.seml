_package: Batiments.entities.RelBatSoc.business_views
_type: BusinessView
_name: RelBatSocBusinessView
entity: Batiments.entities.RelBatSoc.RelBatSoc
rootLabel: RelBatSocs
rootPluralLabel: RelBatSocs
label: RelBatSocs
enableHierarchyView: false
useHierarchyOnOpen: false
displayRootNodeAs: ICON_LABEL
rootBusinessViewEntity:
  _type: BusinessViewEntity
  _name: RelBatSoc
  displayCard: Batiments.entities.RelBatSoc.display_cards.RelBatSocDisplayCard
  entity: Batiments.entities.RelBatSoc.RelBatSoc
  actionSet: Batiments.entities.RelBatSoc.action_sets.RelBatSocActionSet
  collection: Batiments.entities.RelBatSoc.collection_views.RelBatSocCollectionView
  form: Batiments.entities.RelBatSoc.forms.RelBatSocForm
  outlineVisible: false
  displayRecordCount: ALWAYS
  businessEntitySearchConfigs:
    - _name: TextConfig
      _type: BusinessEntitySearchTypeConfig
      searchType: TEXT
    - _name: FormConfig
      _type: BusinessEntitySearchTypeConfig
      searchType: BY_FORM
    - _name: AdvancedConfig
      _type: BusinessEntitySearchTypeConfig
      searchType: ADVANCED
    - _name: SemqlConfig
      _type: BusinessEntitySearchTypeConfig
      searchType: SEMQL
  overrideDefaultSort: false
  enableUserDefinedSort: true
  listAllowed: true
  tableAllowed: true
  gridAllowed: true

  transitions:
    - _type: BusinessViewTransition
      _name: MasterRecords
      displayFormTabAs: ICON_LABEL
      useCustomLabel: false
      enableHierarchyInterpreter: LITERAL
      filter: 1=1
      iconUrl: images://mdi/puzzle.svg
      label: Masters Records
      pluralLabel: Masters Records
      transitionType: FULLY_QUALIFIED
      transitionPath:  MasterRecords 
      businessViewEntity: 
        _type: BusinessViewEntity
        _name: MasterRecord
        displayCard: Batiments.entities.Lot.display_cards.LotDisplayCard
        entity: Batiments.entities.Lot.Lot
        actionSet: Batiments.entities.Lot.action_sets.LotActionSet
        collection: Batiments.entities.Lot.collection_views.LotCollectionView
        form: Batiments.entities.Lot.forms.LotForm
        displayRecordCount: ALWAYS
        outlineVisible: false
        enableUserDefinedSort: true
        gridAllowed: true
        listAllowed: true
        overrideDefaultSort: false
        tableAllowed: true

    - _name: GoldenHistoryRecords
      _type: BusinessViewTransition
      displayFormTabAs: ICON_LABEL
      displayTransitionNodeAs: ICON_LABEL
      enableHierarchy: '0'
      enableHierarchyInterpreter: LITERAL
      expandHierarchyByDefault: false
      iconUrl: images://mdi/history.svg
      label: History
      pluralLabel: History
      transitionPath: GoldenHistoryRecords
      transitionType: FULLY_QUALIFIED
      transitionVisible: '1'
      transitionVisibleInterpreter: LITERAL
      useCustomLabel: true
      businessViewEntity: 
        _type: BusinessViewEntityReference
        ref: Batiments.entities.RelBatSoc.business_views.RelBatSocBusinessView.RelBatSoc
      filter: 1 = 1