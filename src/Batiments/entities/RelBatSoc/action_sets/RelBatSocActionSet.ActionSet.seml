_package: Batiments.entities.RelBatSoc.action_sets
_type: ActionSet
_name: RelBatSocActionSet
entity: Batiments.entities.RelBatSoc.RelBatSoc
label: RelBatSoc Action Set
defaultActionSet: true
actions:
  - _type: CreateAction
    _name: CreateAuthorRelBatSoc
    label: Create
    useCustomLabel: true
    stepper: Batiments.entities.RelBatSoc.steppers.AuthorRelBatSoc
    createMultiple: false
    createdRecordType: GOLDEN
    waitDialogEnabled: false
    allowOtherPublishers: true
  - _type: EditAction
    _name: EditAuthorRelBatSoc
    label: Edit
    useCustomLabel: true
    stepper: Batiments.entities.RelBatSoc.steppers.AuthorRelBatSoc
    multipleSelectionAllowed: true
    availableForGoldenData: true
    availableForMasterData: true
    availableForErrorData: true
    waitDialogEnabled: false
  - _type: DeleteAction
    _name: Delete
    label: Delete
    useCustomLabel: true
    multipleSelectionAllowed: true
    deleteType: HARD_DELETE
    waitDialogEnabled: false
    availableForGoldenData: true
    availableForMasterData: true
  - _type: ExportAction
    _name: Export
    label: Export
    useCustomLabel: true
    waitDialogEnabled: false
  - _type: ImportAction
    _name: ImportAuthorRelBatSoc
    label: Import
    useCustomLabel: true
    importMode: CREATE_AND_UPDATE
    stepper: Batiments.entities.RelBatSoc.steppers.AuthorRelBatSoc
    importedRecordType: MASTER
    waitDialogEnabled: false
    allowOtherPublishers: true
  - _type: BrowseGraphAction
    _name: BrowseGraph
    label: Browse Graph
    useCustomLabel: true
    waitDialogEnabled: false
  - _type: DirectConfirmDupsAction
    _name: DirectConfirmDuplicates
    label: Direct Confirm Duplicates
    useCustomLabel: false
    waitDialogEnabled: false
  - _type: ReviewAndConfirm
    _name: ReviewAndConfirmDuplicatesManageDuplicatesOnRelBatSoc
    label: Review and Confirm Duplicates
    useCustomLabel: true
    dupsManager: Batiments.entities.RelBatSoc.dups_managers.ManageDuplicatesOnRelBatSoc
    enableEdit: true
    mandateConfirmAll: false
    waitDialogEnabled: false
  - _type: MergeOrSplit
    _name: MergeOrSplitDuplicatesManageDuplicatesOnRelBatSoc
    label: Merge Or Split Duplicates
    useCustomLabel: true
    dupsManager: Batiments.entities.RelBatSoc.dups_managers.ManageDuplicatesOnRelBatSoc
    enableEdit: true
    waitDialogEnabled: false
  - _type: ReviewSuggestions
    _name: ReviewSuggestionsDuplicatesManageDuplicatesOnRelBatSoc
    label: Review Duplicates Suggestions
    useCustomLabel: true
    dupsManager: Batiments.entities.RelBatSoc.dups_managers.ManageDuplicatesOnRelBatSoc
    enableEdit: true
    waitDialogEnabled: false
    onAcceptPromptGoldenId: false
    mandateResolveAllSuggestions: false
  - _type: ExplainRecordAction
    _name: ExplainRecord
    label: Explain Record
    useCustomLabel: true
    displayCard: Batiments.entities.RelBatSoc.display_cards.RelBatSocDisplayCard
    formTab: Batiments.entities.RelBatSoc.forms.RelBatSocForm.RelBatSoc
    waitDialogEnabled: false
