_package: Batiments.entities.RelImmSoc.validations
_name: CheckSocieteProprio_count
_type: SemQLValidation
entity: Batiments.entities.RelImmSoc.RelImmSoc
label: Société propriétaire nombre de société 
condition: (FID_TypeSociete = '1' and (NbSocProprio = 1 or NbSocProprio = 2)) or FID_TypeSociete = '2'  or FID_TypeSociete is null or NbSocProprio is null
