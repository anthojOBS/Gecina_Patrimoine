_package: Batiments.entities.RelImmSoc.forms
_type: Form
_name: RelImmSocForm
entity: Batiments.entities.RelImmSoc.RelImmSoc
default: true
formTabs:
  - _type: FormTab
    _name: RelImmSoc
    label: Société 
    documentationInterpreter: LITERAL
    visibleValue: "1"
    visibleValueInterpreter: LITERAL
    displayFormTabAs: LABEL
    labelWidth: 200px
    content:
      - _type: ReferenceField
        _name: FDN_TypeSociete
        value: FDN_TypeSociete
        label: Type société
        labelProperties:
          alignment: left
          typography: body-2
          color: md:black
        useCustomLabel: true
        dataType: STRING
        referencedEntity: Batiments.entities.TypeSociete.TypeSociete


      - _type: ReferenceField
        _name: FDN_Societe
        value: FDN_Societe
        label: Société
        labelProperties:
          alignment: left
          typography: body-2
          color: md:black
        useCustomLabel: true
        dataType: STRING
        referencedEntity: Batiments.entities.Societe.Societe


      - _type: DateField
        _name: DateDebSociete
        value: DateDebSociete
        label: Date debut société
        labelProperties:
          alignment: left
          typographyValueInterpreter: LITERAL
          typography: body-2
          color: md:black
        componentProperties:                 
          displayFormat: dd/MM/yyyy                
          displayFormatValueInterpreter: LITERAL            
          editingFormat: dd/MM/yyyy                 
          editingFormatValueInterpreter: LITERAL
        useCustomLabel: true
        visibleValue:  DateDebSociete is not null 
        visibleValueInterpreter: SEMQL
        dataType: DATE


      - _type: DateField
        _name: DateFinSociete
        value: DateFinSociete
        label: Date fin société
        labelProperties:
          alignment: left
          typographyValueInterpreter: LITERAL
          typography: body-2
          color: md:black
        componentProperties:                 
          displayFormat: dd/MM/yyyy                
          displayFormatValueInterpreter: LITERAL            
          editingFormat: dd/MM/yyyy                 
          editingFormatValueInterpreter: LITERAL
        useCustomLabel: true
        visibleValue:  DateFinSociete is not null 
        visibleValueInterpreter: SEMQL
        dataType: DATE

