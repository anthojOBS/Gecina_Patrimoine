_package: Batiments.entities.RelImmSoc
_type: Entity
_name: RelImmSoc
label: Relation immeuble société
pluralLabel: Relation immeuble société
entityType: FUZZY_MATCHED
physicalTableName: REL_IMM_SOC
iconUrl: images://mdi/floor-plan.svg
description: ""
documentation: ""
historizeGolden: true
historizeMaster: true
enableDelete: true
attributes:
  - _type: EntityAttribute
    _name: RelImmSocCode
    label: Relation immeuble société Code
    physicalName: REL_IMM_SOC_CODE
    dataType: LongInteger
    precision: 38
    mandatory: true
    searchable: true


  - _type: EntityAttribute
    _name: DateDebSociete
    label: Date début société
    physicalName: DATE_DEB_SOCIETE
    dataType: Date
    mandatory: true
    mandatoryValidationLabel: "Date début sciété est obligatoire"
    mandatoryValidationScope: POST_CONSO

  - _type: EntityAttribute
    _name: DateFinSociete
    label: Date fin société
    physicalName: DATE_FIN_SOCIETE
    dataType: Date
    mandatory: false

sourceIdGeneration:
  mode: MANUAL

primaryKey: Batiments.entities.RelImmSoc.RelImmSoc.RelImmSocCode

goldenIdGeneration:
  mode: SEQUENCE
  startWith: 1

matcher:
  _type: SemQLMatcher
  _name: Matcher
  description: BatimentSemQLMatcher
  matchRules:
    - _type: SemQLMatchRule
      _name: NewRule
      label: NewRuleLabel
      condition:   Record1.FID_Immeuble = Record2.FID_Immeuble and Record1.FID_TypeSociete = Record2.FID_TypeSociete and Record1.FID_Societe = Record2.FID_Societe
 
      matchScore: 100
      usingMatchOn: false
  useTransitiveMatchScore: true
  useMultiIterationGrouping: true
  mergeThresholdNewGroup: 90
  mergeThresholdMergingUnconfirmed: 90
  mergeThresholdMergingConfirmed: 90
  mergeThresholdMergingConfirmedWithUnconfirmed: 90
  mergeThresholdMergingUnconfirmedWithNewMasters: 90
  mergeThresholdMergingConfirmedWithNewMasters: 90
  mergeThresholdRemergingPreviouslySplit: 100
  autoConfirmGoldenThreshold: 99
  autoConfirmSingletons: false