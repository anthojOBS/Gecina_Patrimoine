attributes:
  - _type: EntityAttribute
    _name: RelImmSocCode
    label: RelImmSoc Code
    physicalName: REL_IMM_SOC_CODE
    dataType: LongInteger
    precision: 38
    mandatory: true
    searchable: true
    
sourceIdGeneration:
  mode: MANUAL

