_package: Batiments.entities.RelImmSoc.collection_views
_type: CollectionView
_name: RelImmSocCollectionView
entity: Batiments.entities.RelImmSoc.RelImmSoc
default: true
displayCard: Batiments.entities.RelImmSoc.display_cards.RelImmSocDisplayCard
gridAllowed: false
gridColumns: 4
gridTextPosition: BOTTOM
gridTileHeight: 1:1
gridTileLines: 1
listAllowed: true
listItemLines: 1
listShowDisplayCardAvatar: false
listShowDivider: true
tableAllowed: true
tableDisplayCardColumnLabel: Relation société
tableRowLines: 1
tableShowDisplayCard: false
tableColumns:
  - _type: IdColumn
    _name: RelImmSocCode
    value: RelImmSocCode
    useCustomLabel: false
    dataType: LONG_INTEGER
    columnAlign: LEFT
    visibleByDefault: false
  - _type: ReferenceColumn
    _name: FDN_Immeuble
    value: FDN_Immeuble
    useCustomLabel: false
    dataType: STRING
    columnAlign: LEFT
    visibleByDefault: false
    referencedEntity: Batiments.entities.Immeuble.Immeuble
  - _type: ReferenceColumn
    _name: FDN_TypeSociete
    value: FDN_TypeSociete
    useCustomLabel: true
    label: Type société
    dataType: STRING
    columnAlign: LEFT
    visibleByDefault: true
    referencedEntity: Batiments.entities.TypeSociete.TypeSociete
  - _type: ReferenceColumn
    _name: FDN_Societe 
    value: FDN_Societe
    useCustomLabel: true
    label: Société
    dataType: STRING
    columnAlign: LEFT
    visibleByDefault: true
    referencedEntity: Batiments.entities.Societe.Societe
  - _type: TextColumn
    _name: DateDebSociete
    value: DateDebSociete
    useCustomLabel: false
    componentProperties:                 
          displayFormat: dd/MM/yyyy                
          displayFormatValueInterpreter: LITERAL            
