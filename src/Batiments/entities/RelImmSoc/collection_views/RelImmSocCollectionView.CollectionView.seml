    columnAlign: LEFT
    visibleByDefault: true

  - _type: TextColumn
    _name: DateFinSociete
    value: DateFinSociete
    useCustomLabel: false
    componentProperties:                 
          displayFormat: dd/MM/yyyy                
          displayFormatValueInterpreter: LITERAL            
    dataType: DATE
    columnAlign: LEFT
    visibleByDefault: false