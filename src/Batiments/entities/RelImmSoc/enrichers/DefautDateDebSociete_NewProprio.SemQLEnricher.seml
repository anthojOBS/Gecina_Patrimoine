_package: Batiments.entities.RelImmSoc.enrichers
_name: DefautDateDebSociete_NewProprio
_type: SemQLEnricher
entity: Batiments.entities.RelImmSoc.RelImmSoc
label: Alimentation par défaut de la date début société
enricherExecutionScope: NONE
afterEnrichers: Batiments.entities.RelImmSoc.enrichers.DefautDateDebSociete

semQlEnricherExpressions: 
  - attributeName: DateDebSociete 
    expression: CURRENT_DATE()
condition: GoldenRecord.FID_TypeSociete is null and FID_TypeSociete = '1'