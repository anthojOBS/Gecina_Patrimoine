_package: Batiments.entities.Equipementier.action_sets
_type: ActionSet
_name: EquipementierActionSet
entity: Batiments.entities.Equipementier.Equipementier
label: Equipementier Action Set
defaultActionSet: true
actions:
  - _type: CreateAction
    _name: CreateAuthorEquipementier
    label: Création
    useCustomLabel: true
    stepper: Batiments.entities.Equipementier.steppers.AuthorEquipementier
    createMultiple: false
    createdRecordType: GOLDEN
    waitDialogEnabled: false
    allowOtherPublishers: true
  - _type: EditAction
    _name: EditAuthorEquipementier
    label: Modification
    useCustomLabel: true
    stepper: Batiments.entities.Equipementier.steppers.AuthorEquipementier
    multipleSelectionAllowed: true
    availableForGoldenData: true
    availableForMasterData: false
    availableForErrorData: true
    waitDialogEnabled: false
  - _type: MassUpdateAction
    _name: MassUpdateAuthorEquipementier
    label: Mise à jour en masse
    useCustomLabel: true
    stepper: Batiments.entities.Equipementier.steppers.AuthorEquipementier
    availableForGoldenData: true
    availableForErrorData: true
    availableForMasterData: false
    waitDialogEnabled: false
  - _type: DeleteAction
    _name: Delete
    label: Supprimer
    useCustomLabel: true
    multipleSelectionAllowed: true
    deleteType: HARD_DELETE
    waitDialogEnabled: false
    availableForGoldenData: true
    availableForMasterData: false
    requiredRole: semarchyAdmin
  - _type: ExportAction
    _name: Export
    label: Exporter
    useCustomLabel: true
    waitDialogEnabled: false
  - _type: ImportAction
    _name: ImportAuthorEquipementier
    label: Importer
    useCustomLabel: true
    importMode: CREATE_AND_UPDATE
    stepper: Batiments.entities.Equipementier.steppers.AuthorEquipementier
    importedRecordType: GOLDEN
    waitDialogEnabled: false
    allowOtherPublishers: true
