_package: Batiments.entities.Equipementier.business_views
_type: BusinessView
_name: EquipementierBusinessView
entity: Batiments.entities.Equipementier.Equipementier
rootLabel: Equipementier
rootPluralLabel: Equipementier
displayRootNodeAs: ICON_LABEL
label: Equipementier
rootBusinessViewEntity:
  _type: BusinessViewEntity
  _name: Equipementier
  displayCard: Batiments.entities.Equipementier.display_cards.EquipementierDisplayCard
  entity: Batiments.entities.Equipementier.Equipementier
  actionSet: Batiments.entities.Equipementier.action_sets.EquipementierActionSet
  collection: Batiments.entities.Equipementier.collection_views.EquipementierCollectionView
  form: Batiments.entities.Equipementier.forms.EquipementierForm
  outlineVisible: false
  displayRecordCount: ALWAYS
  businessEntitySearchConfigs:
    - _name: TextConfig
      _type: BusinessEntitySearchTypeConfig
      searchType: TEXT
    - _name: FormConfig
      _type: BusinessEntitySearchTypeConfig
      searchType: BY_FORM
    - _name: AdvancedConfig
      _type: BusinessEntitySearchTypeConfig
      searchType: ADVANCED
    - _name: SemqlConfig
      _type: BusinessEntitySearchTypeConfig
      searchType: SEMQL
  overrideDefaultSort: false
  enableUserDefinedSort: true
  listAllowed: true
  tableAllowed: true
  gridAllowed: true

  transitions:
    - _name: GoldenHistoryRecords
      _type: BusinessViewTransition
      displayFormTabAs: ICON_LABEL
      displayTransitionNodeAs: ICON_LABEL
      enableHierarchy: '0'
      enableHierarchyInterpreter: LITERAL
      expandHierarchyByDefault: false
      iconUrl: images://mdi/history.svg
      label: History
      pluralLabel: History
      transitionPath: GoldenHistoryRecords
      transitionType: FULLY_QUALIFIED
      transitionVisible: '1'
      transitionVisibleInterpreter: LITERAL
      useCustomLabel: true
      businessViewEntity: 
        _type: BusinessViewEntityReference
        ref: Batiments.entities.Equipementier.business_views.EquipementierBusinessView.Equipementier
      filter: 1 = 1
enableHierarchyView: false
useHierarchyOnOpen: false
