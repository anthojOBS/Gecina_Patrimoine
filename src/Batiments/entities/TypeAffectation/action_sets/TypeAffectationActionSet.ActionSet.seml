_package: Batiments.entities.TypeAffectation.action_sets
_type: ActionSet
_name: TypeAffectationActionSet
entity: Batiments.entities.TypeAffectation.TypeAffectation
label: Type d'affectation Action Set
defaultActionSet: true
actions:
  - _type: CreateAction
    _name: CreateAuthorTypeAffectation
    label: Création
    useCustomLabel: true
    stepper: Batiments.entities.TypeAffectation.steppers.AuthorTypeAffectation
    createMultiple: false
    createdRecordType: GOLDEN
    waitDialogEnabled: false
    allowOtherPublishers: true
  - _type: EditAction
    _name: EditAuthorTypeAffectation
    label: Modification
    useCustomLabel: true
    stepper: Batiments.entities.TypeAffectation.steppers.AuthorTypeAffectation
    multipleSelectionAllowed: true
    availableForGoldenData: true
    availableForMasterData: false
    availableForErrorData: true
    waitDialogEnabled: false

  - _type: DeleteAction
    _name: Delete
    label: Supprimer
    useCustomLabel: true
    multipleSelectionAllowed: true
    deleteType: HARD_DELETE
    waitDialogEnabled: false
    availableForGoldenData: true
    availableForMasterData: false
    requiredRole: semarchyAdmin
  - _type: ExportAction
    _name: Export
    label: Exporter
    useCustomLabel: true
    waitDialogEnabled: false
  - _type: ImportAction
    _name: ImportAuthorTypeAffectation
    label: Importer
    useCustomLabel: true
    importMode: CREATE_AND_UPDATE
    stepper: Batiments.entities.TypeAffectation.steppers.AuthorTypeAffectation
    importedRecordType: GOLDEN
    waitDialogEnabled: false
    allowOtherPublishers: true
