_package: Batiments.entities.TypeVente.business_views
_type: BusinessView
_name: TypeVenteBusinessView
entity: Batiments.entities.TypeVente.TypeVente
rootLabel: Type vente
rootPluralLabel: Type vente
displayRootNodeAs: ICON_LABEL
label: Type vente
rootBusinessViewEntity:
  _type: BusinessViewEntity
  _name: TypeVente
  displayCard: Batiments.entities.TypeVente.display_cards.TypeVenteDisplayCard
  entity: Batiments.entities.TypeVente.TypeVente
  actionSet: Batiments.entities.TypeVente.action_sets.TypeVenteActionSet
  collection: Batiments.entities.TypeVente.collection_views.TypeVenteCollectionView
  form: Batiments.entities.TypeVente.forms.TypeVenteForm
  outlineVisible: false
  displayRecordCount: ALWAYS
  businessEntitySearchConfigs:
    - _name: TextConfig
      _type: BusinessEntitySearchTypeConfig
      searchType: TEXT
    - _name: FormConfig
      _type: BusinessEntitySearchTypeConfig
      searchType: BY_FORM
    - _name: AdvancedConfig
      _type: BusinessEntitySearchTypeConfig
      searchType: ADVANCED
    - _name: SemqlConfig
      _type: BusinessEntitySearchTypeConfig
      searchType: SEMQL
  overrideDefaultSort: false
  enableUserDefinedSort: true
  listAllowed: true
  tableAllowed: true
  gridAllowed: true

  transitions:
    - _name: GoldenHistoryRecords
      _type: BusinessViewTransition
      displayFormTabAs: ICON_LABEL
      displayTransitionNodeAs: ICON_LABEL
      enableHierarchy: '0'
      enableHierarchyInterpreter: LITERAL
      expandHierarchyByDefault: false
      iconUrl: images://mdi/history.svg
      label: History
      pluralLabel: History
      transitionPath: GoldenHistoryRecords
      transitionType: FULLY_QUALIFIED
      transitionVisible: '1'
      transitionVisibleInterpreter: LITERAL
      useCustomLabel: true
      businessViewEntity: 
        _type: BusinessViewEntityReference
        ref: Batiments.entities.TypeVente.business_views.TypeVenteBusinessView.TypeVente
      filter: 1 = 1
enableHierarchyView: false
useHierarchyOnOpen: false
