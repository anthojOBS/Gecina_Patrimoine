_package: Batiments.entities.Etage.forms
_type: Form
_name: EtageForm
entity: Batiments.entities.Etage.Etage
default: true
formTabs:
  - _type: FormTab
    _name: Etage
    label: Etage
    documentationInterpreter: LITERAL
    visibleValue: "1"
    visibleValueInterpreter: LITERAL
    displayFormTabAs: ICON_LABEL
    labelWidth: 200px
    content:
      - _type: TextField
        _name: Libelle
        value: Libelle
        label: Libellé
        useCustomLabel: false
        dataType: STRING
        labelProperties:
          typographyValueInterpreter: LITERAL
          typography: body-2
          color: md:black

      - _type: TextField
        _name: SuperficieBalcons
        value: SuperficieBalcons
        useCustomLabel: false
        dataType: DECIMAL
        labelProperties:
          typographyValueInterpreter: LITERAL
          typography: body-2
          color: md:black

      - _type: TextField
        _name: SuperficieTerrasses
        value: SuperficieTerrasses
        useCustomLabel: false
        dataType: DECIMAL
        labelProperties:
          typographyValueInterpreter: LITERAL
          typography: body-2
          color: md:black

      - _type: TextField
        _name: SuperficieJardins
        value: SuperficieJardins
        useCustomLabel: false
        dataType: DECIMAL
        labelProperties:
          typographyValueInterpreter: LITERAL
          typography: body-2
          color: md:black