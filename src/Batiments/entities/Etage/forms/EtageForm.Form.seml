_package: Batiments.entities.Etage.forms
_type: Form
_name: EtageForm
entity: Batiments.entities.Etage.Etage
default: true
formTabs:
  - _type: FormTab
    _name: Etage
    label: Etage
    documentationInterpreter: LITERAL
    visibleValue: "1"
    visibleValueInterpreter: LITERAL
    displayFormTabAs: ICON_LABEL
    labelWidth: 200px
    content:
      # - _type: TextField
      #   _name: Libelle
      #   value: Libelle
      #   label: Libellé
      #   useCustomLabel: false
      #   dataType: STRING
      #   labelProperties:
      #     typographyValueInterpreter: LITERAL
      #     typography: body-2
      #     color: md:black

      - _type: TextField
        _name: FDN_TypeEtage
        value: FDN_TypeEtage
        label: Libellé
        authoringMode: case when FID_TypeEtage is null then 'auto' else 'force-read-only' end
        authoringModeValueInterpreter: SEMQL
        visibleValue: '1'
        visibleValueInterpreter: LITERAL
        useCustomLabel: true
        dataType: STRING
        labelProperties:
          typographyValueInterpreter: LITERAL
          typography: body-2
          color: md:black

      - _type: TextField
        _name: SuperficieBalcons
        value: SuperficieBalcons
        visibleValue: Batiment.Immeuble.FID_OrgaResp = 'DB'
        visibleValueInterpreter: SEMQL
        useCustomLabel: false
        dataType: DECIMAL
        labelProperties:
          typographyValueInterpreter: LITERAL
          typography: body-2
          color: md:black

      - _type: TextField
        _name: SuperficieTerrasses
        value: SuperficieTerrasses
        visibleValue: Batiment.Immeuble.FID_OrgaResp = 'DB'
        visibleValueInterpreter: SEMQL
        useCustomLabel: false
        dataType: DECIMAL
        labelProperties:
          typographyValueInterpreter: LITERAL
          typography: body-2
          color: md:black

      - _type: TextField
        _name: SuperficieJardins
        value: SuperficieJardins
        visibleValue: Batiment.Immeuble.FID_OrgaResp = 'DB'
        visibleValueInterpreter: SEMQL
        useCustomLabel: false
        dataType: DECIMAL
        labelProperties:
          typographyValueInterpreter: LITERAL
          typography: body-2
          color: md:black