_package: Batiments.entities.Etage.action_sets
_type: ActionSet
_name: EtageActionSet
entity: Batiments.entities.Etage.Etage
label: Etage Action Set
defaultActionSet: true
actions:
  - _type: CreateAction
    _name: CreateAuthorEtages
    label: Création étage
    useCustomLabel: true
    stepper: Batiments.entities.Etage.steppers.EtageCreation
    createMultiple: true
    createdRecordType: GOLDEN
    waitDialogEnabled: false
    allowOtherPublishers: true
  - _type: EditAction
    _name: EditAuthorEtages
    label: Modification étage
    useCustomLabel: true
    stepper: Batiments.entities.Etage.steppers.EtageSuperficie
    multipleSelectionAllowed: true
    availableForGoldenData: true
    availableForMasterData: true
    availableForErrorData: true
    waitDialogEnabled: false
 
  - _type: DeleteAction
    _name: Delete
    label: Delete
    useCustomLabel: true
    multipleSelectionAllowed: true
    deleteType: HARD_DELETE
    waitDialogEnabled: false
    availableForGoldenData: true
    availableForMasterData: true
    requiredRole: semarchyAdmin
  - _type: ExportAction
    _name: Export
    label: Exporter
    useCustomLabel: true
    waitDialogEnabled: false
  - _type: ImportAction
    _name: ImportAuthorEtages
    label: Importer
    useCustomLabel: true
    importMode: CREATE_AND_UPDATE
    stepper: Batiments.entities.Etage.steppers.Etage_import
    importedRecordType: MASTER
    waitDialogEnabled: false
    allowOtherPublishers: true
  - _type: ExplainRecordAction
    _name: ExplainRecord
    label: Expliquer l'enregistrement
    useCustomLabel: true
    displayCard: Batiments.entities.Etage.display_cards.EtageDisplayCard
    formTab: Batiments.entities.Etage.forms.EtageForm.Etage
    waitDialogEnabled: false
