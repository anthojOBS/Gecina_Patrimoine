_package: Batiments.entities.Lot.validations
_name: CheckCoherenceTypo_Genre
_type: SemQLValidation
entity: Batiments.entities.Lot.Lot
label: Coherence typologie / genre
condition: FID_TypologieLot is null or (FID_GenreLot is not null and FID_TypologieLot is not null
 and FID_TypologieLot = GenreLot.FID_TypologieLot and FID_GenreLot = GenreLot.GenreLotCode)
validationScope: NONE
validationLabel: Typologie du lot et genre du lot non cohérent
