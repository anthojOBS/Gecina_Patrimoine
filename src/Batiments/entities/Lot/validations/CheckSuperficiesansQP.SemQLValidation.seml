_package: Batiments.entities.Lot.validations
_name: CheckSuperficiesansQP
_type: SemQLValidation
entity: Batiments.entities.Lot.Lot
label: Superficie utile sans QP obligatoire 
condition:  (FID_TypologieLot = 'PL'  and SuperficieUtileSansQP is not null) or FID_TypologieLot != 'PL'  or FID_TypologieLot is null
validationScope: POST_CONSO
validationLabel: Superficie utile sans QP doit être renseigné si la typologie du lot est un plateau.
