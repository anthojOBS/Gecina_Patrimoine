_package: Batiments.entities.Lot
_type: Entity
_name: Lot
label: Lot
pluralLabel: Lots
entityType: FUZZY_MATCHED
physicalTableName: LOT
iconUrl: images://mdi/floor-plan.svg
description: ""
documentation: |
  Le **Lot** représente une unité locative ou de copropriété au sein d'un étage.
  
  Un lot est la plus petite unité de gestion du patrimoine immobilier. Il est caractérisé par son genre de bien (commercial, résidentiel, etc.), son usage (habitation, bureau, commerce, etc.) et sa surface.
  
  Cette entité permet de gérer finement les espaces locatifs et de suivre leur occupation et leur rentabilité.
historizeGolden: true
historizeMaster: true
enableDelete: true
attributes:
  - _type: EntityAttribute
    _name: LotCode
    label: Lot Code
    physicalName: LOT_CODE
    dataType: LongInteger
    precision: 38
    mandatory: true
    searchable: true
  - _type: EntityAttribute
    _name: IdentifiantREF
    label: Identifiant REF
    physicalName: IDENTIFIANT_REF
    dataType: String
    length: 100
    mandatory: false
    searchable: true
  - _type: EntityAttribute
    _name: IdentifiantsERP
    label: Identifiants ERP
    physicalName: IDENTIFIANTS_ERP
    dataType: String
    length: 100
    mandatory: false
  - _type: EntityAttribute
    _name: Libelle
    label: Libellé lot
    physicalName: LIBELLE
    dataType: String
    length: 255
    mandatory: false
    searchable: true
  - _type: EntityAttribute
    _name: Usage
    label: Usage
    physicalName: USAGE_LOT
    dataType: String
    length: 150
    mandatory: false
  - _type: EntityAttribute
    _name: SuperficieUtile
