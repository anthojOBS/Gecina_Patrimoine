    precision: 15
    scale: 2
    mandatory: false
  - _type: EntityAttribute
    _name: SuperficieUtilePonderee
    label: Superficie Utile pondérée
    physicalName: SUPERFICIE_UTILE_PONDEREE
    dataType: Decimal
    precision: 15
    scale: 2
    mandatory: false
  - _type: EntityAttribute
    _name: IdentifiantPhysique
    label: Identifiant physique
    physicalName: IDENTIFIANT_PHYSIQUE
    dataType: String
    length: 150
    mandatory: false

  - _type: EntityAttribute
    _name: DateDebUsage
    label: Date début usage
