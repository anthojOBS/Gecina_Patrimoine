    mandatory: false

  - _type: EntityAttribute
    _name: StatutERP
    label: Statut ERP
    physicalName: STATUT_ERP
    dataType: Boolean
    mandatory: false

  - _type: EntityAttribute
    _name: StatutLouable
    label: Statut louable
    physicalName: STATUT_LOUABLE
    dataType: Boolean
    mandatory: false

  - _type: EntityAttribute
    _name: StatutSousLocation
    label: Statut sous-location
    physicalName: STATUT_SOUS_LOCATION
    dataType: Boolean
