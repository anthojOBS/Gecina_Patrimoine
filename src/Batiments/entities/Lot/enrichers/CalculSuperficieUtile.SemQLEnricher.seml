_package: Batiments.entities.Lot.enrichers
_name: CalculSuperficieUtile
_type: SemQLEnricher
entity: Batiments.entities.Lot.Lot
label: Calcul Superficie Utile
enricherExecutionScope: POST_CONSO
semQlEnricherExpressions: 
  - attributeName: SuperficieUtileQP
    expression: case when FID_TypologieLot not in ('PL','LC','LD','CL','FS','SNI') then NULL 
     else case when Etage.Batiment.Immeuble.FlagQPIncluse = '1' 
     then SuperficieComm 
     else coalesce(SuperficieComm, 0) + coalesce(SuperficieHall, 0) + coalesce(SuperficiePal, 0) + coalesce(SuperficieQPPalier, 0)  +  coalesce(SuperficieQPCirculation, 0)   end end

  - attributeName: SuperficieUtileSansQP
    expression: case when FID_TypologieLot not in ('PL','LC','LD','CL','FS','SNI') then NULL 
     else case when Etage.Batiment.Immeuble.FlagQPIncluse = '1' 
     then coalesce(SuperficieComm, 0) - coalesce(SuperficieHall, 0) - coalesce(SuperficiePal, 0) - coalesce(SuperficieQPPalier, 0)  - coalesce(SuperficieQPCirculation, 0)
     else SuperficieComm end  end

  - attributeName: SuperficieUtilePonderee
    expression: case when FID_TypologieLot not in ('LC','LD') then NULL else SuperficieUtilePonderee end

  - attributeName: SuperficieHabitable
    expression: case when FID_TypologieLot not in ('AP') then NULL else SuperficieComm end
