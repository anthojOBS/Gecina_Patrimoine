_package: Batiments.entities.Lot.enrichers
_name: DefautFinGestion
_type: SemQLEnricher
entity: Batiments.entities.Lot.Lot
label: Default Country
enricherExecutionScope: NONE
semQlEnricherExpressions: 
  - attributeName: DateFinGestion
    expression: case when FID_Etat ='TER' and GoldenRecord.DateFinGestion is null and DateFinGestion is null
     then CURRENT_DATE() 
     when GoldenRecord.DateFinGestion  is not null  and GoldenRecord.DateFinGestion <> DateFinGestion 
     then GoldenRecord.DateFinGestion  else DateFinGestion end