_package: Batiments.entities.Lot.enrichers
_name: DefautDtDebStatut
_type: SemQLEnricher
entity: Batiments.entities.Lot.Lot
label: Default date début statut
enricherExecutionScope: NONE
semQlEnricherExpressions: 
  - attributeName: DateDebStatut
    expression: CURRENT_DATE()
condition: DateDebStatut is NULL or  StatutLouable <> GoldenRecord.StatutLouable