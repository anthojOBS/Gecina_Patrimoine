_package: Batiments.entities.Lot.enrichers
_name: DefautDestinationTax
_type: SemQLEnricher
entity: Batiments.entities.Lot.Lot
label: Default Destination taxable
enricherExecutionScope: NONE
semQlEnricherExpressions: 
  - attributeName: FID_DestinationTaxable
    expression: case when FID_TypologieLot = 'PL' then 'IDN' 
                    when FID_TypologieLot = 'LC' then 'IDC' 
                    when FID_TypologieLot = 'PK' then 'IDP'  
                    when FID_TypologieLot = 'CL' then 'IDS' 
                    else GoldenRecord.FID_DestinationTaxable end
