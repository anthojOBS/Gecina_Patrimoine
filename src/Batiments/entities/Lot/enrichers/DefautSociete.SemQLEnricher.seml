_package: Batiments.entities.Lot.enrichers
_name: DefautSociete
_type: SemQLEnricher
entity: Batiments.entities.Lot.Lot
label: Defaut societe proprietaire et exploitante
enricherExecutionScope: POST_CONSO
semQlEnricherExpressions: 
  - attributeName: FID_SocieteProprietaire
    expression: lookup first (FID_Societe) from Etage.Batiment.Immeuble.RelImmSoc where FID_TypeSociete = '1' end
  - attributeName: FID_SocieteExploitante
    expression:  lookup first (FID_Societe) from Etage.Batiment.Immeuble.RelImmSoc where FID_TypeSociete = '1' end
