_package: Batiments.entities.Lot.steppers
_type: Stepper
_name: LotsEdition
entity: Batiments.entities.Lot.Lot
label: Lots
rootStep:
  _type: CollectionStep
  _name: Lots
  label: Lots
  canFinishSubLevel: true
  enabledOnParentCreate: true
  enabledOnParentEdit: true
  formFieldsMode: AUTO
  linear: false
  childDeleteType: HARD_DELETE
  collectionView: Batiments.entities.Lot.collection_views.LotCollectionView
  defaultDisplayType: TABLE
  customSortEnabled: false
  userDefinedSortEnabled: true
  displayGridAllowed: false
  displayListAllowed: true
  displayTableAllowed: true
  useCustomCollectionLabel: false
  childSteps:
    - _type: FormStep
      _name: Lot
      label: Lot
      canFinishSubLevel: true
      enabledOnParentCreate: true
      enabledOnParentEdit: true
      formFieldsMode: AUTO
      enableMasterValuePicking: false
      formTab: Batiments.entities.Lot.forms.LotEdition.Lot

      referenceFormFieldConfigs:
        - enableCreateReference: false
          enableUserSort: true
          referencePickerType: AUTO_COMPLETE
          fdnFormField: Batiments.entities.Lot.forms.LotEdition.Lot.Identite.haut.Usage.FDN_Usage
          # referenceFilter: Referenced.FID_Usage = 'ENT' or Referenced.FID_Usage = 'HAB'
          referenceFilter: Referenced.UsageCode = 'ENT' or Referenced.UsageCode = 'HAB'
          referencePickerCollectionView: Batiments.entities.Usage.collection_views.UsageCollectionView
          # referencePickerSearchTypeConfigs: []


      formStepEnrichers:   
        - enricher: Batiments.entities.Lot.enrichers.DefautDtDebUsage
          executedOnButtonClick: false
          executedOnDataChange: false
          executedOnFormOpen: true
        - enricher: Batiments.entities.Lot.enrichers.DefautGenreLot
          executedOnButtonClick: false
          executedOnDataChange: true
          executedOnFormOpen: false

      formStepValidations:  

        - executedOnDataChange: true
          executedOnFormOpen: true
          validationType: MANDATORY
          attribute: Batiments.entities.Lot.Lot.DateDebUsage
        - executedOnDataChange: true
          executedOnFormOpen: true
          validationType: MANDATORY
          attribute: Batiments.references.LotToUsage.Usage
        - executedOnDataChange: true
          executedOnFormOpen: true
          validationType: MANDATORY
          attribute: Batiments.references.LotToTypologieLot.TypologieLot
        - executedOnDataChange: true
          executedOnFormOpen: true
          validationType: MANDATORY
          attribute: Batiments.references.LotToGenreLot.GenreLot

        - validator: Batiments.entities.Lot.validations.CheckRaisonNonLouable
          executedOnDataChange: true
          executedOnFormOpen: true
          validationType: CHECK
          attribute: Batiments.references.LotToRaison.RaisonNonLouable

      stepTransitionValidations:
        - onStepExit: BLOCK
          validationType: MANDATORY
          attribute: Batiments.references.LotToUsage.Usage
        - onStepExit: BLOCK
          validationType: MANDATORY
          attribute: Batiments.entities.Lot.Lot.DateDebUsage

        - onStepExit: BLOCK
          validationType: MANDATORY
          attribute: Batiments.references.LotToTypologieLot.TypologieLot
        - onStepExit: BLOCK
          validationType: MANDATORY
          attribute: Batiments.references.LotToGenreLot.GenreLot

        - onStepExit: BLOCK
          validationType: CHECK
          validator: Batiments.entities.Lot.validations.CheckRaisonNonLouable



    - _type: FormStep
      _name: Composition
      label: Composition
      canFinishSubLevel: true
      enabledOnParentCreate: true
      enabledOnParentEdit: true
      formFieldsMode: AUTO
      enableMasterValuePicking: false
      formTab: Batiments.entities.Lot.forms.LotEdition.Composition

      formStepValidations:  
        - validator: Batiments.entities.Lot.validations.CheckDestinationTaxable
          executedOnDataChange: true
          executedOnFormOpen: true
          validationType: CHECK
          attribute: Batiments.references.LotToDestinationTaxable.DestinationTaxable
        - validator: Batiments.entities.Lot.validations.CheckSuperficieQP
          executedOnDataChange: true
          executedOnFormOpen: true
          validationType: CHECK
          attribute: Batiments.entities.Lot.Lot.SuperficieUtileQP
        - validator: Batiments.entities.Lot.validations.CheckSuperficiesansQP
          executedOnDataChange: true
          executedOnFormOpen: true
          validationType: CHECK
          attribute: Batiments.entities.Lot.Lot.SuperficieUtileSansQP

      stepTransitionValidations:
        - onStepExit: BLOCK
          validationType: CHECK
          validator: Batiments.entities.Lot.validations.CheckDestinationTaxable
        - onStepExit: BLOCK
          validationType: CHECK
          validator: Batiments.entities.Lot.validations.CheckSuperficieQP
        - onStepExit: BLOCK
          validationType: CHECK
          validator: Batiments.entities.Lot.validations.CheckSuperficiesansQP




    - _type: CollectionStep
      enableChildImportOnParentCreate: true
      enableChildImportOnParentEdit: true 
      childImportModeOnParentEdit: CREATE_ONLY 
      enableChildCopyOnParentCreate: true
      enableChildCopyOnParentEdit: true
      enableChildCreationOnParentCreate: true
      enableChildCreationOnParentEdit: true 
      enableChildDeleteOnParentEdit: true
      enableChildEditOnParentCreate: true
      enableChildEditOnParentEdit: true
      enableChildRemoveOnParentCreate: true
      enableChildRemoveOnParentEdit: true
      skipToChildCreationOnParentCreate: false
      skipToChildEditingOnParentEdit: false
      filter: Lot.FID_TypologieLot = 'SNI'
      linear: false
      _name: Service
      label: Types services
      canFinishSubLevel: true
      enabledOnParentCreate: true
      enabledOnParentEdit: true
      formFieldsMode: AUTO
      childDeleteType: HARD_DELETE
      oneToManyReference: Batiments.references.ServiceToLot
      collectionView: Batiments.entities.Service.collection_views.ServiceCollectionLot
      defaultDisplayType: TABLE
      customSortEnabled: false
      userDefinedSortEnabled: true
      displayGridAllowed: false
      displayListAllowed: true
      displayTableAllowed: true
      useCustomCollectionLabel: false
      childSteps:
        - _type: FormStep
          _name: Service_form
          label: Services
          canFinishSubLevel: true
          enabledOnParentCreate: true
          enabledOnParentEdit: true
          formFieldsMode: AUTO
          enableMasterValuePicking: false
          formTab: Batiments.entities.Service.forms.ServiceForm.Service


    - _type: FormStep
      _name: CycleDeVie
      label: Cycle de vie de l'immeuble
      canFinishSubLevel: true
      enabledOnParentCreate: true
      enabledOnParentEdit: true
      formFieldsMode: AUTO
      enableMasterValuePicking: false
      formTab: Batiments.entities.Lot.forms.LotEdition.CycleVie

      formStepEnrichers:   
        - enricher: Batiments.entities.Lot.enrichers.DefautPhase
          executedOnButtonClick: false
          executedOnDataChange: false
          executedOnFormOpen: true
        - enricher: Batiments.entities.Lot.enrichers.DefautDtDebPhase
          executedOnButtonClick: false
          executedOnDataChange: false
          executedOnFormOpen: true

      formStepValidations:  
        - executedOnDataChange: true
          executedOnFormOpen: true
          validationType: MANDATORY
          attribute:  Batiments.references.LotToPhase.Phase
        - executedOnDataChange: true
          executedOnFormOpen: true
          validationType: MANDATORY
          attribute: Batiments.entities.Lot.Lot.DateDebPhase

      stepTransitionValidations:
        - onStepExit: BLOCK
          validationType: MANDATORY
          attribute:  Batiments.references.LotToPhase.Phase
        - onStepExit: BLOCK
          validationType: MANDATORY
          attribute: Batiments.entities.Lot.Lot.DateDebPhase

    - _type: FormStep
      _name: FiscaliteJuridique
      label: Fiscalité et Juridique
      canFinishSubLevel: true
      enabledOnParentCreate: true
      enabledOnParentEdit: true
      formFieldsMode: AUTO
      enableMasterValuePicking: false
      formTab: Batiments.entities.Lot.forms.LotEdition.JuridiquePropriete

      formStepEnrichers:   
        - enricher: Batiments.entities.Lot.enrichers.DefautRegimeTVA
          executedOnButtonClick: false
          executedOnDataChange: false
          executedOnFormOpen: true

      formStepValidations:  
        - executedOnDataChange: true
          executedOnFormOpen: true
          validationType: MANDATORY
          attribute:  Batiments.references.LotToFiscaliteCible.FiscaliteCible


      stepTransitionValidations:
        - onStepExit: BLOCK
          validationType: MANDATORY
          attribute: Batiments.references.LotToFiscaliteCible.FiscaliteCible



    - _type: CollectionStep
      enableChildImportOnParentCreate: true
      enableChildImportOnParentEdit: true 
      childImportModeOnParentEdit: CREATE_ONLY 
      enableChildCopyOnParentCreate: true
      enableChildCopyOnParentEdit: true
      enableChildCreationOnParentCreate: true
      enableChildCreationOnParentEdit: true 
      enableChildDeleteOnParentEdit: true
      enableChildEditOnParentCreate: true
      enableChildEditOnParentEdit: true
      enableChildRemoveOnParentCreate: true
      enableChildRemoveOnParentEdit: true
      skipToChildCreationOnParentCreate: false
      skipToChildEditingOnParentEdit: false
      linear: false
      _name: Societes
      label: Sociétés
      canFinishSubLevel: true
      enabledOnParentCreate: true
      enabledOnParentEdit: true
      formFieldsMode: AUTO
      childDeleteType: HARD_DELETE
      oneToManyReference: Batiments.references.RelLotSocToLot
      collectionView: Batiments.entities.RelLotSoc.collection_views.RelLotSocCollectionView
      defaultDisplayType: TABLE
      customSortEnabled: false
      userDefinedSortEnabled: true
      displayGridAllowed: false
      displayListAllowed: true
      displayTableAllowed: true
      useCustomCollectionLabel: false
      childSteps:
        - _type: FormStep
          _name: Societes_form
          label: Sociétés
          canFinishSubLevel: true
          enabledOnParentCreate: true
          enabledOnParentEdit: true
          formFieldsMode: AUTO
          enableMasterValuePicking: false
          formTab: Batiments.entities.RelLotSoc.forms.RelLotSocForm.RelLotSoc



stepperFinishValidations:
  - onStepperFinish: WARN
    validationType: DETECT_DUPS


  - onStepperFinish: BLOCK
    validationType: MANDATORY
    attribute:  Batiments.references.LotToUsage.Usage
  - onStepperFinish: BLOCK
    validationType: MANDATORY
    attribute: Batiments.entities.Lot.Lot.DateDebUsage

  - onStepperFinish: BLOCK
    validationType: MANDATORY
    attribute: Batiments.references.LotToTypologieLot.TypologieLot
  - onStepperFinish: BLOCK
    validationType: MANDATORY
    attribute: Batiments.references.LotToGenreLot.GenreLot

  - onStepperFinish: BLOCK
    validationType: CHECK
    validator: Batiments.entities.Lot.validations.CheckDestinationTaxable
  - onStepperFinish: BLOCK
    validationType: CHECK
    validator: Batiments.entities.Lot.validations.CheckSuperficiesansQP
  - onStepperFinish: BLOCK
    validationType: CHECK
    validator: Batiments.entities.Lot.validations.CheckSuperficieQP



  - onStepperFinish: BLOCK
    validationType: MANDATORY
    attribute:  Batiments.references.LotToPhase.Phase
  - onStepperFinish: BLOCK
    validationType: MANDATORY
    attribute: Batiments.entities.Lot.Lot.DateDebPhase

  - onStepperFinish: BLOCK
    validationType: MANDATORY
    attribute: Batiments.references.LotToFiscaliteCible.FiscaliteCible

  - onStepperFinish: BLOCK
    validationType: CHECK
    validator: Batiments.entities.Lot.validations.CheckRaisonNonLouable