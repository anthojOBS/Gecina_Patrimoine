_package: Batiments.entities.Lot.steppers
_type: Stepper
_name: LotsCreation
entity: Batiments.entities.Lot.Lot
label: Lots
rootStep:
  _type: CollectionStep
  _name: Lots
  label: Lots
  canFinishSubLevel: true
  enabledOnParentCreate: true
  enabledOnParentEdit: true
  formFieldsMode: AUTO
  linear: false
  childDeleteType: HARD_DELETE
  collectionView: Batiments.entities.Lot.collection_views.LotCollectionView
  defaultDisplayType: TABLE
  customSortEnabled: false
  userDefinedSortEnabled: true
  displayGridAllowed: false
  displayListAllowed: true
  displayTableAllowed: true
  useCustomCollectionLabel: false
  childSteps:
    - _type: FormStep
      _name: Lot
      label: Fiche Lot
      canFinishSubLevel: true
      enabledOnParentCreate: true
      enabledOnParentEdit: true
      formFieldsMode: AUTO
      enableMasterValuePicking: false
      formTab: Batiments.entities.Lot.forms.LotCreation.Lot

      referenceFormFieldConfigs:
        - enableCreateReference: false
          enableUserSort: true
          referencePickerType: AUTO_COMPLETE
          fdnFormField: Batiments.entities.Lot.forms.LotCreation.Lot.Identite.haut.Usage.FDN_Usage
          referenceFilter: Referenced.UsageCode = 'BUR' or Referenced.UsageCode = 'RESI'
          referencePickerCollectionView: Batiments.entities.Usage.collection_views.UsageCollectionView
          # referencePickerSearchTypeConfigs: []


        - enableCreateReference: false
          enableUserSort: true
          referencePickerType: AUTO_COMPLETE
          fdnFormField: Batiments.entities.Lot.forms.LotCreation.Lot.Identite.haut.IdentiteLot.FDN_LotOrigine
          referenceFilter: Referenced.Etage.FID_Batiment = Record.Etage.FID_Batiment
          referencePickerCollectionView: Batiments.entities.Lot.collection_views.LotCollectionView
          # referencePickerSearchTypeConfigs: []

        - enableCreateReference: false
          enableUserSort: true
          referencePickerType: AUTO_COMPLETE
          fdnFormField: Batiments.entities.Lot.forms.LotCreation.Lot.Identite.haut.Usage.FDN_GenreLot
          referenceFilter: Referenced.FID_TypologieLot = Record.FID_TypologieLot
          referencePickerCollectionView: Batiments.entities.GenreLot.collection_views.GenreLotCollectionView
          # referencePickerSearchTypeConfigs: []

        - enableCreateReference: false
          enableUserSort: true
          referencePickerType: AUTO_COMPLETE
          fdnFormField: Batiments.entities.Lot.forms.LotCreation.Lot.Identite.haut.Usage.FDN_TypologieLot
          referenceFilter: Referenced.Code <> 'PI'
          referencePickerCollectionView: Batiments.entities.TypologieLot.collection_views.TypologieLotCollectionView
          # referencePickerSearchTypeConfigs: []
                   
      formStepEnrichers:   
        - enricher: Batiments.entities.Lot.enrichers.DefautDtDebUsage
          executedOnButtonClick: false
          executedOnDataChange: false
          executedOnFormOpen: true
        - enricher: Batiments.entities.Lot.enrichers.DefautDtDebStatut
          executedOnButtonClick: false
          executedOnDataChange: false
          executedOnFormOpen: true
        - enricher: Batiments.entities.Lot.enrichers.DefautLouable
          executedOnButtonClick: false
          executedOnDataChange: false
          executedOnFormOpen: true
        # - enricher: Batiments.entities.Lot.enrichers.DefautGenreLot
        #   executedOnButtonClick: false
        #   executedOnDataChange: true
        #   executedOnFormOpen: false
        # - enricher: Batiments.entities.Lot.enrichers.AlimSocExploitante
        #   executedOnButtonClick: false
        #   executedOnDataChange: true
        #   executedOnFormOpen: true
          
      formStepValidations:  
        - executedOnDataChange: true
          executedOnFormOpen: true
          validationType: MANDATORY
          attribute: Batiments.entities.Lot.Lot.IdentifiantsERP
        - executedOnDataChange: true
          executedOnFormOpen: true
          validationType: MANDATORY
          attribute: Batiments.entities.Lot.Lot.DateDebUsage
        - executedOnDataChange: true
          executedOnFormOpen: true
          validationType: MANDATORY
          attribute: Batiments.entities.Lot.Lot.DateDebStatut
        - executedOnDataChange: true
          executedOnFormOpen: true
          validationType: MANDATORY
          attribute: Batiments.references.LotToUsage.Usage
        - executedOnDataChange: true
          executedOnFormOpen: true
          validationType: MANDATORY
          attribute: Batiments.references.LotToTypologieLot.TypologieLot
        - executedOnDataChange: true
          executedOnFormOpen: true
          validationType: MANDATORY
          attribute: Batiments.references.LotToGenreLot.GenreLot

        - validator: Batiments.entities.Lot.validations.CheckUsage
          executedOnDataChange: true
          executedOnFormOpen: true
          validationType: CHECK
          attribute: Batiments.references.LotToUsage.Usage

        - validator: Batiments.entities.Lot.validations.CheckRaisonNonLouable
          executedOnDataChange: true
          executedOnFormOpen: true
          validationType: CHECK
          attribute: Batiments.references.LotToRaison.RaisonNonLouable

        - validator: Batiments.entities.Lot.validations.CheckCoherenceTypo_Genre
          executedOnDataChange: true
          executedOnFormOpen: true
          validationType: CHECK
          attribute: Batiments.references.LotToGenreLot.GenreLot

        - validator: Batiments.entities.Lot.validations.CheckLotOrigine
          executedOnDataChange: true
          executedOnFormOpen: true
          validationType: CHECK
          attribute: Batiments.references.LotToLot.LotOrigine

      stepTransitionValidations:
        - onStepExit: BLOCK
          validationType: DETECT_DUPS
          matcher: Batiments.entities.Lot.Lot.Matcher
        - onStepExit: BLOCK
          validationType: MANDATORY
          attribute: Batiments.entities.Lot.Lot.IdentifiantsERP
        - onStepExit: BLOCK
          validationType: MANDATORY
          attribute: Batiments.references.LotToUsage.Usage
        - onStepExit: WARN
          validationType: CHECK
          validator: Batiments.entities.Lot.validations.CheckUsage
        - onStepExit: BLOCK
          validationType: CHECK
          validator: Batiments.entities.Lot.validations.CheckLotOrigine



        - onStepExit: BLOCK
          validationType: MANDATORY
          attribute: Batiments.entities.Lot.Lot.DateDebUsage
        - onStepExit: BLOCK
          validationType: MANDATORY
          attribute: Batiments.entities.Lot.Lot.DateDebStatut

        - onStepExit: BLOCK
          validationType: MANDATORY
          attribute: Batiments.references.LotToTypologieLot.TypologieLot
        - onStepExit: BLOCK
          validationType: MANDATORY
          attribute: Batiments.references.LotToGenreLot.GenreLot

        - onStepExit: BLOCK
          validationType: CHECK
          validator: Batiments.entities.Lot.validations.CheckRaisonNonLouable

        - onStepExit: BLOCK
          validationType: CHECK
          validator: Batiments.entities.Lot.validations.CheckCoherenceTypo_Genre



    - _type: FormStep
      _name: Composition
      label: Composition
      canFinishSubLevel: true
      enabledOnParentCreate: true
      enabledOnParentEdit: true
      formFieldsMode: AUTO
      enableMasterValuePicking: false
      formTab: Batiments.entities.Lot.forms.LotCreation.Composition


      formStepEnrichers:   
        - enricher: Batiments.entities.Lot.enrichers.DefautDestinationTax
          executedOnButtonClick: false
          executedOnDataChange: true
          executedOnFormOpen: true

      formStepValidations:  
        - validator: Batiments.entities.Lot.validations.CheckDestinationTaxable
          executedOnDataChange: true
          executedOnFormOpen: true
          validationType: CHECK
          attribute: Batiments.references.LotToDestinationTaxable.DestinationTaxable
        - validator: Batiments.entities.Lot.validations.CheckSuperficieQP
          executedOnDataChange: true
          executedOnFormOpen: true
          validationType: CHECK
          attribute: Batiments.entities.Lot.Lot.SuperficieUtileQP
        - validator: Batiments.entities.Lot.validations.CheckSuperficiesansQP
          executedOnDataChange: true
          executedOnFormOpen: true
          validationType: CHECK
          attribute: Batiments.entities.Lot.Lot.SuperficieUtileSansQP
        - validator: Batiments.entities.Lot.validations.CheckSuperficieHabitable
          executedOnDataChange: true
          executedOnFormOpen: true
          validationType: CHECK
          attribute: Batiments.entities.Lot.Lot.SuperficieHabitable

          
      stepTransitionValidations:
        - onStepExit: BLOCK
          validationType: CHECK
          validator: Batiments.entities.Lot.validations.CheckDestinationTaxable
        - onStepExit: BLOCK
          validationType: CHECK
          validator: Batiments.entities.Lot.validations.CheckSuperficieQP
        - onStepExit: BLOCK
          validationType: CHECK
          validator: Batiments.entities.Lot.validations.CheckSuperficiesansQP
        - onStepExit: BLOCK
          validationType: CHECK
          validator: Batiments.entities.Lot.validations.CheckSuperficieHabitable

    # - _type: CollectionStep
    #   enableChildImportOnParentCreate: true
    #   enableChildImportOnParentEdit: true 
    #   childImportModeOnParentEdit: CREATE_ONLY 
    #   enableChildCopyOnParentCreate: true
    #   enableChildCopyOnParentEdit: true
    #   enableChildCreationOnParentCreate: true
    #   enableChildCreationOnParentEdit: true 
    #   enableChildDeleteOnParentEdit: true
