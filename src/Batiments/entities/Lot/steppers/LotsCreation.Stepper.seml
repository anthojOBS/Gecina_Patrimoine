    - _type: FormStep
      _name: CycleDeVie
      label: Cycle de vie
      canFinishSubLevel: true
      enabledOnParentCreate: true
      enabledOnParentEdit: true
      formFieldsMode: AUTO
      enableMasterValuePicking: false
      formTab: Batiments.entities.Lot.forms.LotCreation.CycleVie

      referenceFormFieldConfigs:
        - enableCreateReference: false
          enableUserSort: true
          referencePickerType: AUTO_COMPLETE
          fdnFormField: Batiments.entities.Lot.forms.LotCreation.CycleVie.Cycle.Etat.FDN_Etat          
          referenceFilter: Referenced.EtatCode <> 'VENDU'
          referencePickerCollectionView: Batiments.entities.Etat.collection_views.EtatCollectionView
          # referencePickerSearchTypeConfigs: []

      formStepEnrichers:   
        - enricher: Batiments.entities.Lot.enrichers.DefautEtat
          executedOnButtonClick: false
          executedOnDataChange: false
          executedOnFormOpen: true

      formStepValidations:  
        - executedOnDataChange: true
          executedOnFormOpen: true
          validationType: MANDATORY
          attribute:  Batiments.references.LotToEtat.Etat


      stepTransitionValidations:
        - onStepExit: BLOCK
          validationType: MANDATORY
          attribute:  Batiments.references.LotToEtat.Etat


    - _type: FormStep
      _name: FiscaliteJuridique
      label: Juridique et propriété
      canFinishSubLevel: true
      enabledOnParentCreate: true
      enabledOnParentEdit: true
      formFieldsMode: AUTO
      enableMasterValuePicking: false
      formTab: Batiments.entities.Lot.forms.LotCreation.JuridiquePropriete
      # referenceFormFieldConfigs:
      #   - enableCreateReference: false
      #     enableUserSort: true
      #     referencePickerType: AUTO_COMPLETE
      #     fdnFormField: Batiments.entities.Lot.forms.LotCreation.JuridiquePropriete.Societes.FDN_SocieteExploitante
      #     referenceFilter: SEM_INSTR(',' || Record.SocieteExploitanteIDs || ',' , ',' || Referenced.SocieteCode || ',') > 0
      #     referencePickerCollectionView: Batiments.entities.Societe.collection_views.SocieteCollectionView
      #     # referencePickerSearchTypeConfigs: []
      formStepEnrichers:   
        - enricher: Batiments.entities.Lot.enrichers.DefautRegimeTVA
          executedOnButtonClick: false
          executedOnDataChange: false
          executedOnFormOpen: true

        - enricher: Batiments.entities.Lot.enrichers.DefautStatutSousLocation
          executedOnButtonClick: false
          executedOnDataChange: true
          executedOnFormOpen: false

      formStepValidations:  
        - executedOnDataChange: true
          executedOnFormOpen: true
          validationType: MANDATORY
          attribute:  Batiments.references.LotToFiscaliteCible.FiscaliteCible
        # - executedOnDataChange: true
        #   executedOnFormOpen: true
        #   validationType: MANDATORY
        #   attribute:  Batiments.references.LotToSocieteExploitante.SocieteExploitante


      stepTransitionValidations:
        - onStepExit: BLOCK
          validationType: MANDATORY
          attribute: Batiments.references.LotToFiscaliteCible.FiscaliteCible
        # - onStepExit: BLOCK
        #   validationType: MANDATORY
        #   attribute: Batiments.references.LotToSocieteExploitante.SocieteExploitante




    - _type: CollectionStep
      enableChildImportOnParentCreate: true
      enableChildImportOnParentEdit: true 
      childImportModeOnParentEdit: CREATE_ONLY 
      enableChildCopyOnParentCreate: true
      enableChildCopyOnParentEdit: true
      enableChildCreationOnParentCreate: true
      enableChildCreationOnParentEdit: true 
      enableChildDeleteOnParentEdit: true
      enableChildEditOnParentCreate: true
      enableChildEditOnParentEdit: true
      enableChildRemoveOnParentCreate: true
      enableChildRemoveOnParentEdit: true
      skipToChildCreationOnParentCreate: false
      skipToChildEditingOnParentEdit: false
      linear: false
      _name: Societes
      label: Sociétés
      canFinishSubLevel: true
      enabledOnParentCreate: true
      enabledOnParentEdit: true
      formFieldsMode: AUTO
      childDeleteType: HARD_DELETE
      oneToManyReference: Batiments.references.RelLotSocToLot
      collectionView: Batiments.entities.RelLotSoc.collection_views.RelLotSocCollectionView
      defaultDisplayType: TABLE
      customSortEnabled: false
      userDefinedSortEnabled: true
      displayGridAllowed: false
      displayListAllowed: true
      displayTableAllowed: true
      useCustomCollectionLabel: false
      childSteps:
        - _type: FormStep
          _name: Societes_form
          label: Sociétés
          canFinishSubLevel: true
          enabledOnParentCreate: true
          enabledOnParentEdit: true
          formFieldsMode: AUTO
          enableMasterValuePicking: false
          formTab: Batiments.entities.RelLotSoc.forms.RelLotSocForm.RelLotSoc

          formStepValidations:  
            - executedOnDataChange: true
              executedOnFormOpen: true
              validationType: MANDATORY
              attribute:  Batiments.references.RelLotSocToSociete.Societe
            - executedOnDataChange: true
              executedOnFormOpen: true
              validationType: MANDATORY
              attribute:  Batiments.references.RelLotSocToTypeSociete.TypeSociete

          stepTransitionValidations:
            - onStepExit: BLOCK
              validationType: DETECT_DUPS
              matcher: Batiments.entities.RelLotSoc.RelLotSoc.Matcher
            - onStepExit: BLOCK
              validationType: MANDATORY
              attribute: Batiments.references.RelLotSocToSociete.Societe
            - onStepExit: BLOCK
              validationType: MANDATORY
              attribute: Batiments.references.RelLotSocToTypeSociete.TypeSociete



stepperFinishValidations:
  - onStepperFinish: BLOCK
    validationType: DETECT_DUPS
  - onStepperFinish: BLOCK
    validationType: MANDATORY
    attribute: Batiments.entities.Lot.Lot.IdentifiantsERP
  - onStepperFinish: BLOCK
    validationType: MANDATORY
    attribute:  Batiments.references.LotToUsage.Usage
  - onStepperFinish: BLOCK
    validationType: MANDATORY
    attribute: Batiments.entities.Lot.Lot.DateDebUsage
  - onStepperFinish: BLOCK
    validationType: MANDATORY
    attribute: Batiments.entities.Lot.Lot.DateDebStatut

  - onStepperFinish: WARN
    validationType: CHECK
    validator: Batiments.entities.Lot.validations.CheckUsage
  - onStepperFinish: BLOCK
    validationType: CHECK
    validator: Batiments.entities.Lot.validations.CheckLotOrigine


  - onStepperFinish: BLOCK
    validationType: MANDATORY
    attribute: Batiments.references.LotToTypologieLot.TypologieLot
  - onStepperFinish: BLOCK
    validationType: MANDATORY
    attribute: Batiments.references.LotToGenreLot.GenreLot


  - onStepperFinish: BLOCK
    validationType: CHECK
    validator: Batiments.entities.Lot.validations.CheckDestinationTaxable
  - onStepperFinish: BLOCK
    validationType: CHECK
    validator: Batiments.entities.Lot.validations.CheckSuperficiesansQP
  - onStepperFinish: BLOCK
    validationType: CHECK
    validator: Batiments.entities.Lot.validations.CheckSuperficieQP
  - onStepperFinish: BLOCK
    validationType: CHECK
    validator: Batiments.entities.Lot.validations.CheckSuperficieHabitable



  - onStepperFinish: BLOCK
    validationType: MANDATORY
    attribute:  Batiments.references.LotToEtat.Etat


  - onStepperFinish: BLOCK
    validationType: MANDATORY
    attribute: Batiments.references.LotToFiscaliteCible.FiscaliteCible

  # - onStepperFinish: BLOCK
  #   validationType: MANDATORY
  #   attribute: Batiments.references.LotToSocieteExploitante.SocieteExploitante

  - onStepperFinish: BLOCK
    validationType: CHECK
    validator: Batiments.entities.Lot.validations.CheckRaisonNonLouable
  - onStepperFinish: BLOCK
    validationType: CHECK
    validator: Batiments.entities.Lot.validations.CheckCoherenceTypo_Genre

  - onStepperFinish: BLOCK
    validationType: MANDATORY
    attribute: Batiments.references.RelImmSocToSociete.Societe
  - onStepperFinish: BLOCK
    validationType: MANDATORY
    attribute: Batiments.references.RelImmSocToTypeSociete.TypeSociete