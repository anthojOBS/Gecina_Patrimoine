_package: Batiments.entities.Lot.action_sets
_type: ActionSet
_name: LotActionSet
entity: Batiments.entities.Lot.Lot
label: Lot Action Set
defaultActionSet: true
actions:
  - _type: CreateAction
    _name: CreateAuthorLots
    label: Create
    useCustomLabel: true
    stepper: Batiments.entities.Lot.steppers.AuthorLots
    createMultiple: false
    createdRecordType: GOLDEN
    waitDialogEnabled: false
    allowOtherPublishers: true
  - _type: EditAction
    _name: EditAuthorLots
    label: Edit
    useCustomLabel: true
    stepper: Batiments.entities.Lot.steppers.AuthorLots
    multipleSelectionAllowed: true
    availableForGoldenData: true
    availableForMasterData: true
    availableForErrorData: true
    waitDialogEnabled: false
  - _type: StartWorkflowEntityAction
    _name: EditSurfaceLot
    label: Editer Surface Lot (Workflow)
    useCustomLabel: true
    waitDialogEnabled: false
    workflow: Batiments.workflows.ModificationSurfaceLot
    startEvent: Batiments.workflows.ModificationSurfaceLot.StartEdit
  - _type: MassUpdateAction
    _name: MassUpdateAuthorLots
    label: Mass Update
    useCustomLabel: true
    stepper: Batiments.entities.Lot.steppers.AuthorLots
    availableForGoldenData: true
    availableForErrorData: true
    availableForMasterData: true
    waitDialogEnabled: false
  - _type: DeleteAction
    _name: Delete
    label: Delete
    useCustomLabel: true
    multipleSelectionAllowed: true
    deleteType: HARD_DELETE
    waitDialogEnabled: false
    availableForGoldenData: true
    availableForMasterData: true
  - _type: ExportAction
    _name: Export
    label: Export
    useCustomLabel: true
    waitDialogEnabled: false
  - _type: ImportAction
    _name: ImportAuthorLots
    label: Import
    useCustomLabel: true
    importMode: CREATE_AND_UPDATE
    stepper: Batiments.entities.Lot.steppers.AuthorLots
    importedRecordType: MASTER
    waitDialogEnabled: false
    allowOtherPublishers: true
  - _type: BrowseGraphAction
    _name: BrowseGraph
    label: Browse Graph
    useCustomLabel: true
    waitDialogEnabled: false
  # - _type: CopyAction
  #   _name: CopyAuthorLots
  #   label: Copy
  #   useCustomLabel: true
  #   stepper: Batiments.entities.Lot.steppers.AuthorLots
  #   multipleSelectionAllowed: true
  #   waitDialogEnabled: false
  - _type: DirectConfirmDupsAction
    _name: DirectConfirmDuplicates
    label: Direct Confirm Duplicates
    useCustomLabel: false
    waitDialogEnabled: false
  - _type: ReviewAndConfirm
    _name: ReviewAndConfirmDuplicatesManageDuplicatesOnLot
    label: Review and Confirm Duplicates
    useCustomLabel: true
    dupsManager: Batiments.entities.Lot.dups_managers.ManageDuplicatesOnLot
    enableEdit: true
    mandateConfirmAll: false
    waitDialogEnabled: false
  - _type: MergeOrSplit
    _name: MergeOrSplitDuplicatesManageDuplicatesOnLot
    label: Merge Or Split Duplicates
    useCustomLabel: true
    dupsManager: Batiments.entities.Lot.dups_managers.ManageDuplicatesOnLot
    enableEdit: true
    waitDialogEnabled: false
  - _type: ReviewSuggestions
    _name: ReviewSuggestionsDuplicatesManageDuplicatesOnLot
    label: Review Duplicates Suggestions
    useCustomLabel: true
    dupsManager: Batiments.entities.Lot.dups_managers.ManageDuplicatesOnLot
    enableEdit: true
    waitDialogEnabled: false
    onAcceptPromptGoldenId: false
    mandateResolveAllSuggestions: false
  - _type: ExplainRecordAction
    _name: ExplainRecord
    label: Explain Record
    useCustomLabel: true
    displayCard: Batiments.entities.Lot.display_cards.LotDisplayCard
    formTab: Batiments.entities.Lot.forms.LotForm.Lot
    waitDialogEnabled: false
