_package: Batiments.entities.Lot.action_sets
_type: ActionSet
_name: LotImmeuble
entity: Batiments.entities.Lot.Lot
label: Lot Action Set
defaultActionSet: false
actions:

  - _type: EditAction
    _name: EditAuthorLots
    label: Modification lot
    useCustomLabel: true
    stepper: Batiments.entities.Lot.steppers.LotsEdition
    multipleSelectionAllowed: true
    availableForGoldenData: true
    availableForMasterData: true
    availableForErrorData: true
    waitDialogEnabled: false
  # - _type: StartWorkflowEntityAction
  #   _name: EditSurfaceLot
  #   label: Editer Surface Lot (Workflow)
  #   useCustomLabel: true
  #   waitDialogEnabled: false
  #   workflow: Batiments.workflows.ModificationSurfaceLot
  #   startEvent: Batiments.workflows.ModificationSurfaceLot.StartEdit
  - _type: MassUpdateAction
    _name: MassUpdateAuthorLots
    label: Mise à jour de masse
    useCustomLabel: true
    stepper: Batiments.entities.Lot.steppers.LotsEdition
    availableForGoldenData: true
    availableForErrorData: true
    availableForMasterData: true
    waitDialogEnabled: false
  - _type: DeleteAction
    _name: Delete
    label: Supprimer
    useCustomLabel: true
    multipleSelectionAllowed: true
    deleteType: HARD_DELETE
    waitDialogEnabled: false
    availableForGoldenData: true
    availableForMasterData: true
  - _type: ExportAction
    _name: Export
    label: Exporter
    useCustomLabel: true
    waitDialogEnabled: false
  - _type: ImportAction
    _name: ImportAuthorLots
    label: Importer
    useCustomLabel: true
    importMode: CREATE_AND_UPDATE
    stepper: Batiments.entities.Lot.steppers.LotsConsultation
    importedRecordType: MASTER
    waitDialogEnabled: false
    allowOtherPublishers: true
  - _type: BrowseGraphAction
    _name: BrowseGraph
    label: Recherche graphique
    useCustomLabel: true
    waitDialogEnabled: false
  - _type: DirectConfirmDupsAction
    _name: DirectConfirmDuplicates
    label: Confirmer doublons directement
    useCustomLabel: false
    waitDialogEnabled: false
  - _type: ReviewAndConfirm
    _name: ReviewAndConfirmDuplicatesManageDuplicatesOnLot
    label: Revue and Validation doublons
    useCustomLabel: true
    dupsManager: Batiments.entities.Lot.dups_managers.ManageDuplicatesOnLot
    enableEdit: true
    mandateConfirmAll: false
    waitDialogEnabled: false
  - _type: MergeOrSplit
    _name: MergeOrSplitDuplicatesManageDuplicatesOnLot
    label: Fusion et défusion
    useCustomLabel: true
    dupsManager: Batiments.entities.Lot.dups_managers.ManageDuplicatesOnLot
    enableEdit: true
    waitDialogEnabled: false
  - _type: ReviewSuggestions
    _name: ReviewSuggestionsDuplicatesManageDuplicatesOnLot
    label: Suggestions de doublons
    useCustomLabel: true
    dupsManager: Batiments.entities.Lot.dups_managers.ManageDuplicatesOnLot
    enableEdit: true
    waitDialogEnabled: false
    onAcceptPromptGoldenId: false
    mandateResolveAllSuggestions: false
  - _type: ExplainRecordAction
    _name: ExplainRecord
    label: Expliquer l'enregistrement
    useCustomLabel: true
    displayCard: Batiments.entities.Lot.display_cards.LotDisplayCard
    formTab: Batiments.entities.Lot.forms.LotConsultation.Lot
    waitDialogEnabled: false
