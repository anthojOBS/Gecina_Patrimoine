_package: Batiments.entities.Lot.action_sets
_type: ActionSet
_name: LotImmeuble
entity: Batiments.entities.Lot.Lot
label: Lot Action Set
defaultActionSet: false
actions:

  - _type: EditAction
    _name: EditAuthorLots
    label: Modification lot
    useCustomLabel: true
    stepper: Batiments.entities.Lot.steppers.LotsEdition
    multipleSelectionAllowed: true
    availableForGoldenData: true
    # availableForMasterData: false
    availableForErrorData: true
    waitDialogEnabled: false

  - _type: MassUpdateAction
    _name: MassUpdateAuthorLots
    label: Mise à jour de masse
    useCustomLabel: true
    stepper: Batiments.entities.Lot.steppers.LotsEdition
    availableForGoldenData: true
    availableForErrorData: true
    # availableForMasterData: false
    waitDialogEnabled: false
  - _type: DeleteAction
    _name: Delete
    label: Supprimer
    useCustomLabel: true
    multipleSelectionAllowed: true
    deleteType: HARD_DELETE
    waitDialogEnabled: false
    availableForGoldenData: true
    # availableForMasterData: true
    requiredRole: semarchyAdmin
  - _type: ExportAction
    _name: Export
    label: Exporter
    useCustomLabel: true
    waitDialogEnabled: false
  - _type: ImportAction
    _name: ImportAuthorLots
    label: Importer
    useCustomLabel: true
    importMode: CREATE_AND_UPDATE
    stepper: Batiments.entities.Lot.steppers.LotsConsultation
    importedRecordType: GOLDEN
    waitDialogEnabled: false
    allowOtherPublishers: true
  - _type: BrowseGraphAction
    _name: BrowseGraph
    label: Recherche graphique
    useCustomLabel: true
    waitDialogEnabled: false
    requiredRole: semarchyAdmin
