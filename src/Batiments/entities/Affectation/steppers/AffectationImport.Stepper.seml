_package: Batiments.entities.Affectation.steppers
_type: Stepper
_name: AffectationImport
entity: Batiments.entities.Affectation.Affectation
label: Affectation
rootStep:
  _type: CollectionStep
  _name: Affectation_collection
  label: Affectation
  canFinishSubLevel: true
  enabledOnParentCreate: true
  enabledOnParentEdit: true
  formFieldsMode: AUTO
  linear: false
  childDeleteType: HARD_DELETE
  collectionView: Batiments.entities.Affectation.collection_views.AffectationImport
  defaultDisplayType: TABLE
  customSortEnabled: false
  userDefinedSortEnabled: true
  displayGridAllowed: false
  displayListAllowed: true
  displayTableAllowed: true
  useCustomCollectionLabel: false
  childSteps:
    - _type: FormStep
      _name: Affectation
      label: Affectation
      canFinishSubLevel: true
      enabledOnParentCreate: true
      enabledOnParentEdit: true
      formFieldsMode: AUTO
      enableMasterValuePicking: false
      formTab: Batiments.entities.Affectation.forms.AffectationForm.Affectation


      formStepEnrichers:  
        - enricher: Batiments.entities.Affectation.enrichers.PluginImmeuble
          executedOnButtonClick: false
          executedOnDataChange: true
          executedOnFormOpen: false
        - enricher: Batiments.entities.Affectation.enrichers.Immeuble_import
          executedOnButtonClick: false
          executedOnDataChange: true
          executedOnFormOpen: false  

