_package: Batiments.entities.Affectation.forms
_type: Form
_name: AffectationImmeubleForm
entity: Batiments.entities.Affectation.Affectation
default: true
formTabs:
  - _type: FormTab
    _name: Affectation
    label: Affectation
    documentationInterpreter: LITERAL
    visibleValue: "1"
    visibleValueInterpreter: LITERAL
    displayFormTabAs: ICON_LABEL
    iconUrl: images://mdi/link-variant.svg
    labelWidth: 300px
    content:
      # - _type: TextField
      #   _name: AffectID
      #   value: AffectID
      #   useCustomLabel: false
      #   dataType: STRING
      #   labelProperties:
      #     typographyValueInterpreter: LITERAL
      #     typography: body-2
      #     color: md:black
      - _type: ReferenceField
        _name: NomPrenom
        value: FDN_Intervenant
        label: Intervenant
        useCustomLabel: true
        dataType: STRING
        labelProperties:
          alignment: left
          typographyValueInterpreter: LITERAL
          typography: body-2
          color: md:black
        referencedEntity: Batiments.entities.Intervenant.Intervenant

      - _type: ReferenceField
        _name: Role
        value: Intervenant.FDN_RoleImmeuble
        label: Rôle
        useCustomLabel: true
        dataType: STRING
        labelProperties:
          alignment: left
          typographyValueInterpreter: LITERAL
          typography: body-2
          color: md:black
        referencedEntity: Batiments.entities.RoleImmeuble.RoleImmeuble

      - _type: ReferenceField
        _name: FDN_Immeuble
        value: FDN_Immeuble
        label: Immeuble
        labelProperties:
          alignment: left
          typography: body-2
          color: md:black
        useCustomLabel: true
        dataType: STRING
        referencedEntity: Batiments.entities.Immeuble.Immeuble
      - _type: ReferenceField
        _name: FDN_TypeAffectation
        value: FDN_TypeAffectation
        label: Type d'affectation
        labelProperties:
          alignment: left
          typography: body-2
          color: md:black
        useCustomLabel: true
        dataType: STRING
        referencedEntity: Batiments.entities.TypeAffectation.TypeAffectation


      - _type: DateField
        _name: DateDebAffectation
        value: DateDebAffectation
        labelProperties:
          alignment: left
          typographyValueInterpreter: LITERAL
          typography: body-2
          color: md:black
        componentProperties:                 
          displayFormat: dd/MM/yyyy                
          displayFormatValueInterpreter: LITERAL            
          editingFormat: dd/MM/yyyy                 
          editingFormatValueInterpreter: LITERAL
        useCustomLabel: false
        dataType: DATE
                      


      - _type: DateField
        _name: DateFinAffectation
        value: DateFinAffectation
        labelProperties:
          alignment: left
          typographyValueInterpreter: LITERAL
          typography: body-2
          color: md:black
        componentProperties:                 
          displayFormat: dd/MM/yyyy                
          displayFormatValueInterpreter: LITERAL            
          editingFormat: dd/MM/yyyy                 
          editingFormatValueInterpreter: LITERAL
        useCustomLabel: false
        dataType: DATE
                      