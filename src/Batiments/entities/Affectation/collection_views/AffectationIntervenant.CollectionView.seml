_package: Batiments.entities.Affectation.collection_views
_type: CollectionView
_name: AffectationIntervenant
entity: Batiments.entities.Affectation.Affectation
default: false
displayCard: Batiments.entities.Affectation.display_cards.AffectationDisplayCard
gridAllowed: false
gridColumns: 4
gridTextPosition: BOTTOM
gridTileHeight: 1:1
gridTileLines: 1
listAllowed: true
listItemLines: 1
listShowDisplayCardAvatar: false
listShowDivider: true
tableAllowed: true
tableDisplayCardColumnLabel: Affectation
tableRowLines: 1
tableShowDisplayCard: false
tableColumns:

