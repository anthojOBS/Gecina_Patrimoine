  - _type: ReferenceColumn
    _name: FDN_Immeuble
    value: FDN_Immeuble
    label: Immeuble
    useCustomLabel: true
    dataType: STRING
    columnAlign: LEFT
    visibleByDefault: true
    referencedEntity: Batiments.entities.Immeuble.Immeuble

  - _type: ReferenceColumn
    _name: FDN_TypeAffectation
    value: FDN_TypeAffectation
    useCustomLabel: false
    dataType: STRING
    columnAlign: LEFT
    visibleByDefault: true
    referencedEntity: Batiments.entities.TypeAffectation.TypeAffectation


  - _type: TextColumn
    _name: DateDebAffectation
    value: DateDebAffectation
    useCustomLabel: false
    dataType: DATE
    columnAlign: LEFT
    visibleByDefault: true
    componentProperties:                 
          displayFormat: dd/MM/yyyy                
          displayFormatValueInterpreter: LITERAL  

  - _type: TextColumn
    _name: DateFinAffectation
    value: DateFinAffectation
    useCustomLabel: false
    dataType: DATE
    columnAlign: LEFT
    visibleByDefault: true
    componentProperties:                 
          displayFormat: dd/MM/yyyy                
          displayFormatValueInterpreter: LITERAL  
