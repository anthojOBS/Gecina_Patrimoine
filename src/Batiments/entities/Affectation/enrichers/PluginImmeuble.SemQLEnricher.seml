_package: Batiments.entities.Affectation.enrichers
_name: PluginImmeuble
_type: JavaPluginEnricher
entity: Batiments.entities.Affectation.Affectation
label: Alimentation Immeuble
enricherExecutionScope: PRE_CONSO

numberOfRetry: 1
onErrorBehavior: FAIL_JOB

pluginId: com.semarchy.engine.plugins.convergence.lookup
pluginParams:
  - paramName: PARAM_CACHE
    value: NO_CACHE

  - paramName: PARAM_CUSTOM_SQL
    value: |  
      SELECT I.IDENTIFIANTS_ERP LOOKUP_COLUMN, I.IMMEUBLE_ID OUTPUT_COLUMN1
      FROM GD_IMMEUBLE I

  - paramName: PARAM_FALLBACK_BEHAVIOR
    value: USE_FALLBACK

  # - paramName: PARAM_FALLBACK
  #   value: IN_LOOKUP_VALUE

  # - paramName: PARAM_LOOKUP_COLUMN
  #   value: IDENTIFIANTS_ERP

  # - paramName: PARAM_MAPPING_TABLE
  #   value: GD_IMMEUBLE

  # - paramName: PARAM_OUTPUT_COLUMNS
  #   value: IMMEUBLE_ID



pluginInputs:
  - inputName: IN_LOOKUP_VALUE
    expression: IdentifiantsERP
    

pluginOutputs: 
  - outputName: OUT_RESULT1
    attributeName: IdentifiantImmeuble


processingBatchSize: 1000
threadPoolSize: 1