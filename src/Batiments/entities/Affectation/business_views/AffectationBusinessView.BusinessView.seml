  form: Batiments.entities.Affectation.forms.AffectationImmeubleForm
  outlineVisible: false
  displayRecordCount: ALWAYS
  businessEntitySearchConfigs:
    - _name: TextConfig
      _type: BusinessEntitySearchTypeConfig
      searchType: TEXT
  overrideDefaultSort: false
  enableUserDefinedSort: true
  listAllowed: true
  tableAllowed: true
  gridAllowed: true
  sortExpression: FDN_Intervenant ASC , FDN_Immeuble ASC , FDN_TypeAffectation ASC , DateDebAffectation DESC


