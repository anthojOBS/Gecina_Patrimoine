    _name: QuartierParisCode
    label: Code QuartierParis
    physicalName: QUARTIER_PARIS_ID
    dataType: String
    length: 50
    mandatory: true
    searchable: true
  - _type: EntityAttribute
    _name: QuartierParisLibelle
    label: Libellé QuartierParis
    physicalName: LIBELLE
    dataType: String
    length: 255
    mandatory: false
    searchable: true
sourceIdGeneration:
  mode: MANUAL
primaryKey: Batiments.entities.QuartierParis.QuartierParis.QuartierParisCode
