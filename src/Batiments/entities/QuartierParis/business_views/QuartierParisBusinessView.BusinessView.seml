_package: Batiments.entities.QuartierParis.business_views
_type: BusinessView
_name: QuartierParisBusinessView
entity: Batiments.entities.QuartierParis.QuartierParis
rootLabel: Quartier Paris
rootPluralLabel: Quartier Paris
displayRootNodeAs: ICON_LABEL
label: Quartier Paris
rootBusinessViewEntity:
  _type: BusinessViewEntity
  _name: QuartierParis
  displayCard: Batiments.entities.QuartierParis.display_cards.QuartierParisDisplayCard
  entity: Batiments.entities.QuartierParis.QuartierParis
  actionSet: Batiments.entities.QuartierParis.action_sets.QuartierParisActionSet
  collection: Batiments.entities.QuartierParis.collection_views.QuartierParisCollectionView
  form: Batiments.entities.QuartierParis.forms.QuartierParisForm
  outlineVisible: false
  displayRecordCount: ALWAYS
  businessEntitySearchConfigs:
    - _name: TextConfig
      _type: BusinessEntitySearchTypeConfig
      searchType: TEXT
    # - _name: FormConfig
    #   _type: BusinessEntitySearchTypeConfig
    #   searchType: BY_FORM
    # - _name: AdvancedConfig
    #   _type: BusinessEntitySearchTypeConfig
    #   searchType: ADVANCED
    # - _name: SemqlConfig
    #   _type: BusinessEntitySearchTypeConfig
    #   searchType: SEMQL
  overrideDefaultSort: false
  enableUserDefinedSort: true
  listAllowed: true
  tableAllowed: true
  gridAllowed: true

  transitions:
    - _name: GoldenHistoryRecords
      _type: BusinessViewTransition
      displayFormTabAs: ICON_LABEL
      displayTransitionNodeAs: ICON_LABEL
      enableHierarchy: '0'
      enableHierarchyInterpreter: LITERAL
      expandHierarchyByDefault: false
      iconUrl: images://mdi/history.svg
      label: History
      pluralLabel: History
      transitionPath: GoldenHistoryRecords
      transitionType: FULLY_QUALIFIED
      transitionVisible: '1'
      transitionVisibleInterpreter: LITERAL
      useCustomLabel: true
      businessViewEntity: 
        _type: BusinessViewEntityReference
        ref: Batiments.entities.QuartierParis.business_views.QuartierParisBusinessView.QuartierParis
      filter: 1 = 1
enableHierarchyView: false
useHierarchyOnOpen: false
