_package: Batiments.entities.Service.forms
_type: Form
_name: ServiceForm
entity: Batiments.entities.Service.Service
default: true
formTabs:
  - _type: FormTab
    _name: Service
    label: Types services
    documentationInterpreter: LITERAL
    visibleValue:  Lot.FID_TypologieLot = 'SNI'
    visibleValueInterpreter: SEMQL
    displayFormTabAs: LABEL
    content:
        - _type: ReferenceField
          _name: FDN_TypeService
          value: FDN_TypeService
          label: Types services
          labelProperties:
            alignment: left
            typography: body-2
            color: md:black
          useCustomLabel: true
          dataType: STRING
          referencedEntity: Batiments.entities.TypeService.TypeService

