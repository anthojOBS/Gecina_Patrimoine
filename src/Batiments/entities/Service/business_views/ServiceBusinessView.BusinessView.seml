_package: Batiments.entities.Service.business_views
_type: BusinessView
_name: ServiceBusinessView
entity: Batiments.entities.Service.Service
rootLabel: Service
rootPluralLabel: Service
displayRootNodeAs: ICON_LABEL
label: Service
rootBusinessViewEntity:
  _type: BusinessViewEntity
  _name: Service
  displayCard: Batiments.entities.Service.display_cards.ServiceDisplayCard
  entity: Batiments.entities.Service.Service
  actionSet: Batiments.entities.Service.action_sets.ServiceActionSet
  collection: Batiments.entities.Service.collection_views.ServiceCollectionView
  form: Batiments.entities.Service.forms.ServiceForm
  outlineVisible: false
  displayRecordCount: ALWAYS
  businessEntitySearchConfigs:
    - _name: TextConfig
      _type: BusinessEntitySearchTypeConfig
      searchType: TEXT
    # - _name: FormConfig
    #   _type: BusinessEntitySearchTypeConfig
    #   searchType: BY_FORM
    # - _name: AdvancedConfig
    #   _type: BusinessEntitySearchTypeConfig
    #   searchType: ADVANCED
    # - _name: SemqlConfig
    #   _type: BusinessEntitySearchTypeConfig
    #   searchType: SEMQL
  overrideDefaultSort: false
  enableUserDefinedSort: true
  listAllowed: true
  tableAllowed: true
  gridAllowed: true

  transitions:
    - _name: GoldenHistoryRecords
      _type: BusinessViewTransition
      displayFormTabAs: ICON_LABEL
      displayTransitionNodeAs: ICON_LABEL
      enableHierarchy: '0'
      enableHierarchyInterpreter: LITERAL
      expandHierarchyByDefault: false
      iconUrl: images://mdi/history.svg
      label: History
      pluralLabel: History
      transitionPath: GoldenHistoryRecords
      transitionType: FULLY_QUALIFIED
      transitionVisible: '1'
      transitionVisibleInterpreter: LITERAL
      useCustomLabel: true
      businessViewEntity: 
        _type: BusinessViewEntityReference
        ref: Batiments.entities.Service.business_views.ServiceBusinessView.Service
      filter: 1 = 1
enableHierarchyView: false
useHierarchyOnOpen: false
