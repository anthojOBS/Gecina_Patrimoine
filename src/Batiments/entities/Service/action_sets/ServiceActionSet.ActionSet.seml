_package: Batiments.entities.Service.action_sets
_type: ActionSet
_name: ServiceActionSet
entity: Batiments.entities.Service.Service
label: Service Action Set
defaultActionSet: true
actions:
  - _type: CreateAction
    _name: CreateAuthorService
    label: Create
    useCustomLabel: true
    stepper: Batiments.entities.Service.steppers.AuthorService
    createMultiple: false
    createdRecordType: GOLDEN
    waitDialogEnabled: false
    allowOtherPublishers: true
  - _type: EditAction
    _name: EditAuthorService
    label: Edit
    useCustomLabel: true
    stepper: Batiments.entities.Service.steppers.AuthorService
    multipleSelectionAllowed: true
    availableForGoldenData: true
    availableForMasterData: false
    availableForErrorData: true
    waitDialogEnabled: false
  - _type: MassUpdateAction
    _name: MassUpdateAuthorService
    label: Mass Update
    useCustomLabel: true
    stepper: Batiments.entities.Service.steppers.AuthorService
    availableForGoldenData: true
    availableForErrorData: true
    availableForMasterData: false
    waitDialogEnabled: false
  - _type: DeleteAction
    _name: Delete
    label: Delete
    useCustomLabel: true
    multipleSelectionAllowed: true
    deleteType: HARD_DELETE
    waitDialogEnabled: false
    availableForGoldenData: true
    availableForMasterData: false
  - _type: ExportAction
    _name: Export
    label: Export
    useCustomLabel: true
    waitDialogEnabled: false
  - _type: ImportAction
    _name: ImportAuthorService
    label: Import
    useCustomLabel: true
    importMode: CREATE_AND_UPDATE
    stepper: Batiments.entities.Service.steppers.AuthorService
    importedRecordType: GOLDEN
    waitDialogEnabled: false
    allowOtherPublishers: true
  - _type: BrowseGraphAction
    _name: BrowseGraph
    label: Browse Graph
    useCustomLabel: true
    waitDialogEnabled: false
