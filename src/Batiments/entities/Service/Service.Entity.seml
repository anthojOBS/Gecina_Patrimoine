_package: Batiments.entities.Service
_type: Entity
_name: Service
label: Service
pluralLabel: Service
entityType: FUZZY_MATCHED
physicalTableName: SERVICE
description: Service
documentation: |
  Service
historizeGolden: true
historizeMaster: false
enableDelete: true
attributes:
  - _type: EntityAttribute
    _name: ServiceID
    label: Service ID
    physicalName: SERVICE_ID
    dataType: LongInteger
    precision: 38
    mandatory: false
    searchable: false

sourceIdGeneration:
  mode: MANUAL
primaryKey: Batiments.entities.Service.Service.ServiceID


goldenIdGeneration:
  mode: SEQUENCE
  startWith: 1

matcher:
  _type: SemQLMatcher
  _name: Matcher
  description: BatimentSemQLMatcher
  matchRules:
    - _type: SemQLMatchRule
      _name: NewRule
      label: NewRuleLabel
      condition:  Record1.FID_TypeService=Record2.FID_TypeService and Record1.FID_Lot = Record2.FID_Lot 
 
      matchScore: 100
      usingMatchOn: false
  useTransitiveMatchScore: true
  useMultiIterationGrouping: true
  mergeThresholdNewGroup: 90
  mergeThresholdMergingUnconfirmed: 90
  mergeThresholdMergingConfirmed: 90
  mergeThresholdMergingConfirmedWithUnconfirmed: 90
  mergeThresholdMergingUnconfirmedWithNewMasters: 90
  mergeThresholdMergingConfirmedWithNewMasters: 90
  mergeThresholdRemergingPreviouslySplit: 100
  autoConfirmGoldenThreshold: 99
  autoConfirmSingletons: false