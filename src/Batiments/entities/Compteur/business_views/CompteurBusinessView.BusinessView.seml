_package: Batiments.entities.Compteur.business_views
_type: BusinessView
_name: CompteurBusinessView
entity: Batiments.entities.Compteur.Compteur
rootLabel: Compteur
rootPluralLabel: Compteur
displayRootNodeAs: ICON_LABEL
label: Compteur
rootBusinessViewEntity:
  _type: BusinessViewEntity
  _name: Compteur
  displayCard: Batiments.entities.Compteur.display_cards.CompteurDisplayCard
  entity: Batiments.entities.Compteur.Compteur
  actionSet: Batiments.entities.Compteur.action_sets.CompteurActionSet
  collection: Batiments.entities.Compteur.collection_views.CompteurCollectionView
  form: Batiments.entities.Compteur.forms.CompteurForm
  outlineVisible: false
  displayRecordCount: ALWAYS
  businessEntitySearchConfigs:
    - _name: TextConfig
      _type: BusinessEntitySearchTypeConfig
      searchType: TEXT
    - _name: FormConfig
      _type: BusinessEntitySearchTypeConfig
      searchType: BY_FORM
    - _name: AdvancedConfig
      _type: BusinessEntitySearchTypeConfig
      searchType: ADVANCED
    - _name: SemqlConfig
      _type: BusinessEntitySearchTypeConfig
      searchType: SEMQL
  overrideDefaultSort: false
  enableUserDefinedSort: true
  listAllowed: true
  tableAllowed: true
  gridAllowed: true

  transitions:
    - _name: GoldenHistoryRecords
      _type: BusinessViewTransition
      displayFormTabAs: ICON_LABEL
      displayTransitionNodeAs: ICON_LABEL
      enableHierarchy: '0'
      enableHierarchyInterpreter: LITERAL
      expandHierarchyByDefault: false
      iconUrl: images://mdi/history.svg
      label: History
      pluralLabel: History
      transitionPath: GoldenHistoryRecords
      transitionType: FULLY_QUALIFIED
      transitionVisible: '1'
      transitionVisibleInterpreter: LITERAL
      useCustomLabel: true
      businessViewEntity: 
        _type: BusinessViewEntityReference
        ref: Batiments.entities.Compteur.business_views.CompteurBusinessView.Compteur
      filter: 1 = 1
enableHierarchyView: false
useHierarchyOnOpen: false
