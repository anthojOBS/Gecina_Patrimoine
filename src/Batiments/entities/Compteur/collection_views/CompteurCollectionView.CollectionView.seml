_package: Batiments.entities.Compteur.collection_views
_type: CollectionView
_name: CompteurCollectionView
entity: Batiments.entities.Compteur.Compteur
default: true
displayCard: Batiments.entities.Compteur.display_cards.CompteurDisplayCard
gridAllowed: false
gridColumns: 4
gridTextPosition: BOTTOM
gridTileHeight: 1:1
gridTileLines: 1
listAllowed: true
listItemLines: 1
listShowDisplayCardAvatar: false
listShowDivider: true
tableAllowed: true
tableDisplayCardColumnLabel: Compteur
tableRowLines: 1
tableShowDisplayCard: false
tableColumns:
  - _type: TextColumn
    _name: CompteurID
    value: CompteurID
    useCustomLabel: false
    dataType: INTEGER
    columnAlign: LEFT
    visibleByDefault: false
  - _type: ReferenceColumn
    _name: FDN_Lot
    value: FDN_Lot
    useCustomLabel: false
    dataType: STRING
    columnAlign: LEFT
    visibleByDefault: false
    referencedEntity: Batiments.entities.Lot.Lot
  - _type: ReferenceColumn
    _name: FDN_TypeCompteur
    value: FDN_TypeCompteur
    useCustomLabel: true
    label: Type compteur
    dataType: STRING
    columnAlign: LEFT
    visibleByDefault: true
    referencedEntity: Batiments.entities.TypeCompteur.TypeCompteur

  - _type: TextColumn
    _name: Ref_compteur
    value: Ref_compteur
    useCustomLabel: true
    label: Référence compteur
    dataType: STRING
    columnAlign: LEFT
    visibleByDefault: true


  - _type: ReferenceColumn
    _name: FDN_Equipementier
    value: FDN_Equipementier
    useCustomLabel: true
    label: Equipementier
    dataType: STRING
    columnAlign: LEFT
    visibleByDefault: true
    referencedEntity: Batiments.entities.Equipementier.Equipementier


  - _type: DateColumn
    _name: Dt_mise_service
    value: Dt_mise_service
    useCustomLabel: true
    label: Date mise en service
    dataType: DATE
    columnAlign: LEFT
    visibleByDefault: true
  - _type: DateColumn
    _name: Dt_fin
    value: Dt_fin
    useCustomLabel: true
    label: Date fin
    dataType: DATE
    columnAlign: LEFT
    visibleByDefault: true
  - _type: TextColumn
    _name: Point_Livraison
    value: Point_Livraison
    useCustomLabel: true
    label: Point livraison
    dataType: STRING
    columnAlign: LEFT
    visibleByDefault: true

  - _type: ReferenceColumn
    _name: FDN_LocalisationCompteur
    value: FDN_LocalisationCompteur
    useCustomLabel: true
    label: Localisation compteur
    dataType: STRING
    columnAlign: LEFT
    visibleByDefault: true
    referencedEntity: Batiments.entities.LocalisationCompteur.LocalisationCompteur

