_package: Batiments.entities.FiscaliteCible.business_views
_type: BusinessView
_name: FiscaliteCibleBusinessView
entity: Batiments.entities.FiscaliteCible.FiscaliteCible
rootLabel: Fiscalité Cible
rootPluralLabel: Fiscalité Cible
displayRootNodeAs: ICON_LABEL
label: Fiscalité Cible
rootBusinessViewEntity:
  _type: BusinessViewEntity
  _name: FiscaliteCible
  displayCard: Batiments.entities.FiscaliteCible.display_cards.FiscaliteCibleDisplayCard
  entity: Batiments.entities.FiscaliteCible.FiscaliteCible
  actionSet: Batiments.entities.FiscaliteCible.action_sets.FiscaliteCibleActionSet
  collection: Batiments.entities.FiscaliteCible.collection_views.FiscaliteCibleCollectionView
  form: Batiments.entities.FiscaliteCible.forms.FiscaliteCibleForm
  outlineVisible: false
  displayRecordCount: ALWAYS
  businessEntitySearchConfigs:
    - _name: TextConfig
      _type: BusinessEntitySearchTypeConfig
      searchType: TEXT
  overrideDefaultSort: false
  enableUserDefinedSort: true
  listAllowed: true
  tableAllowed: true
  gridAllowed: true

  transitions:
    - _name: GoldenHistoryRecords
      _type: BusinessViewTransition
      displayFormTabAs: ICON_LABEL
      displayTransitionNodeAs: ICON_LABEL
      enableHierarchy: '0'
      enableHierarchyInterpreter: LITERAL
      expandHierarchyByDefault: false
      iconUrl: images://mdi/history.svg
      label: History
      pluralLabel: History
      transitionPath: GoldenHistoryRecords
      transitionType: FULLY_QUALIFIED
      transitionVisible: '1'
      transitionVisibleInterpreter: LITERAL
      useCustomLabel: true
      businessViewEntity: 
        _type: BusinessViewEntityReference
        ref: Batiments.entities.FiscaliteCible.business_views.FiscaliteCibleBusinessView.FiscaliteCible
      filter: 1 = 1
enableHierarchyView: false
useHierarchyOnOpen: false
