_package: Batiments.entities.PeriodeConstruction.action_sets
_type: ActionSet
_name: PeriodeConstructionActionSet
entity: Batiments.entities.PeriodeConstruction.PeriodeConstruction
label: PeriodeConstruction Action Set
defaultActionSet: true
actions:
  - _type: CreateAction
    _name: CreateAuthorPeriodeConstruction
    label: Create
    useCustomLabel: true
    stepper: Batiments.entities.PeriodeConstruction.steppers.AuthorPeriodeConstruction
    createMultiple: false
    createdRecordType: GOLDEN
    waitDialogEnabled: false
    allowOtherPublishers: true
  - _type: EditAction
    _name: EditAuthorPeriodeConstruction
    label: Edit
    useCustomLabel: true
    stepper: Batiments.entities.PeriodeConstruction.steppers.AuthorPeriodeConstruction
    multipleSelectionAllowed: true
    availableForGoldenData: true
    availableForMasterData: false
    availableForErrorData: true
    waitDialogEnabled: false
  - _type: MassUpdateAction
    _name: MassUpdateAuthorPeriodeConstruction
    label: Mass Update
    useCustomLabel: true
    stepper: Batiments.entities.PeriodeConstruction.steppers.AuthorPeriodeConstruction
    availableForGoldenData: true
    availableForErrorData: true
    availableForMasterData: false
    waitDialogEnabled: false
  - _type: DeleteAction
    _name: Delete
    label: Delete
    useCustomLabel: true
    multipleSelectionAllowed: true
    deleteType: HARD_DELETE
    waitDialogEnabled: false
    availableForGoldenData: true
    availableForMasterData: false
    requiredRole: semarchyAdmin
  - _type: ExportAction
    _name: Export
    label: Export
    useCustomLabel: true
    waitDialogEnabled: false
  - _type: ImportAction
    _name: ImportAuthorPeriodeConstruction
    label: Import
    useCustomLabel: true
    importMode: CREATE_AND_UPDATE
    stepper: Batiments.entities.PeriodeConstruction.steppers.AuthorPeriodeConstruction
    importedRecordType: GOLDEN
    waitDialogEnabled: false
    allowOtherPublishers: true
