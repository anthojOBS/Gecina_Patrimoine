_package: Batiments.entities.UsageLot.collection_views
_type: CollectionView
_name: UsageLotCollectionView
entity: Batiments.entities.UsageLot.UsageLot
default: true
displayCard: Batiments.entities.UsageLot.display_cards.UsageLotDisplayCard
gridAllowed: false
gridColumns: 4
gridTextPosition: BOTTOM
gridTileHeight: 1:1
gridTileLines: 1
listAllowed: true
listItemLines: 1
listShowDisplayCardAvatar: false
listShowDivider: true
tableAllowed: true
tableDisplayCardColumnLabel: Usage Lot
tableRowLines: 1
tableShowDisplayCard: true
tableColumns:
  - _type: IdColumn
    _name: UsageLotCode
    value: UsageLotCode
    useCustomLabel: false
    dataType: STRING
    columnAlign: LEFT
    visibleByDefault: true
  - _type: TextColumn
    _name: UsageLotLibelle
    value: UsageLotLibelle
    useCustomLabel: false
    dataType: STRING
    columnAlign: LEFT
    visibleByDefault: true

  - _type: TextColumn
    _name: UpdateDate
    value: UpdateDate
    useCustomLabel: false
    dataType: DATE
    columnAlign: LEFT
    visibleByDefault: true
    
  - _type: TextColumn
    _name: Updator
    value: Updator
    useCustomLabel: false
    dataType: STRING
    columnAlign: LEFT
    visibleByDefault: true
