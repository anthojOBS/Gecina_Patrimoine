_package: Batiments.entities.UsageLot
_type: Entity
_name: UsageLot
label: Usage Lot
pluralLabel: Usages Lot
entityType: BASIC
physicalTableName: USAGE_LOT
iconUrl: images://mdi/tag.svg
description: ""
documentation: |
  L'**Usage de Lot** définit la destination fonctionnelle d'un lot.
  
  L'usage caractérise l'utilisation effective ou prévue d'un lot (habitation, bureau, commerce, entrepôt, parking, etc.).
  
  Cette entité est essentielle pour la gestion locative, l'analyse des revenus et le respect des réglementations d'urbanisme.
historizeGolden: true
historizeMaster: false
enableDelete: true
attributes:
  - _type: EntityAttribute
    _name: UsageLotCode
    label: Code Usage Lot
    physicalName: USAGE_LOT_ID
    dataType: String
    length: 50
    mandatory: true
    searchable: true
  - _type: EntityAttribute
    _name: UsageLotLibelle
    label: Libellé Usage Lot
    physicalName: LIBELLE
    dataType: String
    length: 255
    mandatory: false
    searchable: true
sourceIdGeneration:
  mode: MANUAL
primaryKey: Batiments.entities.UsageLot.UsageLot.UsageLotCode
