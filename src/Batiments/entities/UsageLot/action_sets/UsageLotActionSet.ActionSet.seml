_package: Batiments.entities.UsageLot.action_sets
_type: ActionSet
_name: UsageLotActionSet
entity: Batiments.entities.UsageLot.UsageLot
label: Usage Lot Action Set
defaultActionSet: true
actions:
  - _type: CreateAction
    _name: CreateAuthorUsageLots
    label: Create
    useCustomLabel: true
    stepper: Batiments.entities.UsageLot.steppers.AuthorUsageLots
    createMultiple: false
    createdRecordType: GOLDEN
    waitDialogEnabled: false
    allowOtherPublishers: true
  - _type: EditAction
    _name: EditAuthorUsageLots
    label: Edit
    useCustomLabel: true
    stepper: Batiments.entities.UsageLot.steppers.AuthorUsageLots
    multipleSelectionAllowed: true
    availableForGoldenData: true
    availableForMasterData: false
    availableForErrorData: true
    waitDialogEnabled: false
  - _type: MassUpdateAction
    _name: MassUpdateAuthorUsageLots
    label: Mass Update
    useCustomLabel: true
    stepper: Batiments.entities.UsageLot.steppers.AuthorUsageLots
    availableForGoldenData: true
    availableForErrorData: true
    availableForMasterData: false
    waitDialogEnabled: false
  - _type: DeleteAction
    _name: Delete
    label: Delete
    useCustomLabel: true
    multipleSelectionAllowed: true
    deleteType: HARD_DELETE
    waitDialogEnabled: false
    availableForGoldenData: true
    availableForMasterData: false
  - _type: ExportAction
    _name: Export
    label: Export
    useCustomLabel: true
    waitDialogEnabled: false
  - _type: ImportAction
    _name: ImportAuthorUsageLots
    label: Import
    useCustomLabel: true
    importMode: CREATE_AND_UPDATE
    stepper: Batiments.entities.UsageLot.steppers.AuthorUsageLots
    importedRecordType: GOLDEN
    waitDialogEnabled: false
    allowOtherPublishers: true
  - _type: BrowseGraphAction
    _name: BrowseGraph
    label: Browse Graph
    useCustomLabel: true
    waitDialogEnabled: false
