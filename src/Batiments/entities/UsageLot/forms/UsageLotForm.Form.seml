_package: Batiments.entities.UsageLot.forms
_type: Form
_name: UsageLotForm
entity: Batiments.entities.UsageLot.UsageLot
default: true
formTabs:
  - _type: FormTab
    _name: UsageLot
    label: Usage Lot
    documentationInterpreter: LITERAL
    visibleValue: "1"
    visibleValueInterpreter: LITERAL
    displayFormTabAs: LABEL
    content:
      - _type: IdField
        _name: UsageLotCode
        value: UsageLotCode
        useCustomLabel: false
        dataType: STRING
        labelProperties:
          typographyValueInterpreter: LITERAL
          typography: body-2
          color: md:black
      - _type: TextField
        _name: UsageLotLibelle
        value: UsageLotLibelle
        useCustomLabel: false
        dataType: STRING
        labelProperties:
          typographyValueInterpreter: LITERAL
          typography: body-2
          color: md:black
