_package: Batiments.entities.UsageLot.business_views
_type: BusinessView
_name: UsageLotBusinessView
entity: Batiments.entities.UsageLot.UsageLot
rootLabel: Usage Lot
rootPluralLabel: Usages Lot
displayRootNodeAs: ICON_LABEL
label: Usages des Lots
rootBusinessViewEntity:
  _type: BusinessViewEntity
  _name: UsageLot
  displayCard: Batiments.entities.UsageLot.display_cards.UsageLotDisplayCard
  entity: Batiments.entities.UsageLot.UsageLot
  actionSet: Batiments.entities.UsageLot.action_sets.UsageLotActionSet
  collection: Batiments.entities.UsageLot.collection_views.UsageLotCollectionView
  form: Batiments.entities.UsageLot.forms.UsageLotForm
  outlineVisible: false
  displayRecordCount: ALWAYS
  businessEntitySearchConfigs:
    - _name: TextConfig
      _type: BusinessEntitySearchTypeConfig
      searchType: TEXT
    - _name: FormConfig
      _type: BusinessEntitySearchTypeConfig
      searchType: BY_FORM
    - _name: AdvancedConfig
      _type: BusinessEntitySearchTypeConfig
      searchType: ADVANCED
    - _name: SemqlConfig
      _type: BusinessEntitySearchTypeConfig
      searchType: SEMQL
  overrideDefaultSort: false
  enableUserDefinedSort: true
  listAllowed: true
  tableAllowed: true
  gridAllowed: true

  transitions:
    - _name: GoldenHistoryRecords
      _type: BusinessViewTransition
      displayFormTabAs: ICON_LABEL
      displayTransitionNodeAs: ICON_LABEL
      enableHierarchy: '0'
      enableHierarchyInterpreter: LITERAL
      expandHierarchyByDefault: false
      iconUrl: images://mdi/history.svg
      label: History
      pluralLabel: History
      transitionPath: GoldenHistoryRecords
      transitionType: FULLY_QUALIFIED
      transitionVisible: '1'
      transitionVisibleInterpreter: LITERAL
      useCustomLabel: true
      businessViewEntity: 
        _type: BusinessViewEntityReference
        ref: Batiments.entities.UsageLot.business_views.UsageLotBusinessView.UsageLot
      filter: 1 = 1
enableHierarchyView: false
useHierarchyOnOpen: false
