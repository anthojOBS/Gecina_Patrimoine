_package: Batiments.entities.GenreBien.business_views
_type: BusinessView
_name: GenreBienBusinessView
entity: Batiments.entities.GenreBien.GenreBien
rootLabel: Genre de Bien
rootPluralLabel: Genres de Bien
displayRootNodeAs: ICON_LABEL
label: Genres de Bien
rootBusinessViewEntity:
  _type: BusinessViewEntity
  _name: GenreBien
  displayCard: Batiments.entities.GenreBien.display_cards.GenreBienDisplayCard
  entity: Batiments.entities.GenreBien.GenreBien
  actionSet: Batiments.entities.GenreBien.action_sets.GenreBienActionSet
  collection: Batiments.entities.GenreBien.collection_views.GenreBienCollectionView
  form: Batiments.entities.GenreBien.forms.GenreBienForm
  outlineVisible: false
  displayRecordCount: ALWAYS
  businessEntitySearchConfigs:
    - _name: TextConfig
      _type: BusinessEntitySearchTypeConfig
      searchType: TEXT
    - _name: FormConfig
      _type: BusinessEntitySearchTypeConfig
      searchType: BY_FORM
    - _name: AdvancedConfig
      _type: BusinessEntitySearchTypeConfig
      searchType: ADVANCED
    - _name: SemqlConfig
      _type: BusinessEntitySearchTypeConfig
      searchType: SEMQL
  overrideDefaultSort: false
  enableUserDefinedSort: true
  listAllowed: true
  tableAllowed: true
  gridAllowed: true

  transitions:
    - _name: GoldenHistoryRecords
      _type: BusinessViewTransition
      displayFormTabAs: ICON_LABEL
      displayTransitionNodeAs: ICON_LABEL
      enableHierarchy: '0'
      enableHierarchyInterpreter: LITERAL
      expandHierarchyByDefault: false
      iconUrl: images://mdi/history.svg
      label: History
      pluralLabel: History
      transitionPath: GoldenHistoryRecords
      transitionType: FULLY_QUALIFIED
      transitionVisible: '1'
      transitionVisibleInterpreter: LITERAL
      useCustomLabel: true
      businessViewEntity: 
        _type: BusinessViewEntityReference
        ref: Batiments.entities.GenreBien.business_views.GenreBienBusinessView.GenreBien
      filter: 1 = 1
enableHierarchyView: false
useHierarchyOnOpen: false
