_package: Batiments.entities.GenreBien
_type: Entity
_name: GenreBien
label: Genre de Bien
pluralLabel: Genres de Bien
entityType: BASIC
physicalTableName: GENRE_BIEN
iconUrl: images://mdi/home-city.svg
description: ""
documentation: |
  Le **Genre de Bien** caractérise la nature d'un lot selon sa classification immobilière.
  
  Le genre de bien permet de distinguer les différentes catégories d'actifs (commercial, résidentiel, mixte, etc.) et facilite la segmentation du patrimoine.
  
  Cette entité est importante pour l'analyse financière et la gestion locative du portefeuille.
historizeGolden: true
historizeMaster: false
enableDelete: true
attributes:
  - _type: EntityAttribute
    _name: GenreBienCode
    label: Code Genre Bien
    physicalName: GENRE_BIEN_ID
    dataType: String
    length: 50
    mandatory: true
    searchable: true
  - _type: EntityAttribute
    _name: GenreBienLibelle
    label: Libellé Genre Bien
    physicalName: LIBELLE
    dataType: String
    length: 255
    mandatory: false
    searchable: true
sourceIdGeneration:
  mode: MANUAL
primaryKey: Batiments.entities.GenreBien.GenreBien.GenreBienCode
