_package: Batiments.entities.TypeCompteur.action_sets
_type: ActionSet
_name: TypeCompteurActionSet
entity: Batiments.entities.TypeCompteur.TypeCompteur
label: TypeCompteur Action Set
defaultActionSet: true
actions:
  - _type: CreateAction
    _name: CreateAuthorTypeCompteur
    label: Create
    useCustomLabel: true
    stepper: Batiments.entities.TypeCompteur.steppers.AuthorTypeCompteur
    createMultiple: false
    createdRecordType: GOLDEN
    waitDialogEnabled: false
    allowOtherPublishers: true
  - _type: EditAction
    _name: EditAuthorTypeCompteur
    label: Edit
    useCustomLabel: true
    stepper: Batiments.entities.TypeCompteur.steppers.AuthorTypeCompteur
    multipleSelectionAllowed: true
    availableForGoldenData: true
    availableForMasterData: false
    availableForErrorData: true
    waitDialogEnabled: false
  - _type: MassUpdateAction
    _name: MassUpdateAuthorTypeCompteur
    label: Mass Update
    useCustomLabel: true
    stepper: Batiments.entities.TypeCompteur.steppers.AuthorTypeCompteur
    availableForGoldenData: true
    availableForErrorData: true
    availableForMasterData: false
    waitDialogEnabled: false
  - _type: DeleteAction
    _name: Delete
    label: Delete
    useCustomLabel: true
    multipleSelectionAllowed: true
    deleteType: HARD_DELETE
    waitDialogEnabled: false
    availableForGoldenData: true
    availableForMasterData: false
    requiredRole: semarchyAdmin
  - _type: ExportAction
    _name: Export
    label: Export
    useCustomLabel: true
    waitDialogEnabled: false
  - _type: ImportAction
    _name: ImportAuthorTypeCompteur
    label: Import
    useCustomLabel: true
    importMode: CREATE_AND_UPDATE
    stepper: Batiments.entities.TypeCompteur.steppers.AuthorTypeCompteur
    importedRecordType: GOLDEN
    waitDialogEnabled: false
    allowOtherPublishers: true
