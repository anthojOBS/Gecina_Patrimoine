_package: Batiments.entities.RoleImmeuble.business_views
_type: BusinessView
_name: RoleImmeubleBusinessView
entity: Batiments.entities.RoleImmeuble.RoleImmeuble
rootLabel: Rôle Immeuble
rootPluralLabel: Rôles Immeubles
displayRootNodeAs: ICON_LABEL
label: Rôle Immeuble
rootBusinessViewEntity:
  _type: BusinessViewEntity
  _name: RoleImmeuble
  displayCard: Batiments.entities.RoleImmeuble.display_cards.RoleImmeubleDisplayCard
  entity: Batiments.entities.RoleImmeuble.RoleImmeuble
  actionSet: Batiments.entities.RoleImmeuble.action_sets.RoleImmeubleActionSet
  collection: Batiments.entities.RoleImmeuble.collection_views.RoleImmeubleCollectionView
  form: Batiments.entities.RoleImmeuble.forms.RoleImmeubleForm
  outlineVisible: false
  displayRecordCount: ALWAYS
  businessEntitySearchConfigs:
    - _name: TextConfig
      _type: BusinessEntitySearchTypeConfig
      searchType: TEXT
    # - _name: FormConfig
    #   _type: BusinessEntitySearchTypeConfig
    #   searchType: BY_FORM
    # - _name: AdvancedConfig
    #   _type: BusinessEntitySearchTypeConfig
    #   searchType: ADVANCED
    # - _name: SemqlConfig
    #   _type: BusinessEntitySearchTypeConfig
    #   searchType: SEMQL
  overrideDefaultSort: false
  enableUserDefinedSort: true
  listAllowed: true
  tableAllowed: true
  gridAllowed: true

  transitions:
    - _name: GoldenHistoryRecords
      _type: BusinessViewTransition
      displayFormTabAs: ICON_LABEL
      displayTransitionNodeAs: ICON_LABEL
      enableHierarchy: '0'
      enableHierarchyInterpreter: LITERAL
      expandHierarchyByDefault: false
      iconUrl: images://mdi/history.svg
      label: History
      pluralLabel: History
      transitionPath: GoldenHistoryRecords
      transitionType: FULLY_QUALIFIED
      transitionVisible: '1'
      transitionVisibleInterpreter: LITERAL
      useCustomLabel: true
      businessViewEntity: 
        _type: BusinessViewEntityReference
        ref: Batiments.entities.RoleImmeuble.business_views.RoleImmeubleBusinessView.RoleImmeuble
      filter: 1 = 1
enableHierarchyView: false
useHierarchyOnOpen: false
