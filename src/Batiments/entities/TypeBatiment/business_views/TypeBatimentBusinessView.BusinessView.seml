_package: Batiments.entities.TypeBatiment.business_views
_type: BusinessView
_name: TypeBatimentBusinessView
entity: Batiments.entities.TypeBatiment.TypeBatiment
rootLabel: Type Bâtiment
rootPluralLabel: Type Bâtiment
displayRootNodeAs: ICON_LABEL
label: Type Bâtiment
rootBusinessViewEntity:
  _type: BusinessViewEntity
  _name: TypeBatiment
  displayCard: Batiments.entities.TypeBatiment.display_cards.TypeBatimentDisplayCard
  entity: Batiments.entities.TypeBatiment.TypeBatiment
  actionSet: Batiments.entities.TypeBatiment.action_sets.TypeBatimentActionSet
  collection: Batiments.entities.TypeBatiment.collection_views.TypeBatimentCollectionView
  form: Batiments.entities.TypeBatiment.forms.TypeBatimentForm
  outlineVisible: false
  displayRecordCount: ALWAYS
  businessEntitySearchConfigs:
    - _name: TextConfig
      _type: BusinessEntitySearchTypeConfig
      searchType: TEXT
    - _name: FormConfig
      _type: BusinessEntitySearchTypeConfig
      searchType: BY_FORM
    - _name: AdvancedConfig
      _type: BusinessEntitySearchTypeConfig
      searchType: ADVANCED
    - _name: SemqlConfig
      _type: BusinessEntitySearchTypeConfig
      searchType: SEMQL
  overrideDefaultSort: false
  enableUserDefinedSort: true
  listAllowed: true
  tableAllowed: true
  gridAllowed: true

  transitions:
    - _name: GoldenHistoryRecords
      _type: BusinessViewTransition
      displayFormTabAs: ICON_LABEL
      displayTransitionNodeAs: ICON_LABEL
      enableHierarchy: '0'
      enableHierarchyInterpreter: LITERAL
      expandHierarchyByDefault: false
      iconUrl: images://mdi/history.svg
      label: History
      pluralLabel: History
      transitionPath: GoldenHistoryRecords
      transitionType: FULLY_QUALIFIED
      transitionVisible: '1'
      transitionVisibleInterpreter: LITERAL
      useCustomLabel: true
      businessViewEntity: 
        _type: BusinessViewEntityReference
        ref: Batiments.entities.TypeBatiment.business_views.TypeBatimentBusinessView.TypeBatiment
      filter: 1 = 1
enableHierarchyView: false
useHierarchyOnOpen: false
