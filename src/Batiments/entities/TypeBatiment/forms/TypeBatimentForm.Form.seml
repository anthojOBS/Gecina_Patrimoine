_package: Batiments.entities.TypeBatiment.forms
_type: Form
_name: TypeBatimentForm
entity: Batiments.entities.TypeBatiment.TypeBatiment
default: true
formTabs:
  - _type: FormTab
    _name: TypeBatiment
    label: Type Batiment
    documentationInterpreter: LITERAL
    visibleValue: "1"
    visibleValueInterpreter: LITERAL
    displayFormTabAs: LABEL
    content:
      - _type: IdField
        _name: TypeBatimentCode
        value: TypeBatimentCode
        useCustomLabel: false
        dataType: STRING
        labelProperties:
          typographyValueInterpreter: LITERAL
          typography: body-2
          color: md:black
      - _type: TextField
        _name: TypeBatimentLibelle
        value: TypeBatimentLibelle
        useCustomLabel: false
        dataType: STRING
        labelProperties:
          typographyValueInterpreter: LITERAL
          typography: body-2
          color: md:black
