_package: Batiments.entities.TypeBatiment
_type: Entity
_name: TypeBatiment
label: Type Batiment
pluralLabel: Type Batiments
entityType: BASIC
physicalTableName: TYPE_BATIMENT
iconUrl: images://mdi/office-building.svg
description: ""
documentation: |
  Le **Type de Bâtiment** caractérise la nature et l'usage architectural d'un bâtiment.
  
  Le type de bâtiment permet de classifier les structures selon leur fonction principale et leurs caractéristiques architecturales (tour de bureaux, immeuble résidentiel, centre commercial, etc.).
  
  Cette entité facilite la segmentation et l'analyse du patrimoine immobilier par typologie d'actifs.
historizeGolden: true
historizeMaster: false
enableDelete: true
attributes:
  - _type: EntityAttribute
    _name: TypeBatimentCode
    label: Code Type Batiment
    physicalName: TYPE_BATIMENT_ID
    dataType: String
    length: 50
    mandatory: true
    searchable: true
  - _type: EntityAttribute
    _name: TypeBatimentLibelle
    label: Libellé Type Batiment
    physicalName: LIBELLE
    dataType: String
    length: 255
    mandatory: false
    searchable: true
sourceIdGeneration:
  mode: MANUAL
primaryKey: Batiments.entities.TypeBatiment.TypeBatiment.TypeBatimentCode
