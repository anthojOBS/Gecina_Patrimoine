_package: Batiments.entities.SocieteProprietaire.forms
_type: Form
_name: SocieteProprietaireForm
entity: Batiments.entities.SocieteProprietaire.SocieteProprietaire
default: true
formTabs:
  - _type: FormTab
    _name: SocieteProprietaire
    label: Société Propriétaire
    documentationInterpreter: LITERAL
    visibleValue: "1"
    visibleValueInterpreter: LITERAL
    displayFormTabAs: LABEL
    content:
      - _type: IdField
        _name: SocieteProprietaireCode
        value: SocieteProprietaireCode
        useCustomLabel: false
        dataType: STRING
        labelProperties:
          typographyValueInterpreter: LITERAL
          typography: body-2
          color: md:black
      - _type: TextField
        _name: SocieteProprietaireLibelle
        value: SocieteProprietaireLibelle
        useCustomLabel: false
        dataType: STRING
        labelProperties:
          typographyValueInterpreter: LITERAL
          typography: body-2
          color: md:black
