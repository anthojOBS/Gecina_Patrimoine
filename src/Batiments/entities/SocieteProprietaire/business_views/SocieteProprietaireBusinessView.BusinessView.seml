_package: Batiments.entities.SocieteProprietaire.business_views
_type: BusinessView
_name: SocieteProprietaireBusinessView
entity: Batiments.entities.SocieteProprietaire.SocieteProprietaire
rootLabel: Société Propriétaire
rootPluralLabel: Société Propriétaire
displayRootNodeAs: ICON_LABEL
label: Société Propriétaire
rootBusinessViewEntity:
  _type: BusinessViewEntity
  _name: SocieteProprietaire
  displayCard: Batiments.entities.SocieteProprietaire.display_cards.SocieteProprietaireDisplayCard
  entity: Batiments.entities.SocieteProprietaire.SocieteProprietaire
  actionSet: Batiments.entities.SocieteProprietaire.action_sets.SocieteProprietaireActionSet
  collection: Batiments.entities.SocieteProprietaire.collection_views.SocieteProprietaireCollectionView
  form: Batiments.entities.SocieteProprietaire.forms.SocieteProprietaireForm
  outlineVisible: false
  displayRecordCount: ALWAYS
  businessEntitySearchConfigs:
    - _name: TextConfig
      _type: BusinessEntitySearchTypeConfig
      searchType: TEXT
    - _name: FormConfig
      _type: BusinessEntitySearchTypeConfig
      searchType: BY_FORM
    - _name: AdvancedConfig
      _type: BusinessEntitySearchTypeConfig
      searchType: ADVANCED
    - _name: SemqlConfig
      _type: BusinessEntitySearchTypeConfig
      searchType: SEMQL
  overrideDefaultSort: false
  enableUserDefinedSort: true
  listAllowed: true
  tableAllowed: true
  gridAllowed: true

  transitions:
    - _name: GoldenHistoryRecords
      _type: BusinessViewTransition
      displayFormTabAs: ICON_LABEL
      displayTransitionNodeAs: ICON_LABEL
      enableHierarchy: '0'
      enableHierarchyInterpreter: LITERAL
      expandHierarchyByDefault: false
      iconUrl: images://mdi/history.svg
      label: History
      pluralLabel: History
      transitionPath: GoldenHistoryRecords
      transitionType: FULLY_QUALIFIED
      transitionVisible: '1'
      transitionVisibleInterpreter: LITERAL
      useCustomLabel: true
      businessViewEntity: 
        _type: BusinessViewEntityReference
        ref: Batiments.entities.SocieteProprietaire.business_views.SocieteProprietaireBusinessView.SocieteProprietaire
      filter: 1 = 1
enableHierarchyView: false
useHierarchyOnOpen: false
