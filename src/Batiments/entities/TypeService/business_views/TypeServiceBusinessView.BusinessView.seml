_package: Batiments.entities.TypeService.business_views
_type: BusinessView
_name: TypeServiceBusinessView
entity: Batiments.entities.TypeService.TypeService
rootLabel: Type service
rootPluralLabel: Type service
displayRootNodeAs: ICON_LABEL
label: Type service
rootBusinessViewEntity:
  _type: BusinessViewEntity
  _name: TypeService
  displayCard: Batiments.entities.TypeService.display_cards.TypeServiceDisplayCard
  entity: Batiments.entities.TypeService.TypeService
  actionSet: Batiments.entities.TypeService.action_sets.TypeServiceActionSet
  collection: Batiments.entities.TypeService.collection_views.TypeServiceCollectionView
  form: Batiments.entities.TypeService.forms.TypeServiceForm
  outlineVisible: false
  displayRecordCount: ALWAYS
  businessEntitySearchConfigs:
    - _name: TextConfig
      _type: BusinessEntitySearchTypeConfig
      searchType: TEXT
    - _name: FormConfig
      _type: BusinessEntitySearchTypeConfig
      searchType: BY_FORM
    - _name: AdvancedConfig
      _type: BusinessEntitySearchTypeConfig
      searchType: ADVANCED
    - _name: SemqlConfig
      _type: BusinessEntitySearchTypeConfig
      searchType: SEMQL
  overrideDefaultSort: false
  enableUserDefinedSort: true
  listAllowed: true
  tableAllowed: true
  gridAllowed: true

  transitions:
    - _name: GoldenHistoryRecords
      _type: BusinessViewTransition
      displayFormTabAs: ICON_LABEL
      displayTransitionNodeAs: ICON_LABEL
      enableHierarchy: '0'
      enableHierarchyInterpreter: LITERAL
      expandHierarchyByDefault: false
      iconUrl: images://mdi/history.svg
      label: History
      pluralLabel: History
      transitionPath: GoldenHistoryRecords
      transitionType: FULLY_QUALIFIED
      transitionVisible: '1'
      transitionVisibleInterpreter: LITERAL
      useCustomLabel: true
      businessViewEntity: 
        _type: BusinessViewEntityReference
        ref: Batiments.entities.TypeService.business_views.TypeServiceBusinessView.TypeService
      filter: 1 = 1
enableHierarchyView: false
useHierarchyOnOpen: false
