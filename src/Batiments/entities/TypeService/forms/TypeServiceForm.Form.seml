default: true
formTabs:
  - _type: FormTab
    _name: TypeService
    label: Type service
    documentationInterpreter: LITERAL
    visibleValue: "1"
    visibleValueInterpreter: LITERAL
    displayFormTabAs: LABEL
    content:
      - _type: TextField
        _name: TypeService
        value: TypeService
        useCustomLabel: false
