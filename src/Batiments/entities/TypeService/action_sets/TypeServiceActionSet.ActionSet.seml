_package: Batiments.entities.TypeService.action_sets
_type: ActionSet
_name: TypeServiceActionSet
entity: Batiments.entities.TypeService.TypeService
label: Type Service Action Set
defaultActionSet: true
actions:
  - _type: CreateAction
    _name: CreateAuthorTypeService
    label: Create
    useCustomLabel: true
    stepper: Batiments.entities.TypeService.steppers.AuthorTypeService
    createMultiple: false
    createdRecordType: GOLDEN
    waitDialogEnabled: false
    allowOtherPublishers: true
  - _type: EditAction
    _name: EditAuthorTypeService
    label: Edit
    useCustomLabel: true
    stepper: Batiments.entities.TypeService.steppers.AuthorTypeService
    multipleSelectionAllowed: true
    availableForGoldenData: true
    availableForMasterData: false
    availableForErrorData: true
    waitDialogEnabled: false
  - _type: MassUpdateAction
    _name: MassUpdateAuthorTypeService
    label: Mass Update
    useCustomLabel: true
    stepper: Batiments.entities.TypeService.steppers.AuthorTypeService
    availableForGoldenData: true
    availableForErrorData: true
    availableForMasterData: false
    waitDialogEnabled: false
  - _type: DeleteAction
    _name: Delete
    label: Delete
    useCustomLabel: true
    multipleSelectionAllowed: true
    deleteType: HARD_DELETE
    waitDialogEnabled: false
    availableForGoldenData: true
    availableForMasterData: false
    requiredRole: semarchyAdmin
  - _type: ExportAction
    _name: Export
    label: Export
    useCustomLabel: true
    waitDialogEnabled: false
  - _type: ImportAction
    _name: ImportAuthorTypeService
    label: Import
    useCustomLabel: true
    importMode: CREATE_AND_UPDATE
    stepper: Batiments.entities.TypeService.steppers.AuthorTypeService
    importedRecordType: GOLDEN
    waitDialogEnabled: false
    allowOtherPublishers: true
