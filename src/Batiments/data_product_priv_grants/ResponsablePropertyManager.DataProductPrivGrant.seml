_package: Batiments.data_product_priv_grants
_name: ResponsablePropertyManager
_type: DataProductPrivGrant
roleName: ResponsablePropertyManager
label: Responsable Property Manager
entityPrivGrants:
  - _type: EntityPrivGrant
    entity: Batiments.entities.Immeuble.Immeuble
