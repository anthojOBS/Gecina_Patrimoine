_package: Batiments.workflows
_name: ModificationSurfaceLot
_type: Workflow
label: Modification Surface Lot
workflowAdminRole: semarchyAdmin
generalProperties:
  attachmentMaxFileCount: 5
  attachmentMaxFileSize: 10000
  attachmentMimeTypes: "*"
notifications:
  workflowAdminOnDueDate: false
retentionPolicy:
  retentionTimeUnit: DAYS
  retentionType: FOREVER
dataScope:
  - entity: Batiments.entities.Lot.Lot
    _type: RootEntity
    _name: Lot
    cardinality: SINGLE_RECORD
    displayCard: Batiments.entities.Lot.display_cards.LotDisplayCard
steps:
  - _type: StartFromSelectionEvent
    _name: StartEdit
    authoredEntity: Batiments.entities.Lot.Lot
    selectionSourceType: GOLDEN_DATA
    position:
      x: -353.6546348853624
      y: -52.56390553364866
    label: Démarrer Modification Surface
    initiatorRequiredRole: ResponsablePropertyManager
    defaultPriority: NORMAL
    startupParameters:
      attachmentParamRequired: false
      attachmentParamSupported: true
      commentParamRequired: false
      commentParamSupported: true
      descriptionParamSupported: true
      dueDateParamRequired: false
      dueDateParamSupported: true
      nextTaskAssigneeRequired: false
      nextTaskAssigneeSupported: false
      priorityParamSupported: true
      showWaitDialog: true
    transition:
      _type: StartEventTransition
      _name: outgoing
      toStep: Batiments.workflows.ModificationSurfaceLot.ModifyLot
      bendPoints: []
  - _type: UserTask
    _name: ModifyLot
    label: Modifier Surface Lot
    icon: images://mdi/ruler-square.svg
    position:
      x: -270
      y: -80
    application: Batiments.applications.Patrimoine
    assigneeRequiredRole: ResponsablePropertyManager
    assigneeCondition: Username=UserTaskInstance.StepInstance.WorkflowInstance.InitiatorName
    assigneeCanRelease: true
    notificationsOnTaskAssignment:
      toAssignee: true
      toCandidates: true
    notificationsOnTaskExpiration:
      taskMaxDuration: 1
      toAdmin: false
      toCandidatesOrAssignee: false
      toRole: ""
    notificationsOnWorkflowDueDate:
      toCandidatesOrAssignee: false
    taskType: DATA_AUTHORING
    entity: Batiments.entities.Lot.Lot
    stepper: Batiments.entities.Lot.steppers.LotsConsultation
    myTasksConfiguration:
      collection: Batiments.entities.Lot.collection_views.LotCollectionView
    transitions:
      - _type: UserTaskTransition
        _name: SendToReview
        label: Demande Validation
        toStep: Batiments.workflows.ModificationSurfaceLot.ApproveLot
        userTaskCompletionRequired: true
        behaviorOnTransition: KEEP_DATA
        showWaitDialog: true
        transitionParameters:
          nextTaskAssigneeSupported: false
          nextTaskAssigneeRequired: false
          descriptionParamSupported: true
          commentParamSupported: true
          commentParamRequired: false
          priorityParamSupported: true
          dueDateParamSupported: false
          dueDateParamRequired: false
          attachmentParamSupported: true
          attachmentParamRequired: false
        bendPoints: []
      - _type: UserTaskTransition
        _name: Cancel
        label: Annuler
        toStep: Batiments.workflows.ModificationSurfaceLot.End
        bendPoints:
          - x: -180
            y: -195
          - x: 600
            y: -195
        userTaskCompletionRequired: true
        behaviorOnTransition: KEEP_DATA
        showWaitDialog: true
        transitionParameters:
          nextTaskAssigneeSupported: false
          nextTaskAssigneeRequired: false
          descriptionParamSupported: false
          commentParamSupported: true
          commentParamRequired: false
          priorityParamSupported: false
          dueDateParamSupported: false
          dueDateParamRequired: false
          attachmentParamSupported: true
          attachmentParamRequired: false
  - _type: UserTask
    _name: ApproveLot
    label: Approuver Modification Surface
    icon: images://mdi/check-decagram.svg
    position:
      x: 41.06938926773583
      y: -80
    application: Batiments.applications.Patrimoine
    assigneeRequiredRole: AssetManager
    assigneeCanRelease: true
    taskType: DATA_AUTHORING
    entity: Batiments.entities.Lot.Lot
    stepper: Batiments.entities.Lot.steppers.ApprouverModificationSuperficieLots
    myTasksConfiguration:
      collection: Batiments.entities.Lot.collection_views.LotCollectionView
    notificationsOnTaskAssignment:
      toAssignee: true
      toCandidates: true
    notificationsOnTaskExpiration:
      taskMaxDuration: 1
      toAdmin: false
      toCandidatesOrAssignee: false
      toRole: ""
    notificationsOnWorkflowDueDate:
      toCandidatesOrAssignee: false
    transitions:
      - _type: UserTaskTransition
        _name: Save
        label: Publier
        toStep: Batiments.workflows.ModificationSurfaceLot.SubmitData
        userTaskCompletionRequired: true
        behaviorOnTransition: KEEP_DATA
        showWaitDialog: true
        transitionParameters:
          nextTaskAssigneeSupported: false
          nextTaskAssigneeRequired: false
          descriptionParamSupported: true
          commentParamSupported: true
          commentParamRequired: false
          priorityParamSupported: true
          dueDateParamSupported: false
          dueDateParamRequired: false
          attachmentParamSupported: true
          attachmentParamRequired: false
        bendPoints: []
      - _type: UserTaskTransition
        _name: SendBackForCorrection
        label: Demande de correction
        toStep: Batiments.workflows.ModificationSurfaceLot.ModifyLot
        bendPoints:
          - x: 90
            y: 75
          - x: 0
            y: 75
          - x: -195
            y: 75
        userTaskCompletionRequired: true
        behaviorOnTransition: KEEP_DATA
        showWaitDialog: true
        transitionParameters:
          nextTaskAssigneeSupported: false
          nextTaskAssigneeRequired: false
          descriptionParamSupported: false
          commentParamSupported: true
          commentParamRequired: true
          priorityParamSupported: false
          dueDateParamSupported: false
          dueDateParamRequired: false
          attachmentParamSupported: true
          attachmentParamRequired: false
      - _type: UserTaskTransition
        _name: DiscardLot
        label: Annuler
        toStep: Batiments.workflows.ModificationSurfaceLot.End
        bendPoints:
          - x: 135
            y: 75
          - x: 285
            y: 75
          - x: 465
            y: 75
          - x: 600
            y: 75
        userTaskCompletionRequired: true
        behaviorOnTransition: KEEP_DATA
        showWaitDialog: true
        transitionParameters:
          nextTaskAssigneeSupported: false
          nextTaskAssigneeRequired: false
          descriptionParamSupported: false
          commentParamSupported: true
          commentParamRequired: false
          priorityParamSupported: false
          dueDateParamSupported: false
          dueDateParamRequired: false
          attachmentParamSupported: true
          attachmentParamRequired: false
  - _type: SubmitAutomation
    _name: SubmitData
    label: Publier
    position:
      x: 355.4653498812764
      y: -72.72284114272595
    submitUserExpression: WorkflowInstance.InitiatorName
    transition:
      _type: AutomationTransition
      _name: outgoing
      label: Terminer
      toStep: Batiments.workflows.ModificationSurfaceLot.End
      bendPoints: []
  - _type: EndEvent
    _name: End
    position:
      x: 587.198016251607
      y: -62.58430514863185
