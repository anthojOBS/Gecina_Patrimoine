_package: Batiments.references
_type: Reference
_name: ImmeubleToZoneImmostat
label: Immeuble ZoneImmostat
description: Référence Immeuble vers ZoneImmostat
fromRoleDocumentation: |
  Cette référence détermine la **ZoneImmostat** d'un **Immeuble** dans son cycle de vie.
  La ZoneImmostat indique l'état d'avancement du projet immobilier (en construction, livré, etc.).
physicalName: IMM_ZONE_IMMOSTAT_REF

fromEntity: Batiments.entities.Immeuble.Immeuble
fromRoleLabel: Immeuble
fromRoleName: Immeuble
fromRolePluralLabel: Immeubles

toEntity: Batiments.entities.ZoneImmostat.ZoneImmostat
toRoleLabel: ZoneImmostat
toRoleName: ZoneImmostat
toRolePhysicalName: ZONE_IMMOSTAT_ID

oneToMany: true
deletePropagation: RESTRICT
validationScope: POST_CONSO
mandatoryValidationLabel: La ZoneImmostat est obligatoire pour un immeuble
brokenValidationLabel: La ZoneImmostat sélectionnée est invalide pour cet immeuble

foreignAttribute:
  _type: ForeignAttribute
  _name: Zone_Immostat
  label: ZoneImmostat
  physicalName: ZONE_IMMOSTAT_ID
  searchable: true
  entity: Batiments.entities.Immeuble.Immeuble
