toRolePhysicalName: LOT_ID

oneToMany: false
deletePropagation: RESTRICT
validationScope: NONE  #pour alimenter sans etage
mandatoryValidationLabel: Le lot est obligatoire pour un sous-lot
brokenValidationLabel: Le lot sélectionné est invalide pour ce sous-lot

