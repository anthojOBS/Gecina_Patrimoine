fromRolePluralLabel: Etages

toEntity: Batiments.entities.Batiment.Batiment
toRoleLabel: Batiment
toRoleName: Batiment
toRolePhysicalName: BATIMENT_ID

oneToMany: false
deletePropagation: RESTRICT
validationScope: PRE_CONSO
mandatoryValidationLabel: Le batiment est obligatoire pour un etage
brokenValidationLabel: Le batiment sélectionné est invalide pour cet etage

foreignAttribute:
  _type: ForeignAttribute
  _name: Batiment
  label: Batiment
  physicalName: BATIMENT_ID
  searchable: true
  entity: Batiments.entities.Etage.Etage
