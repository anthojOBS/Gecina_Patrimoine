fromRolePluralLabel: Immeubles

toEntity: Batiments.entities.PerimetreGestion.PerimetreGestion
toRoleLabel: PerimetreGestion
toRoleName: PerimetreGestion
toRolePhysicalName: PERIMETRE_GESTION_ID

oneToMany: true
deletePropagation: RESTRICT
validationScope: NONE #seulement DR en modification pas alim en creation
mandatoryValidationLabel: La Périmètre gestion est obligatoire pour un immeuble
brokenValidationLabel: La Périmètre gestion sélectionnée est invalide pour cet immeuble

foreignAttribute:
  _type: ForeignAttribute
  _name: PerimetreGestion
  label: Périmètre gestion
  physicalName: PERIMETRE_GESTION_ID
