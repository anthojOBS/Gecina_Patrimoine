_package: Batiments.references
_type: Reference
_name: CompteurToLot
label: Compteur Lot
description: Lien hiérarchique Lot vers Compteur
fromRoleDocumentation: |
  Cette référence établit le lien hiérarchique entre un **Compteur** et son **lot**.
  
  Chaque lot doit être rattaché à un étage dans la structure du patrimoine immobilier.
physicalName: COMPTEUR_LOT_REF

fromEntity: Batiments.entities.Compteur.Compteur
fromRoleLabel: Compteur
fromRoleName: Compteur
fromRolePluralLabel: Compteur

toEntity: Batiments.entities.Lot.Lot
toRoleLabel: Lot
toRoleName: Lot
toRolePhysicalName: LOT_ID

oneToMany: false
deletePropagation: RESTRICT
validationScope: NONE  #pour alimenter sans etage
mandatoryValidationLabel: Le lot est obligatoire pour un compteur
brokenValidationLabel: Le lot sélectionné est invalide pour ce compteur

foreignAttribute:
  _type: ForeignAttribute
  _name: Lot
  label: Lot
  physicalName: LOT_ID
  searchable: true
  entity: Batiments.entities.Compteur.Compteur
