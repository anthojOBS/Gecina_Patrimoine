toRolePhysicalName: PHASE_ID

oneToMany: true
deletePropagation: RESTRICT
validationScope: NONE
mandatoryValidationLabel: L'état est obligatoire pour un lot
brokenValidationLabel: L'état sélectionné est invalide pour ce lot

