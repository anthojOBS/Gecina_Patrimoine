_package: Batiments.references
_type: Reference
_name: ServiceToLot
label: Service Lot
description: Lien hiérarchique Lot vers Service
fromRoleDocumentation: |
  Cette référence établit le lien hiérarchique entre un **Service** et son **lot**.
  
  Chaque lot doit être rattaché à un étage dans la structure du patrimoine immobilier.
physicalName: SERVICE_LOT_REF

fromEntity: Batiments.entities.Service.Service
fromRoleLabel: Service
fromRoleName: Service
fromRolePluralLabel: Service

toEntity: Batiments.entities.Lot.Lot
toRoleLabel: Lot
toRoleName: Lot
toRolePhysicalName: LOT_ID

oneToMany: false
deletePropagation: RESTRICT
validationScope: NONE  #pour alimenter sans etage
mandatoryValidationLabel: Le lot est obligatoire pour un compteur
brokenValidationLabel: Le lot sélectionné est invalide pour ce compteur

foreignAttribute:
  _type: ForeignAttribute
  _name: Lot
  label: Lot
  physicalName: LOT_ID
  searchable: true
  entity: Batiments.entities.Service.Service
