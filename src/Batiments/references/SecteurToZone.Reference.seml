toRoleName: ZoneImmostat
toRolePhysicalName: ZONE_IMMOSTAT_ID

oneToMany: false
deletePropagation: RESTRICT
validationScope: NONE  #pour alimenter sans etage
mandatoryValidationLabel: Le Secteur est obligatoire pour un Zone
brokenValidationLabel: Le Secteur sélectionné est invalide pour ce Zone

