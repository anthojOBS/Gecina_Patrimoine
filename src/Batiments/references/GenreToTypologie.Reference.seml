_package: Batiments.references
_type: Reference
_name: GenreToTypologie
label: Genre Typologie
description: Lien hiérarchique Typologie vers Genre
fromRoleDocumentation: |
  Cette référence établit le lien hiérarchique entre un **genre** et sa **Typologie**.
  
  Chaque typologie doit être rattachée à un genre dans la structure du patrimoine immobilier.
physicalName: GENRE_TO_TYPOLOGIE

fromEntity: Batiments.entities.GenreLot.GenreLot
fromRoleLabel: Genre de Lot
fromRoleName: GenreLot
fromRolePluralLabel: Genre de Lot

toEntity: Batiments.entities.TypologieLot.TypologieLot
toRoleLabel: Typologie de Lot
toRoleName: TypologieLot
toRolePhysicalName: TYPOLOGIE_ID

oneToMany: false
deletePropagation: RESTRICT
validationScope: NONE  #pour alimenter sans etage
mandatoryValidationLabel: La typologie est obligatoire pour un genre
brokenValidationLabel: La typologie sélectionnée est invalide pour ce genre

foreignAttribute:
  _type: ForeignAttribute
  _name: TypologieLot
  label: Typologie de Lot
  physicalName: TYPOLOGIE_ID
  searchable: true
  entity: Batiments.entities.TypologieLot.TypologieLot
