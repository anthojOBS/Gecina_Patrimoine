_package: Batiments.references
_type: Reference
_name: ImmeubleToZoneGeographique
label: Immeuble Zone Géographique
description: Référence Immeuble vers Zone Géographique
fromRoleDocumentation: |
  Cette référence associe un **Immeuble** à une **Zone Géographique**.
  
  La zone géographique permet de localiser et regrouper les immeubles par secteur territorial.
physicalName: IMMEUBLE_ZONE_GEO_REF

fromEntity: Batiments.entities.Immeuble.Immeuble
fromRoleLabel: Immeuble
fromRoleName: Immeuble
fromRolePluralLabel: Immeubles

toEntity: Batiments.entities.ZoneGeographique.ZoneGeographique
toRoleLabel: Zone Géographique
toRoleName: ZoneGeographique
toRolePhysicalName: ZONE_GEOGRAPHIQUE_ID

oneToMany: true
deletePropagation: RESTRICT
validationScope: PRE_CONSO
mandatoryValidationLabel: La zone géographique est obligatoire pour un immeuble
brokenValidationLabel: La zone géographique sélectionnée est invalide pour cet immeuble

foreignAttribute:
  _type: ForeignAttribute
  _name: ZoneGeographique
  label: Zone Géographique
  physicalName: ZONE_GEOGRAPHIQUE_ID
  searchable: true
  entity: Batiments.entities.Immeuble.Immeuble
