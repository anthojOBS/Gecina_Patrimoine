toEntity: Batiments.entities.CategorieERP.CategorieERP
toRoleLabel: Categorie ERP
toRoleName: CategorieERP
toRolePhysicalName: CATEGORIEERP_ID

oneToMany: true
deletePropagation: RESTRICT
validationScope: POST_CONSO
mandatoryValidationLabel: La Categorie ERP est obligatoire pour un immeuble
brokenValidationLabel: La Categorie ERP sélectionnée est invalide pour cet immeuble

foreignAttribute:
