toEntity: Batiments.entities.SecteurImmostat.SecteurImmostat
toRoleLabel: SecteurImmostat
toRoleName: SecteurImmostat
toRolePhysicalName: SECTEUR_ID

oneToMany: false
deletePropagation: RESTRICT
validationScope: NONE  #pour alimenter sans etage
mandatoryValidationLabel: Le Secteur est obligatoire pour un sous-Secteur
brokenValidationLabel: Le Secteur sélectionné est invalide pour ce sous-Secteur

foreignAttribute:
