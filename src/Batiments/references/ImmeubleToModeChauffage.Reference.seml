toEntity: Batiments.entities.ModeChauffage.ModeChauffage
toRoleLabel: Mode Chauffage
toRoleName: ModeChauffage
toRolePhysicalName: MODECHAUFFAGE_ID

oneToMany: true
deletePropagation: RESTRICT
validationScope: POST_CONSO
mandatoryValidationLabel: Le mode de chauffage est obligatoire pour un immeuble
brokenValidationLabel: Le mode de chauffage sélectionnée est invalide pour cet immeuble

foreignAttribute:
  _type: ForeignAttribute
  _name: ModeChauffage
  label: ModeChauffage
  physicalName: MODECHAUFFAGE_ID
